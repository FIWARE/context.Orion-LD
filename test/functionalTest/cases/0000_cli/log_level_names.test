--NAME--
Every log level that -logLevel documents is accepted - none of them says 'invalid log level'

--SHELL-INIT--

--SHELL--

#
# -logLevel documents NONE, FATAL, ERROR, WARN, INFO and DEBUG (issue #1951: ERROR said "orionld: invalid log level 'ERROR'").
# An unknown core context version makes the broker exit right after the logging is set up, before it opens any port or database.
#
# 01. Each of the six levels: the number of 'invalid log level' lines the broker prints - zero
#

echo "01. Each of the six levels: the number of 'invalid log level' lines the broker prints - zero"
echo "==========================================================================================="
for level in NONE FATAL ERROR WARN INFO DEBUG
do
  echo "$level: $($BROKER -fg -logLevel $level -coreContext v0.0 2>&1 | grep -c 'invalid log level')"
done
echo
echo


--REGEXPECT--
01. Each of the six levels: the number of 'invalid log level' lines the broker prints - zero
===========================================================================================
NONE: 0
FATAL: 0
ERROR: 0
WARN: 0
INFO: 0
DEBUG: 0


--TEARDOWN--
