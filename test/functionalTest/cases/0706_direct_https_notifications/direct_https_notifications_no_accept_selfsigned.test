# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Direct HTTP notification (not accepting self signed certs)

--SHELL-INIT--
${SCRIPT_HOME}/httpsPrepare.sh --keyFileName /tmp/harnessTest.key --certFileName /tmp/harnessTest.pem

dbInit CB
brokerStart CB
ftClientStart --pretty-print --https --httpsKey /tmp/harnessTest.key --httpsCertificate /tmp/harnessTest.pem

--SHELL--

#
# 01. Create subscription to an HTTPS endpoint
# 02. Create entity, triggering notification
# 03. Dump accumulator and see no notification
# 04. Look in the CB log for the warning about cert not accepted
#


echo "01. Create subscription to an HTTPS endpoint"
echo "============================================"
payload='{
  "subject": {
    "entities": [
      {
        "idPattern": "E.*"
      }
    ],
    "condition": {
      "attrs": [ ]
    }
  },
  "notification": {
    "http": {"url": "https://localhost:'$FT_PORT'/notify"}
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity, triggering notification"
echo "=========================================="
payload='{
  "id": "E1",
  "A1": {
    "value": 1
  }
}'
orionCurl --url /v2/entities --payload "$payload"
echo
echo


echo "03. Dump accumulator and see no notification"
echo "============================================"
ftClientDump IPV4 HTTPS
echo
echo

# The notification should have been attempted (curl_easy_perform), failed at TLS
# handshake (self-signed not in the trust store), and the broker should have
# recorded that as a subscription failure (status=failed, lastFailure set,
# lastSuccess absent).

echo "04. GET the subscription - verify the broker recorded a failed delivery"
echo "======================================================================="
sleep 1
orionCurl --url /v2/subscriptions
echo
echo


--REGEXPECT--
01. Create subscription to an HTTPS endpoint
============================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/subscriptions/REGEX([0-9a-f]{24})



02. Create entity, triggering notification
==========================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E1?type=Thing



03. Dump accumulator and see no notification
============================================


04. GET the subscription - verify the broker recorded a failed delivery
=======================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})

[
    {
        "id": "REGEX([0-9a-f]{24})",
        "notification": {
            "attrs": [],
            "attrsFormat": "normalized",
            "http": {
                "url": "https://localhost:REGEX(\d+)/notify"
            },
            "lastFailure": "REGEX(.*)",
            "lastNotification": "REGEX(.*)",
            "timesSent": 1
        },
        "status": "failed",
        "subject": {
            "condition": {
                "attrs": []
            },
            "entities": [
                {
                    "idPattern": "E.*"
                }
            ]
        }
    }
]


--TEARDOWN--
brokerStop CB
dbDrop CB
ftClientStop
rm -f /tmp/harnessTest.key /tmp/harnessTest.pem
