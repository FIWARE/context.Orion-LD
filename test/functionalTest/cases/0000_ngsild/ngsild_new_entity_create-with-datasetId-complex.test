# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Entity creation - attributes with datasetId - more complete

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--

#
# 01. Create an entity with 4 attributes (name, name2, name3, and name4) with a mix of datasetIds
# 02. See the entity in the 'entities' collection - see two 'normal' attributes (name, name3) and three attributes with datasetId - name, name2, name4 - name with TWO instances
# 03. GET the entity, without datasetId
# 04. Query all entities, without datasetId
# 05. GET the entity, with datasetId urn:ngsi-ld/dataset:1 - see name, name2, and name4
# 06. Query all entities, with datasetId urn:ngsi-ld/dataset:1 - see name, name2, and name4
# 07. GET the entity, with datasetId urn:ngsi-ld/dataset:2 - see name
# 08. Query all entities, with datasetId urn:ngsi-ld/dataset:2 - see name
# 09. GET the entity, with datasetId urn:ngsi-ld/dataset:3 - see no attributes
# 10. Query all entities, with datasetId urn:ngsi-ld/dataset:3 - see no attributes
#

echo "01. Create an entity with 4 attributes (name, name2, name3, and name4) with a mix of datasetIds"
echo "==============================================================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "name": [
    {
      "type": "Property",
      "value": "no dataset id"
    },
    {
      "type": "Property",
      "value": "dataset urn:ngsi-ld/dataset:1",
      "datasetId": "urn:ngsi-ld/dataset:1"
    },
    {
      "type": "Property",
      "value": "dataset urn:ngsi-ld/dataset:2",
      "datasetId": "urn:ngsi-ld/dataset:2"
    }
  ],
  "name2": [
    {
      "type": "Property",
      "value": "dataset urn:ngsi-ld/dataset:1",
      "datasetId": "urn:ngsi-ld/dataset:1"
    }
  ],
  "name3": {
    "type": "Property",
    "value": "no dataset id"
  },
  "name4": {
    "type": "Property",
    "value": "dataset urn:ngsi-ld/dataset:1",
    "datasetId": "urn:ngsi-ld/dataset:1"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. See the entity in the 'entities' collection - see two 'normal' attributes (name, name3) and three attributes with datasetId - name, name2, name4 - name with TWO instances"
echo "=============================================================================================================================================================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "03. GET the entity, without datasetId"
echo "====================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1
echo
echo


echo "04. Query all entities, without datasetId"
echo "========================================="
orionCurl --url /ngsi-ld/v1/entities?local=true
echo
echo


echo "05. GET the entity, with datasetId urn:ngsi-ld/dataset:1 - see name, name2, and name4"
echo "====================================================================================="
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1?datasetId=urn:ngsi-ld/dataset:1'
echo
echo


echo "06. Query all entities, with datasetId urn:ngsi-ld/dataset:1 - see name, name2, and name4"
echo "========================================================================================="
orionCurl --url '/ngsi-ld/v1/entities?local=true&datasetId=urn:ngsi-ld/dataset:1'
echo
echo


echo "07. GET the entity, with datasetId urn:ngsi-ld/dataset:2 - see name"
echo "==================================================================="
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1?datasetId=urn:ngsi-ld/dataset:2'
echo
echo


echo "08. Query all entities, with datasetId urn:ngsi-ld/dataset:2 - see name"
echo "======================================================================="
orionCurl --url '/ngsi-ld/v1/entities?local=true&datasetId=urn:ngsi-ld/dataset:2'
echo
echo


echo "09. GET the entity, with datasetId urn:ngsi-ld/dataset:3 - see no attributes"
echo "============================================================================"
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1?datasetId=urn:ngsi-ld/dataset:3'
echo
echo


echo "10. Query all entities, with datasetId urn:ngsi-ld/dataset:3 - see no attributes"
echo "================================================================================"
orionCurl --url '/ngsi-ld/v1/entities?local=true&datasetId=urn:ngsi-ld/dataset:3'
echo
echo


--REGEXPECT--
01. Create an entity with 4 attributes (name, name2, name3, and name4) with a mix of datasetIds
===============================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. See the entity in the 'entities' collection - see two 'normal' attributes (name, name3) and three attributes with datasetId - name, name2, name4 - name with TWO instances
==============================================================================================================================================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
{
	"_id" : {
		"id" : "urn:ngsi-ld:entities:E1",
		"type" : "https://uri.etsi.org/ngsi-ld/default-context/T",
		"servicePath" : "/"
	},
	"attrNames" : [
		"https://uri.etsi.org/ngsi-ld/default-context/name",
		"https://uri.etsi.org/ngsi-ld/default-context/name3"
	],
	"attrs" : {
		"https://uri=etsi=org/ngsi-ld/default-context/name" : {
			"type" : "Property",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : "no dataset id",
			"mdNames" : [ ]
		},
		"https://uri=etsi=org/ngsi-ld/default-context/name3" : {
			"type" : "Property",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : "no dataset id",
			"mdNames" : [ ]
		}
	},
	"creDate" : REGEX(.*),
	"modDate" : REGEX(.*),
	"lastCorrelator" : "",
	"@datasets" : {
		"https://uri=etsi=org/ngsi-ld/default-context/name" : [
			{
				"type" : "Property",
				"value" : "dataset urn:ngsi-ld/dataset:1",
				"datasetId" : "urn:ngsi-ld/dataset:1",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			},
			{
				"type" : "Property",
				"value" : "dataset urn:ngsi-ld/dataset:2",
				"datasetId" : "urn:ngsi-ld/dataset:2",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			}
		],
		"https://uri=etsi=org/ngsi-ld/default-context/name2" : [
			{
				"type" : "Property",
				"value" : "dataset urn:ngsi-ld/dataset:1",
				"datasetId" : "urn:ngsi-ld/dataset:1",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			}
		],
		"https://uri=etsi=org/ngsi-ld/default-context/name4" : [
			{
				"type" : "Property",
				"value" : "dataset urn:ngsi-ld/dataset:1",
				"datasetId" : "urn:ngsi-ld/dataset:1",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			}
		]
	}
}
bye


