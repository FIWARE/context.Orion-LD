# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Attribute Delete with datasetId

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly -t 0-255

--SHELL--

#
# 01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default
# 02. Replace A1:D1 (with the datasetId in the payload body)
# 03. See E1 in mongo - make sure A1:D1 has been modified
# 04. GET E1 via REST - make sure A1:D1 has been modified
#

echo "01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default"
echo "======================================================================================================"
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "A1": [
    {
      "type": "Property",
      "value": "A1:Default"
    },
    {
      "type": "Property",
      "value": "A1:D1",
      "datasetId": "urn:ngsi-ld:dataset:D1"
    },
    {
      "type": "Property",
      "value": "A1:D2",
      "datasetId": "urn:ngsi-ld:dataset:D2"
    },
    {
      "type": "Property",
      "value": "A1:D3",
      "datasetId": "urn:ngsi-ld:dataset:D3"
    }
  ]
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "01b. See the entity in mongo"
echo "============================"
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "02. Replace A1:D1 (with the datasetId in the payload body)"
echo "=========================================================="
payload='{
  "type": "Property",
  "value": "A1:D1-2",
  "datasetId": "urn:ngsi-ld:dataset:D1"
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs/A1 -X PUT --payload "$payload"
echo
echo


echo "03. See E1 in mongo - make sure A1:D1 has been modified"
echo "======================================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "04. GET E1 via REST - make sure A1:D1 has been modified"
echo "======================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1
echo
echo


