# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Entity Attributes - simple test without collisions

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly -noArrayReduction

--SHELL--

#
# 01. Create an Entity urn:E1 with an attribute A1 that is an array of 2 strings
# 02. PATCH urn:E1 with A1 as an array of 1 string, with array-concat turned on
# 03. GET urn:E1 and see A1 as an array of 3 strings
#

echo "01. Create an Entity urn:E1 with an attribute A1 that is an array of 2 strings"
echo "=============================================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "A1": {
    "type": "Property",
    "value": [ "1", "2" ]
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. PATCH urn:E1 with A1 as an array of 1 string, with array-concat turned on"
echo "============================================================================="
payload='{
  "A1": {
    "type": "Property",
    "value": [ "3" ]
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1 --payload "$payload" -X PATCH -H "aerOS-Array-Concat: true"
echo
echo


echo "03. GET urn:E1 and see A1 as an array of 3 strings"
echo "=================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1
echo
echo


--REGEXPECT--
01. Create an Entity urn:E1 with an attribute A1 that is an array of 2 strings
==============================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



02. PATCH urn:E1 with A1 as an array of 1 string, with array-concat turned on
=============================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. GET urn:E1 and see A1 as an array of 3 strings
==================================================
HTTP/1.1 200 OK
Content-Length: 73
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "A1": {
        "type": "Property",
        "value": [
            "1",
            "2",
            "3"
        ]
    },
    "id": "urn:E1",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
dbDrop CB
