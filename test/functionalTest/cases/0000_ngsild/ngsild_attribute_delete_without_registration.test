# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Attribute Delete without registration nor datasetId

--SHELL-INIT--
dbInit CB
dbInit CP1
orionldStart CB -mongocOnly -forwarding

--SHELL--

#
# 01. Create an entity E1 with an attribute A1 in CB
# 02. Ask CB to delete the attribute A1
# 03. GET the entity - see that the attribute A1 is gone
# 04. Ask CB to delete the attribute AGAIN - 404
#

echo "01. Create an entity E1 with an attribute A1 in CB"
echo "=================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "A1": 1
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Ask CB to delete the attribute A1"
echo "====================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/A1 -X DELETE
echo
echo


echo "03. GET the entity - see that the attribute A1 is gone"
echo "======================================================"
orionCurl --url /ngsi-ld/v1/entities?local=true
echo
echo


echo "04. Ask CB to delete the attribute AGAIN - 404"
echo "=============================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/A1 -X DELETE
echo
echo


--REGEXPECT--
01. Create an entity E1 with an attribute A1 in CB
==================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



02. Ask CB to delete the attribute A1
=====================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. GET the entity - see that the attribute A1 is gone
======================================================
HTTP/1.1 200 OK
Content-Length: 28
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "id": "urn:E1",
        "type": "T"
    }
]


04. Ask CB to delete the attribute AGAIN - 404
==============================================
HTTP/1.1 404 Not Found
Content-Length: 152
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "https://uri.etsi.org/ngsi-ld/default-context/A1",
    "title": "Attribute Not Found",
    "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}


--TEARDOWN--
brokerStop CB
brokerStop CP1
dbDrop CB
dbDrop CP1
