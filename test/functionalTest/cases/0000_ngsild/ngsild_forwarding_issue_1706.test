            "providedBy": {
                "createdAt": "202REGEX(.*)Z",
                "modifiedAt": "202REGEX(.*)Z",
                "object": "urn:ngsi-ld:Device:cow001",
                "type": "Relationship"
            },
            "type": "Property",
            "unitCode": "5K",
            "value": 10.4
        },
        "id": "urn:E1",
        "location": {
            "createdAt": "202REGEX(.*)Z",
            "modifiedAt": "202REGEX(.*)Z",
            "observedAt": "2024-02-02T15:00:00.000Z",
            "providedBy": {
                "createdAt": "202REGEX(.*)Z",
                "modifiedAt": "202REGEX(.*)Z",
                "object": "urn:ngsi-ld:Device:cow001",
                "type": "Relationship"
