# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Issue 1470 - crash on too large value of a property

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--

#
# 01. Create an Entity with a very large compound as value of an attribute - see no crash!
# 02. GET the entity to make sure the broker is still alive and that the entity was created correctly
# 03. Query all entities
#


echo "00. Check for github actions debugging"
echo "======================================"
ls -l $REPO_HOME/etc/input/megaAttributeForIssue1470.json
echo
echo


echo "01. Create an Entity with a very large compound as value of an attribute - see no crash!"
echo "========================================================================================"
orionCurl --url /ngsi-ld/v1/entities --payload "$REPO_HOME/etc/input/megaAttributeForIssue1470.json" --in jsonld
echo
echo


echo "02. GET the entity to make sure the broker is still alive and that the entity was created correctly"
echo "==================================================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:WaterSubscriptionControlTradingHouse:53704bda-dced-4f1c-9d2f-4c766637198b
echo
echo


echo "03. Query all entities"
echo "======================"
orionCurl --url /ngsi-ld/v1/entities?local=true
echo
echo


--REGEXPECT--
