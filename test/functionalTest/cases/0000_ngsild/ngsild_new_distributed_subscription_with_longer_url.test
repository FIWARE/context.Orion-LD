# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Distributed Subscriptions - non-empty URL path for notifications

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental -wip distSubs
ftClientStart -t 0-5000
accumulatorStart --pretty-print 127.0.0.1 ${LISTENER_PORT}

--SHELL--

#
# 01. Create a registration R1 on CB, on entity type T, with endpoint ftClient, including a URL path
# 02. Create a subscription S1 on CB, on entity type T - forwarded to ftClient
# 03. Dump the ftClient, see the correct URL path
#

echo "01. Create a registration R1 on CB, on entity type T, with endpoint ftClient, including a URL path"
echo "=================================================================================================="
payload='{
  "id": "urn:R1",
  "type": "ContextSourceRegistration",
  "information": [
    {
      "entities": [
        {
          "type": "T"
        }
      ]
    }
  ],
  "endpoint": "localhost:'$FT_PORT'/orionld",
  "operations": [ "createEntity", "retrieveEntity", "mergeEntity", "createSubscription" ]
}'
orionCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "02. Create a subscription S1 on CB, on entity type T - forwarded to ftClient"
echo "============================================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "T"
    }
  ],
  "notification": {
    "endpoint": {
      "uri": "http://localhost:'$LISTENER_PORT'/notify"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "03. Dump the ftClient, see the correct URL path"
echo "==============================================="
sleep .5
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create a registration R1 on CB, on entity type T, with endpoint ftClient, including a URL path
==================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:R1



02. Create a subscription S1 on CB, on entity type T - forwarded to ftClient
============================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



03. Dump the ftClient, see the correct URL path
===============================================
HTTP/1.1 200 OK
Content-Length: 426
Date: REGEX(.*)

POST /orionld/ngsi-ld/v1/subscriptions
Host: REGEX(.*)
Accept: */*
Content-Length: REGEX(.*)
Content-Type: application/json

{
  "id": "urn:ngsi-ld:Subscription:S1:1",
  "type": "Subscription",
  "entities": [
    {
      "type": "https://uri.etsi.org/ngsi-ld/default-context/T"
    }
  ],
  "notification": {
    "endpoint": {
      "uri": "http://REGEX(.*)/ngsi-ld/ex/v1/notifications/urn:ngsi-ld:Subscription:S1"
    }
  }
}



--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
