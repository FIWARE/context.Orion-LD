# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Tenant test for when the number of tenants is bigger than the DB pool size

--SHELL-INIT--
dbInit CB
dbResetAll
orionldStart CB -multiservice -dbPoolSize 2

--SHELL--

#
# 01. Create an entity urn:ngsi-ld:entity:E1-50 on 50 tenants t1-t50
# 02. Get urn:ngsi-ld:entity:E1 on tenant t50
# 03. Restart the broker
# 04. Get urn:ngsi-ld:entity:E1 on tenant t1
#

echo "01. Create an entity urn:ngsi-ld:entity:E1-50 on 50 tenants t1-t50"
echo "=================================================================="
typeset -i tNo
tNo=1
while [ $tNo -le 50 ]
do
  tenant=t$tNo

  payload='{
    "id": "urn:ngsi-ld:entity:E'$tNo'",
    "type": "T1"
  }'
  orionCurl --url /ngsi-ld/v1/entities --payload "$payload" --tenant $tenant
  tNo=$tNo+1
done | grep -i tenant
echo
echo


echo "02. Get urn:ngsi-ld:entity:E50 on tenant t50"
echo "============================================"
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entity:E50 --tenant t50
echo
echo


echo "03. Restart broker - have it create the tenants on startup"
echo "=========================================================="
brokerStop CB
orionldStart CB -multiservice -dbPoolSize 2
echo
echo


echo "04. Get urn:ngsi-ld:entity:E50 on tenant t50"
echo "============================================"
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entity:E50 --tenant t50
echo
echo


