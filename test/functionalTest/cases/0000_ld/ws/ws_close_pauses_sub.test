# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Closing WebSocket connection pauses the subscription

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
ftClientStart -v -t 200

--SHELL--

#
# 01. Connect via WebSocket and subscribe for entity type T
# 02. Create an entity of type T to trigger a notification
# 03. Dump WS notifications - see the notification (timesSent=1)
# 04. Close the WS connection
# 05. GET subscription from broker REST API - verify status is paused
#

echo "01. Connect via WebSocket and subscribe for entity type T"
echo "========================================================="
payload='{
  "metadata": {
    "Content-Type": "application/json"
  },
  "body": {
    "type": "Subscription",
    "entities": [
      {
        "type": "T"
      }
    ],
    "notification": {
      "format": "normalized"
    }
  }
}'
wsConnect --port $FT_PORT --payload "$payload"
echo "WS Subscription Id: $wsSubId"
echo
echo


echo "02. Create an entity of type T to trigger a notification"
echo "========================================================"
payload='{
  "id": "urn:ngsi-ld:E01",
  "type": "T",
  "P1": 1
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Dump WS notifications - see the notification (timesSent=1)"
echo "=============================================================="
sleep 0.5
wsDump --subId $wsSubId --port $FT_PORT
echo
echo


echo "04. Close the WS connection"
echo "==========================="
wsClose --subId $wsSubId --port $FT_PORT
sleep 0.5
echo
echo


echo "05. GET subscription from broker REST API - verify status is paused"
echo "===================================================================="
orionCurl --url /ngsi-ld/v1/subscriptions/$wsSubId
echo
echo


--REGEXPECT--
01. Connect via WebSocket and subscribe for entity type T
=========================================================
WS Subscription Id: REGEX(urn:.*)


02. Create an entity of type T to trigger a notification
========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E01



03. Dump WS notifications - see the notification (timesSent=1)
==============================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

[
  {
    "metadata": {
      "Content-Type": "application/json",
      "User-Agent": "REGEX(.*)",
      "Host": "ws-placeholder:0",
      "Accept": "application/json",
      "Ngsild-Attribute-Format": "Normalized",
      "Link": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)"
    },
    "body": {
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "type": "Notification",
      "subscriptionId": "REGEX(urn:ngsi-ld:subscription:.*)",
      "notifiedAt": "REGEX(.*)",
      "data": [
        {
          "id": "urn:ngsi-ld:E01",
          "type": "T",
          "P1": {
            "type": "Property",
            "value": 1
          }
        }
      ]
    }
  }
]



04. Close the WS connection
===========================


05. GET subscription from broker REST API - verify status is paused
====================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "entities": [
        {
            "type": "T"
        }
    ],
    "id": "REGEX(urn:ngsi-ld:subscription:.*)",
    "isActive": false,
    "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)",
    "notification": {
        "consecutiveErrors": REGEX(\d+),
        "endpoint": {
            "accept": "application/json",
            "uri": "http://ws-placeholder:0"
        },
        "format": "normalized",
        "lastErrorReason": "REGEX(.*)",
        "lastFailure": "REGEX(.*)",
        "lastNotification": "REGEX(.*)",
        "lastSuccess": "REGEX(.*)",
        "status": "REGEX(.*)",
        "timesFailed": REGEX(\d+),
        "timesSent": REGEX(\d+)
    },
    "origin": "cache",
    "status": "paused",
    "type": "Subscription"
}


--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
