# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
WebSocket notification on entity creation

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly -wip ws
ftClientStart -v -t 200

--SHELL--

#
# 01. Connect via WebSocket and subscribe for entity type T
# 02. Create an entity of type T via REST API
# 03. Ask ftClient for WS notification dump - see the notification
#

echo "01. Connect via WebSocket and subscribe for entity type T"
echo "========================================================="
payload='{
  "metadata": {
    "Content-Type": "application/json"
  },
  "body": {
    "type": "Subscription",
    "entities": [
      {
        "type": "T"
      }
    ],
    "notification": {
      "format": "normalized"
    }
  }
}'
wsConnect --port $FT_PORT --payload "$payload"
echo "WS Subscription Id: $wsSubId"
echo
echo


echo "02. Create an entity of type T via REST API"
echo "============================================"
payload='{
  "id": "urn:ngsi-ld:E01",
  "type": "T",
  "P1": 1
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Ask ftClient for WS notification dump - see the notification"
echo "================================================================"
sleep 0.5
wsDump --subId $wsSubId --port $FT_PORT
echo
echo


--REGEXPECT--
01. Connect via WebSocket and subscribe for entity type T
=========================================================
WS Subscription Id: REGEX(urn:.*)


02. Create an entity of type T via REST API
============================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E01



03. Ask ftClient for WS notification dump - see the notification
================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

[
  {
    "metadata": {
      "Content-Type": "application/json",
      "User-Agent": "REGEX(.*)",
      "Host": "REGEX(urn:ngsi-ld:ws:\d+)",
      "Accept": "application/json",
      "Ngsild-Attribute-Format": "Normalized",
      "Link": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)"
    },
    "body": {
      "id": "REGEX(urn:ngsi-ld:Notification:.*)",
      "type": "Notification",
      "subscriptionId": "REGEX(urn:ngsi-ld:subscription:.*)",
      "notifiedAt": "REGEX(.*)",
      "data": [
        {
          "id": "urn:ngsi-ld:E01",
          "type": "T",
          "P1": {
            "type": "Property",
            "value": 1
          }
        }
      ]
    }
  }
]



--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
