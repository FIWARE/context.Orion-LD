# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
PATCH subscription over WebSocket

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly -wip ws
ftClientStart -v -t 200

--SHELL--

#
# 01. Connect via WebSocket and subscribe for entity type T
# 02. Send PATCH message over WS to add a description to the subscription
# 03. GET subscription from broker, verify the description was applied
#

echo "01. Connect via WebSocket and subscribe for entity type T"
echo "========================================================="
payload='{
  "metadata": {
    "Content-Type": "application/json"
  },
  "body": {
    "type": "Subscription",
    "entities": [
      {
        "type": "T"
      }
    ],
    "notification": {
      "format": "normalized"
    }
  }
}'
wsConnect --port $FT_PORT --payload "$payload"
echo "WS Subscription Id: $wsSubId"
echo
echo


echo "02. Send PATCH message over WS to add a description to the subscription"
echo "========================================================================"
payload='{
  "metadata": {
    "Content-Type": "application/json",
    "operation": "patchSubscription",
    "subscriptionId": "'$wsSubId'"
  },
  "body": {
    "description": "patched via websocket"
  }
}'
wsSend --subId $wsSubId --port $FT_PORT --payload "$payload"
sleep 0.5
echo
echo


echo "03. GET subscription from broker, verify the description was applied"
echo "===================================================================="
orionCurl --url /ngsi-ld/v1/subscriptions/$wsSubId
echo
echo


--REGEXPECT--
01. Connect via WebSocket and subscribe for entity type T
=========================================================
WS Subscription Id: REGEX(urn:.*)


02. Send PATCH message over WS to add a description to the subscription
========================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. GET subscription from broker, verify the description was applied
====================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "description": "patched via websocket",
    "entities": [
        {
            "type": "T"
        }
    ],
    "id": "REGEX(urn:.*)",
    "isActive": true,
    "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)",
    "notification": {
        "endpoint": {
            "accept": "application/json",
            "uri": "REGEX(.*)"
        },
        "format": "normalized",
        "status": "ok"
    },
    "origin": "cache",
    "status": "active",
    "type": "Subscription"
}


--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
