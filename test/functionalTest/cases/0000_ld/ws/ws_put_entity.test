# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
PUT entity over WebSocket

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly -wip ws
ftClientStart -v -t 200

--SHELL--

#
# 01. Create entity urn:ngsi-ld:E1 via HTTP with P1 and P2
# 02. Connect via WebSocket and subscribe for entity type T
# 03. Send putEntity over WS to replace the entity (P1 replaced, P2 removed, P3 added)
# 04. GET entity from broker, verify the PUT was applied
#

echo "01. Create entity urn:ngsi-ld:E1 via HTTP with P1 and P2"
echo "========================================================="
payload='{
  "id": "urn:ngsi-ld:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": "original"
  },
  "P2": {
    "type": "Property",
    "value": 42
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Connect via WebSocket and subscribe for entity type T"
echo "========================================================="
payload='{
  "metadata": {
    "Content-Type": "application/json"
  },
  "body": {
    "type": "Subscription",
    "entities": [
      {
        "type": "T"
      }
    ],
    "notification": {
      "format": "normalized"
    }
  }
}'
wsConnect --port $FT_PORT --payload "$payload"
echo "WS Subscription Id: $wsSubId"
echo
echo


echo "03. Send putEntity over WS to replace the entity"
echo "================================================="
payload='{
  "metadata": {
    "Content-Type": "application/json",
    "operation": "putEntity",
    "entityId": "urn:ngsi-ld:E1"
  },
  "body": {
    "id": "urn:ngsi-ld:E1",
    "type": "T",
    "P1": {
      "type": "Property",
      "value": "replaced via websocket"
    },
    "P3": {
      "type": "Property",
      "value": "new attribute"
    }
  }
}'
wsSend --subId $wsSubId --port $FT_PORT --payload "$payload"
sleep 0.5
echo
echo


echo "04. GET entity from broker, verify the PUT was applied"
echo "======================================================"
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1?options=keyValues
echo
echo


--REGEXPECT--
01. Create entity urn:ngsi-ld:E1 via HTTP with P1 and P2
=========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E1



02. Connect via WebSocket and subscribe for entity type T
=========================================================
WS Subscription Id: REGEX(urn:.*)


03. Send putEntity over WS to replace the entity
=================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



04. GET entity from broker, verify the PUT was applied
======================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": "replaced via websocket",
    "P3": "new attribute",
    "id": "urn:ngsi-ld:E1",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
