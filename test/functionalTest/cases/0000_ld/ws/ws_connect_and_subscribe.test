# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
WebSocket connect and subscribe

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly -wip ws
ftClientStart -v -t 200

--SHELL--

#
# 01. Tell ftClient to connect via WebSocket and create a subscription for entity type T
# 02. GET the subscription from the broker REST API, verify it exists
#

echo "01. Tell ftClient to connect via WebSocket and create a subscription for entity type T"
echo "======================================================================================"
payload='{
  "metadata": {
    "Content-Type": "application/json"
  },
  "body": {
    "type": "Subscription",
    "entities": [
      {
        "type": "T"
      }
    ],
    "notification": {
      "format": "normalized"
    }
  }
}'
wsConnect --port $FT_PORT --payload "$payload"
echo "WS Subscription Id: $wsSubId"
echo
echo


echo "02. GET the subscription from the broker REST API, verify it exists"
echo "==================================================================="
orionCurl --url /ngsi-ld/v1/subscriptions/$wsSubId
echo
echo


--REGEXPECT--
01. Tell ftClient to connect via WebSocket and create a subscription for entity type T
======================================================================================
WS Subscription Id: REGEX(urn:.*)


02. GET the subscription from the broker REST API, verify it exists
===================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "entities": [
        {
            "type": "T"
        }
    ],
    "id": "REGEX(urn:.*)",
    "isActive": true,
    "jsonldContext": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)",
    "notification": {
        "endpoint": {
            "accept": "application/json",
            "uri": "REGEX(.*)"
        },
        "format": "normalized",
        "status": "ok"
    },
    "origin": "cache",
    "status": "active",
    "type": "Subscription"
}


--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
