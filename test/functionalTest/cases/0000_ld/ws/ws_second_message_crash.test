# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
WebSocket multiple operations on same connection - crash reproduction

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly -wip ws
ftClientStart -v -t 200

--SHELL--

#
# Reproduce crash: SIGSEGV in kjParseArray when processing WS messages.
# The thread-local orionldState is reused between WS service calls.
#
# 01. Connect via WebSocket and subscribe for entity type T (first WS message)
# 02. Create entity via REST while sending createEntity+createSubscription over WS simultaneously
# 03. Verify broker is still alive by querying the entities via REST
#

echo "01. Connect via WebSocket and subscribe for entity type T"
echo "========================================================="
payload='{
  "metadata": {
    "Content-Type": "application/json"
  },
  "body": {
    "type": "Subscription",
    "entities": [
      {
        "type": "T"
      }
    ],
    "notification": {
      "format": "normalized"
    }
  }
}'
wsConnect --port $FT_PORT --payload "$payload"
echo "WS Subscription Id: $wsSubId"
echo
echo


echo "02. Burst: createEntity + createSubscription over WS simultaneously"
echo "===================================================================="
payload1='{
  "metadata": {
    "operation": "createEntity"
  },
  "body": {
    "id": "urn:ngsi-ld:E01",
    "type": "T",
    "P1": {
      "type": "Property",
      "value": 1
    }
  }
}'
payload2='{
  "metadata": {
    "operation": "createSubscription"
  },
  "body": {
    "type": "Subscription",
    "entities": [
      {
        "type": "T2"
      }
    ],
    "notification": {
      "format": "normalized"
    }
  }
}'
wsSendBurst --subId $wsSubId --port $FT_PORT --payload1 "$payload1" --payload2 "$payload2"
sleep 1
echo
echo


echo "03. Verify broker is still alive by querying E01 via REST"
echo "========================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E01
echo
echo


--REGEXPECT--
01. Connect via WebSocket and subscribe for entity type T
=========================================================
WS Subscription Id: REGEX(urn:.*)


02. Burst: createEntity + createSubscription over WS simultaneously
====================================================================
REGEX(.*)

03. Verify broker is still alive by querying E01 via REST
=========================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: REGEX(.*)

{
    "P1": {
        "type": "Property",
        "value": 1
    },
    "id": "urn:ngsi-ld:E01",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
