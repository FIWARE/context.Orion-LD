# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Temporal entity query with pick and omit parameters

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental

--SHELL--

#
# 01. Create entity E1 with attrs P1=10, P2="hello", R1
# 02. Update P1 to 20
# 03. GET temporal with pick=P1 - only P1 in response
# 04. GET temporal with pick=P1,P2 - both P1 and P2 in response
# 05. GET temporal with omit=R1 - P1 and P2 present, R1 absent
# 06. GET temporal with both pick and omit - 400 error
#

echo "01. Create entity E1 with attrs P1=10, P2=hello, R1"
echo "===================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 10,
    "observedAt": "2024-01-01T10:00:00Z"
  },
  "P2": {
    "type": "Property",
    "value": "hello",
    "observedAt": "2024-01-01T10:00:00Z"
  },
  "R1": {
    "type": "Relationship",
    "object": "urn:ngsi-ld:entities:E2",
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep 1.1


echo "02. Update P1 to 20"
echo "===================="
payload='{
  "P1": {
    "type": "Property",
    "value": 20,
    "observedAt": "2024-01-01T11:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" --verb PATCH
echo
echo


echo "03. GET temporal with pick=P1 - only P1 in response"
echo "===================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&pick=P1'
echo
echo


echo "04. GET temporal with pick=P1,P2 - both P1 and P2 in response"
echo "=============================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&pick=P1,P2'
echo
echo


echo "05. GET temporal with omit=R1 - P1 and P2 present, R1 absent"
echo "============================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&omit=R1'
echo
echo


echo "06. GET temporal with both pick and omit - 400 error"
echo "====================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&pick=P1&omit=R1'
echo
echo


--REGEXPECT--
01. Create entity E1 with attrs P1=10, P2=hello, R1
====================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. Update P1 to 20
====================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. GET temporal with pick=P1 - only P1 in response
====================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": [
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T11:00:00Z",
            "type": "Property",
            "value": 20
        },
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": 10
        }
    ]
}


04. GET temporal with pick=P1,P2 - both P1 and P2 in response
==============================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": [
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T11:00:00Z",
            "type": "Property",
            "value": 20
        },
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": 10
        }
    ],
    "P2": [
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": "hello"
        }
    ]
}


05. GET temporal with omit=R1 - P1 and P2 present, R1 absent
=============================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": [
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T11:00:00Z",
            "type": "Property",
            "value": 20
        },
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": 10
        }
    ],
    "P2": [
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": "hello"
        }
    ],
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


06. GET temporal with both pick and omit - 400 error
=====================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "pick and omit cannot be used together",
    "title": "Incompatible URI parameters",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
