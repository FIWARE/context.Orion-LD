# DISABLED: This test requires a running Kafka broker (localhost:9092), like
# troe_kafka_consumer_ingestion.test. To enable: remove the .DISABLED suffix and
# start Kafka (see that test's header for the KRaft docker command), then create
# both the ingest and the ACK/NACK topics:
#
#   docker exec kafka kafka-topics --create --topic orionld-test --bootstrap-server localhost:9092 --partitions 2
#   docker exec kafka kafka-topics --create --topic orionld-ack  --bootstrap-server localhost:9092 --partitions 1
#
# Covers a durable batch (-> ACK) and a poison message (-> NACK carrying the raw bytes). The NACK on a
# TRoE (Postgres) write failure travels the identical kafkaAckSend() path (only the trigger and the
# payload source differ) and is not reproduced here because reliably forcing a live TRoE failure mid-run
# is environment-dependent (pgDrop cannot drop a db the broker still holds a connection to).
#
# NOTE on timing: the Kafka consumer uses auto.offset.reset=latest, so a message produced before the
# consumer has joined the group + been assigned its partitions is skipped. The valid entity is therefore
# produced in a retry loop until it actually lands (produceUntilPersisted); the malformed message comes
# later, when the consumer is long ready.

# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Kafka ACK/NACK feedback - a durable batch ACKs, a parse-failed batch NACKs (with the raw bytes)

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental -kafka -kafkaBrokerList localhost:9092 -kafkaTopic orionld-test -kafkaAckTopic orionld-ack -kafkaGroupId orionld-functest -kafkaBatchSize 10 -kafkaBatchLingerMs 500

--SHELL--

#
# Helper: produce a valid entity repeatedly until it is persisted (HTTP 200) or the deadline passes.
# Beats the consumer's auto.offset.reset=latest join race - a message produced before the consumer is
# assigned its partitions is silently skipped, so a single up-front produce is not reliable.
#
produceUntilPersisted()
{
  local entityId=$1
  local payload=$2
  local deadline=$(( $(date +%s) + 90 ))

  while [ $(date +%s) -lt $deadline ]
  do
    echo "$payload" | docker exec -i kafka kafka-console-producer --broker-list localhost:9092 --topic orionld-test 2>/dev/null
    sleep 2
    if [ "$(curl -s -o /dev/null -w '%{http_code}' http://localhost:$CB_PORT/ngsi-ld/v1/entities/$entityId)" = "200" ]; then
      return 0
    fi
  done
  echo "WARNING: entity $entityId not persisted before deadline"
  return 1
}

#
# Helper: dump the whole ACK/NACK topic (fresh random consumer group -> reads from the beginning)
#
ackDump()
{
  docker exec kafka kafka-console-consumer --bootstrap-server localhost:9092 --topic orionld-ack --from-beginning --timeout-ms 4000 2>/dev/null
}

#
# Helper: poll the ACK/NACK topic until a record matching a (fixed-string) pattern appears, or the
# wall-clock deadline passes. Each ackDump call already blocks ~4s, so no extra sleep is needed - and the
# deadline is real seconds (not iterations), so the timeout is honoured regardless of ackDump's duration.
#
waitForAck()
{
  local pattern=$1
  local deadline=$(( $(date +%s) + ${2:-40} ))

  while [ $(date +%s) -lt $deadline ]
  do
    if ackDump | grep -q -F -- "$pattern"; then
      return 0
    fi
  done
  echo "WARNING: no ACK/NACK record matching '$pattern' before deadline"
  return 1
}

#
# 01. Produce a valid entity (retry past the 'latest' join race) until it is persisted in MongoDB
# 02. An ACK for the durable batch appears on the ACK topic
# 03. Produce a malformed (unparseable) message to the ingest topic
# 04. A parse-fail NACK appears on the ACK topic - carrying the raw bytes
#

echo "01. Produce a valid entity until it is persisted"
echo "================================================="
produceUntilPersisted urn:ngsi-ld:Sensor:A1 '{"id":"urn:ngsi-ld:Sensor:A1","type":"Sensor","temperature":{"type":"Property","value":23.5}}'
echo "Entity persisted"
echo
echo


echo "02. An ACK for the durable batch appears on the ACK topic"
echo "=========================================================="
waitForAck '"status":"ack"'
ackDump | grep -o '"status":"ack"' | head -1
echo
echo


echo "03. Produce a malformed (unparseable) message to the ingest topic"
echo "=================================================================="
echo 'THIS-IS-NOT-JSON' | docker exec -i kafka kafka-console-producer --broker-list localhost:9092 --topic orionld-test
echo "Message produced"
echo
echo


echo "04. A parse-fail NACK appears on the ACK topic (carrying the raw bytes)"
echo "======================================================================="
waitForAck 'Kafka message parse failed'
ackDump | grep -o '"status":"nack"' | head -1
ackDump | grep -o 'Kafka message parse failed' | head -1
ackDump | grep -o 'THIS-IS-NOT-JSON' | head -1
echo
echo


--REGEXPECT--
01. Produce a valid entity until it is persisted
=================================================
Entity persisted


02. An ACK for the durable batch appears on the ACK topic
==========================================================
"status":"ack"


03. Produce a malformed (unparseable) message to the ingest topic
==================================================================
Message produced


04. A parse-fail NACK appears on the ACK topic (carrying the raw bytes)
=======================================================================
"status":"nack"
Kafka message parse failed
THIS-IS-NOT-JSON


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
