# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
TRoE with a filter on entity types

--SHELL-INIT--
$REPO_HOME/scripts/configFile.sh --troe ",,https://uri.etsi.org/ngsi-ld/default-context/T1+https://uri.etsi.org/ngsi-ld/default-context/T2," > $HOME/.orionld
dbInit CB
pgInit $CB_DB_NAME
orionldStart CB -mongocOnly -troe

--SHELL--

#
# 01. Create an entity urn:E1 of type T1 - to TRoE                                   - POST /entities
# 02. Create an entity urn:E2 of type T3 - NOT to TRoE
# 03. See entities in postgres
# 04. See attributes in postgres
#
# 11. Update urn:E1 using POST /entities/*/attrs - to TRoE                           - POST /entities/{entityId}/attrs
# 12. Update urn:E2 using POST /entities/*/attrs - NOT to TRoE
# 13. See entities in postgres
# 14. See attributes in postgres
#
# 21. Delete the attribute P2 (added in step 11) in  from urn:E1 - to TRoE           - DELETE /entities/{entityId}/attrs/{attrName}
# 22. Delete the attribute P2 (added in step 11) in  from urn:E2 - NOT to TRoE
# 23. See entities in postgres - no change
# 24. See attributes in postgres - see DELETION of urn:E1/P2 but NOT urn:E2/P2
#
# 31. PATCH urn:E1/P1 using PATCH /entities/{entityId}/attrs/P1 - to TRoE            - PATCH /entities/{entityId}/attrs/{attrName}
# 32. PATCH urn:E2/P1 using PATCH /entities/{entityId}/attrs/P1 - NOT to TRoE
# 33. See entities in postgres - no change
# 34. See attributes in postgres - see Update of urn:E1/P1
#
# 41. Delete urn:E1 using DELETE /entities/{entityId} - to TRoE                      - DELETE /entities/{entityId}
# 42. Delete urn:E2 using DELETE /entities/{entityId} - NOT to TRoE
# 43. See entities in postgres - see deletion of urn:E1
# 44. See attributes in postgres - no change
#
# 51. Create urn:E3 and urn:E4 (type T1) and urn:E5 (type T3) - 2/3 to TRoE          - POST /entityOperations/create
# 52. See entities in postgres - see urn:E3 and urn:E4
# 53. See attributes in postgres - see new attr of urn:E3 and urn:E4
#
# 61. BATCH Upsert urn:E6 and urn:E7 (type T1) and urn:E8 (type T3) - 2/3 to TRoE    - POST /entityOperations/upsert
# 62. See entities in postgres - see urn:E6 and urn:E7
# 63. See attributes in postgres - see new attr of urn:E6 and urn:E7
#
# 71. BATCH Update urn:E6 and urn:E7 (type T1) and urn:E8 (type T3) - 2/3 to TRoE    - POST /entityOperations/upsert
# 72. See entities in postgres - no change
# 73. See attributes in postgres - see updates of attrs of urn:E6 and urn:E7
#
# 81. PATCH urn:E6 - to TRoE                                                         - PATCH /entities/{entityId}/attrs
# 82. PATCH urn:E8 - NOT to TRoE
# 83. See entities in postgres - no change
# 84. See attributes in postgres - see attributes of urn:E6
#
# 91. PATCH urn:E6 - to TRoE                                                         - PATCH /entities/{entityId}
# 92. PATCH urn:E8 - NOT to TRoE
# 93. See entities in postgres - see Update of urn:E6, but not of urn:E8
# 94. See attributes in postgres - see attributes of urn:E6
#
# 101. PUT urn:E6 - to TRoE                                                          - PUT /entities/{entityId}
# 102. PUT urn:E8 - NOT to TRoE
# 103. See entities in postgres - no change
# 104. See attributes in postgres - see attribute P61 of urn:E6
#
# 111. PUT urn:E6/P61 - to TRoE                                                      - PUT /entities/{entityId}/attrs/P61
# 112. PUT urn:E8/P61 - NOT to TRoE
# 113. See entities in postgres - no change
# 114. See attributes in postgres - see attribute P61 of urn:E6
#
# 121. BATCH DELETE urn:E3-E8 - E3+E6+E7 to TRoE, E4+E8 NOT to TRoE                  - POST /entityOperations/delete
# 122. See entities in postgres - see urn:E3+E6+E7
# 123. See attributes in postgres - no change
#

echo "01. Create an entity urn:E1 of type T1 - to TRoE"
echo "================================================"
payload='{
  "id": "urn:E1",
  "type": "T1",
  "P1": {
    "type": "Property",
    "value": 1
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create an entity urn:E2 of type T3 - NOT to TRoE"
echo "===================================================="
payload='{
  "id": "urn:E2",
  "type": "T3",
  "P1": {
    "type": "Property",
    "value": 1
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. See entities in postgres"
echo "============================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "04. See attributes in postgres"
echo "=============================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "11. Update urn:E1 using POST /entities/*/attrs - to TRoE"
echo "========================================================"
payload='{
  "P2": {
    "type": "Property",
    "value": 1
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs --payload "$payload"
echo
echo


echo "12. Update urn:E2 using POST /entities/*/attrs - NOT to TRoE"
echo "============================================================"
payload='{
  "P2": {
    "type": "Property",
    "value": 1
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E2/attrs --payload "$payload"
echo
echo


echo "13. See entities in postgres"
echo "============================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "14. See attributes in postgres"
echo "=============================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "21. Delete the attribute P2 (added in step 11) in  from urn:E1 - to TRoE"
echo "========================================================================"
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/P2 -X DELETE
echo
echo


echo "22. Delete the attribute P2 (added in step 11) in  from urn:E2 - NOT to TRoE"
echo "============================================================================"
orionCurl --url /ngsi-ld/v1/entities/urn:E2/attrs/P2 -X DELETE
echo
echo


echo "23. See entities in postgres - no change"
echo "========================================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "24. See attributes in postgres - see DELETION of urn:E1/P2 but NOT urn:E2/P2"
echo "============================================================================"
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "31. PATCH urn:E1/P1 using PATCH /entities/{entityId}/attrs/P1 - to TRoE"
echo "======================================================================="
payload='{
  "value": 31
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/P1 --payload "$payload" -X PATCH
echo
echo


echo "32. PATCH urn:E2/P1 using PATCH /entities/{entityId}/attrs/P1 - NOT to TRoE"
echo "==========================================================================="
payload='{
  "value": 32
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E2/attrs/P1 --payload "$payload" -X PATCH
echo
echo


echo "33. See entities in postgres - no change"
echo "========================================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "34. See attributes in postgres - see Update of urn:E1/P1"
echo "========================================================"
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "41. Delete urn:E1 using DELETE /entities/{entityId} - to TRoE"
echo "============================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1 -X DELETE
echo
echo


echo "42. Delete urn:E2 using DELETE /entities/{entityId} - NOT to TRoE"
echo "================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E2 -X DELETE
echo
echo


echo "43. See entities in postgres - see deletion of urn:E1"
echo "====================================================="
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "44. See attributes in postgres - no change"
echo "=========================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "51. Create urn:E3 and urn:E4 (type T1) and urn:E5 (type T3) - 2/3 to TRoE"
echo "========================================================================="
payload='[
  {
    "id": "urn:E3",
    "type": "T1",
    "P51": 32
  },
  {
    "id": "urn:E4",
    "type": "T1",
    "P51": 32
  },
  {
    "id": "urn:E5",
    "type": "T3",
    "P51": 32
  }
]'
orionCurl --url /ngsi-ld/v1/entityOperations/create --payload "$payload"
echo
echo


echo "52. See entities in postgres - see urn:E3 and urn:E4"
echo "===================================================="
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "53. See attributes in postgres - see new attr of urn:E3 and urn:E4"
echo "=================================================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "61. BATCH Upsert urn:E6 and urn:E7 (type T1) and urn:E8 (type T3) - 2/3 to TRoE"
echo "==============================================================================="
payload='[
  {
    "id": "urn:E6",
    "type": "T1",
    "P61": 32
  },
  {
    "id": "urn:E7",
    "type": "T1",
    "P61": 32
  },
  {
    "id": "urn:E8",
    "type": "T3",
    "P61": 32
  }
]'
orionCurl --url /ngsi-ld/v1/entityOperations/upsert --payload "$payload"
echo
echo


echo "62. See entities in postgres - see urn:E6 and urn:E7"
echo "===================================================="
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "63. See attributes in postgres - see new attr of urn:E6 and urn:E7"
echo "=================================================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "71. BATCH Update urn:E6 and urn:E7 (type T1) and urn:E8 (type T3) - 2/3 to TRoE"
echo "==============================================================================="
payload='[
  {
    "id": "urn:E6",
    "type": "T1",
    "P61": 71
  },
  {
    "id": "urn:E7",
    "type": "T1",
    "P61": 71
  },
  {
    "id": "urn:E8",
    "type": "T3",
    "P61": 71
  }
]'
orionCurl --url /ngsi-ld/v1/entityOperations/update --payload "$payload"
echo
echo


echo "72. See entities in postgres - no change"
echo "========================================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "73. See attributes in postgres - see updates of attrs of urn:E6 and urn:E7"
echo "=========================================================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "81. PATCH urn:E6 - to TRoE"
echo "=========================="
payload='{
  "P61": {
    "value": 81
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E6/attrs --payload "$payload" -X PATCH
echo
echo


echo "82. PATCH urn:E8 - NOT to TRoE"
echo "=============================="
payload='{
  "P61": {
    "value": 82
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E8/attrs --payload "$payload" -X PATCH
echo
echo


echo "83. See entities in postgres - no change"
echo "========================================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "84. See attributes in postgres - see attributes of urn:E6"
echo "========================================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "91. PATCH urn:E6 - to TRoE"
echo "=========================="
payload='{
  "P61": {
    "value": 91
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E6 --payload "$payload" -X PATCH
echo
echo


echo "92. PATCH urn:E8 - NOT to TRoE"
echo "=============================="
payload='{
  "P61": {
    "value": 92
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E8 --payload "$payload" -X PATCH
echo
echo


echo "93. See entities in postgres - no change"
echo "========================================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "94. See attributes in postgres - see attributes of urn:E6"
echo "========================================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "101. PUT urn:E6 - to TRoE"
echo "========================="
payload='{
  "type": "T1",
  "P61": {
    "value": 101
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E6 --payload "$payload" -X PUT
echo
echo


echo "102. PUT urn:E8 - NOT to TRoE"
echo "============================="
payload='{
  "type": "T3",
  "P61": {
    "value": 102
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E8 --payload "$payload" -X PUT
echo
echo


echo "103. See entities in postgres - no change"
echo "========================================="
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "104. See attributes in postgres - see attribute P61 of urn:E6"
echo "============================================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "111. PUT urn:E6/P61 - to TRoE"
echo "============================="
payload='{
  "value": 111
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E6/attrs/P61 --payload "$payload" -X PUT
echo
echo


echo "112. PUT urn:E8/P61 - NOT to TRoE"
echo "================================="
payload='{
  "value": 111
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E8/attrs/P61 --payload "$payload" -X PUT
echo
echo


echo "113. See entities in postgres - no change"
echo "========================================="
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "114. See attributes in postgres - see attribute P61 of urn:E6"
echo "============================================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


echo "121. BATCH DELETE urn:E3-E8 - E3+E6+E7 to TRoE, E4+E8 NOT to TRoE"
echo "================================================================="
payload='[
  "urn:E3",
  "urn:E4",
  "urn:E5",
  "urn:E6",
  "urn:E7",
  "urn:E8"
]'
orionCurl --url /ngsi-ld/v1/entityOperations/delete --payload "$payload"
echo
echo


echo "122. See entities in postgres - see urn:E3+E6+E7"
echo "================================================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "123. See attributes in postgres - no change"
echo "==========================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


