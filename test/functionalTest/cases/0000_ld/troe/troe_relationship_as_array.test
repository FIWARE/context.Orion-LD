# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
PUT Entity and TRoE with Relationship that is an array

--SHELL-INIT--
dbInit CB
pgInit $CB_DB_NAME
orionldStart CB -troe 

--SHELL--

# 01. Create an entity E1 with attr S1

echo "01. Create an entity E1 with attr S1"
echo "===================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "R1": {
    "type": "Relationship",
    "object": [ "urn:E1", "urn:E2" ]
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. See the string-attribute in the temporal database"
echo "====================================================="
postgresCmd -sql "SELECT opmode,id,valueType,entityId,compound,ts FROM attributes"
echo
echo


--REGEXPECT--
01. Create an entity E1 with attr S1
====================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. See the string-attribute in the temporal database
=====================================================
opmode,id,valuetype,entityid,compound,ts
Create,https://uri.etsi.org/ngsi-ld/default-context/R1,Relationship,urn:ngsi-ld:entities:E1,"[""urn:E1"", ""urn:E2""]",202REGEX(.*)


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
