# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Temporal queries with aggregation (aggrMethods / aggrPeriodDuration)

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental

--SHELL--

#
# 01. Create entity E1 (type T) with P1=10, observedAt T10:00
# 02. Update P1=20, observedAt T11:00
# 03. Update P1=30, observedAt T12:00
# 04. Create entity E2 (type T) with P1=100, observedAt T10:00
# 05. GET temporal entity E1 with aggrMethods=avg - should return avg=20
# 06. GET temporal entity E1 with aggrMethods=min,max,sum - should return min=10, max=30, sum=60
# 07. GET temporal entities with aggrMethods=avg - should return avg for E1 and E2
# 08. POST temporal query with aggrMethods=avg in temporalQ - should return avg for E1 and E2
# 09. GET temporal entity E1 with aggrMethods=avg and aggrPeriodDuration=PT2H (two periods)
# 10. GET temporal entity E1 with aggrMethods=stddev - should return stddev
#

echo "01. Create entity E1 (type T) with P1=10, observedAt T10:00"
echo "============================================================"
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 10,
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Update P1=20, observedAt T11:00"
echo "===================================="
payload='{
  "P1": {
    "type": "Property",
    "value": 20,
    "observedAt": "2024-01-01T11:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" -X POST
echo
echo


echo "03. Update P1=30, observedAt T12:00"
echo "===================================="
payload='{
  "P1": {
    "type": "Property",
    "value": 30,
    "observedAt": "2024-01-01T12:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" -X POST
echo
echo


echo "04. Create entity E2 (type T) with P1=100, observedAt T10:00"
echo "============================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E2",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 100,
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep 1


echo "05. GET temporal entity E1 with aggrMethods=avg - should return avg=20"
echo "======================================================================"
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=between&timeAt=2024-01-01T09:00:00Z&endTimeAt=2024-01-01T13:00:00Z&aggrMethods=avg'
echo
echo


echo "06. GET temporal entity E1 with aggrMethods=min,max,sum"
echo "======================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=between&timeAt=2024-01-01T09:00:00Z&endTimeAt=2024-01-01T13:00:00Z&aggrMethods=min%2Cmax%2Csum'
echo
echo


echo "07. GET temporal entities with aggrMethods=avg"
echo "==============================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=between&timeAt=2024-01-01T09:00:00Z&endTimeAt=2024-01-01T13:00:00Z&aggrMethods=avg'
echo
echo


echo "08. POST temporal query with aggrMethods=avg in temporalQ"
echo "=========================================================="
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "T"
    }
  ],
  "temporalQ": {
    "timerel": "between",
    "timeAt": "2024-01-01T09:00:00Z",
    "endTimeAt": "2024-01-01T13:00:00Z",
    "aggrMethods": "avg"
  }
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


echo "09. GET temporal entity E1 with aggrMethods=avg and aggrPeriodDuration=PT2H"
echo "============================================================================"
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=between&timeAt=2024-01-01T10:00:00Z&endTimeAt=2024-01-01T14:00:00Z&aggrMethods=avg&aggrPeriodDuration=PT2H'
echo
echo


echo "10. GET temporal entity E1 with aggrMethods=stddev"
echo "==================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=between&timeAt=2024-01-01T09:00:00Z&endTimeAt=2024-01-01T13:00:00Z&aggrMethods=stddev'
echo
echo


--REGEXPECT--
01. Create entity E1 (type T) with P1=10, observedAt T10:00
============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. Update P1=20, observedAt T11:00
====================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. Update P1=30, observedAt T12:00
====================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



04. Create entity E2 (type T) with P1=100, observedAt T10:00
=============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E2



05. GET temporal entity E1 with aggrMethods=avg - should return avg=20
======================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": {
        "avg": [
            [
                20,
                "2024-01-01T09:00:00Z",
                "2024-01-01T13:00:00Z"
            ]
        ],
        "type": "Property"
    },
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


06. GET temporal entity E1 with aggrMethods=min,max,sum
=======================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": {
        "max": [
            [
                30,
                "2024-01-01T09:00:00Z",
                "2024-01-01T13:00:00Z"
            ]
        ],
        "min": [
            [
                10,
                "2024-01-01T09:00:00Z",
                "2024-01-01T13:00:00Z"
            ]
        ],
        "sum": [
            [
                60,
                "2024-01-01T09:00:00Z",
                "2024-01-01T13:00:00Z"
            ]
        ],
        "type": "Property"
    },
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


07. GET temporal entities with aggrMethods=avg
===============================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "P1": {
            "avg": [
                [
                    20,
                    "2024-01-01T09:00:00Z",
                    "2024-01-01T13:00:00Z"
                ]
            ],
            "type": "Property"
        },
        "id": "urn:ngsi-ld:entities:E1",
        "type": "T"
    },
    {
        "P1": {
            "avg": [
                [
                    100,
                    "2024-01-01T09:00:00Z",
                    "2024-01-01T13:00:00Z"
                ]
            ],
            "type": "Property"
        },
        "id": "urn:ngsi-ld:entities:E2",
        "type": "T"
    }
]


08. POST temporal query with aggrMethods=avg in temporalQ
==========================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "P1": {
            "avg": [
                [
                    20,
                    "2024-01-01T09:00:00Z",
                    "2024-01-01T13:00:00Z"
                ]
            ],
            "type": "Property"
        },
        "id": "urn:ngsi-ld:entities:E1",
        "type": "T"
    },
    {
        "P1": {
            "avg": [
                [
                    100,
                    "2024-01-01T09:00:00Z",
                    "2024-01-01T13:00:00Z"
                ]
            ],
            "type": "Property"
        },
        "id": "urn:ngsi-ld:entities:E2",
        "type": "T"
    }
]


09. GET temporal entity E1 with aggrMethods=avg and aggrPeriodDuration=PT2H
============================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": {
        "avg": [
            [
                15,
                "2024-01-01T10:00:00Z",
                "2024-01-01T12:00:00Z"
            ],
            [
                30,
                "2024-01-01T12:00:00Z",
                "2024-01-01T14:00:00Z"
            ]
        ],
        "type": "Property"
    },
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


10. GET temporal entity E1 with aggrMethods=stddev
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": {
        "stddev": [
            [
                REGEX(8\.16496.*),
                "2024-01-01T09:00:00Z",
                "2024-01-01T13:00:00Z"
            ]
        ],
        "type": "Property"
    },
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
