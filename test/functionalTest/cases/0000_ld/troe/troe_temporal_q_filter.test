# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Temporal queries with q-filter (property-based entity filtering)

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental

--SHELL--

#
# 01. Create entity E1 (type T) with P1=10, P2="alpha"
# 02. Create entity E2 (type T) with P1=50, P2="beta"
# 03. Create entity E3 (type T) with P1=100, P2="gamma"
# 04. GET temporal entities with q=P1>30 - should return E2 and E3
# 05. GET temporal entities with q=P1==10 - should return only E1
# 06. GET temporal entities with q=P2=="beta" - should return only E2
# 07. GET temporal entities with q=P1>30;P2=="gamma" - should return only E3 (AND)
# 08. GET temporal entities with q=P1==10|P1==100 - should return E1 and E3 (OR)
# 09. POST temporal query with q=P1>30 - should return E2 and E3
# 10. GET temporal entities with q=P1==5..55 - range, should return E1 and E2
#

echo "01. Create entity E1 (type T) with P1=10, P2=alpha"
echo "===================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 10,
    "observedAt": "2024-01-01T10:00:00Z"
  },
  "P2": {
    "type": "Property",
    "value": "alpha",
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create entity E2 (type T) with P1=50, P2=beta"
echo "==================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E2",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 50,
    "observedAt": "2024-01-01T10:00:00Z"
  },
  "P2": {
    "type": "Property",
    "value": "beta",
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E3 (type T) with P1=100, P2=gamma"
echo "====================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E3",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 100,
    "observedAt": "2024-01-01T10:00:00Z"
  },
  "P2": {
    "type": "Property",
    "value": "gamma",
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep 1


echo "04. GET temporal entities with q=P1>30 - should return E2 and E3"
echo "================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2025-01-01T00:00:00Z&q=P1%3E30'
echo
echo


echo "05. GET temporal entities with q=P1==10 - should return only E1"
echo "================================================================"
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2025-01-01T00:00:00Z&q=P1%3D%3D10'
echo
echo


echo "06. GET temporal entities with q=P2==beta - should return only E2"
echo "=================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2025-01-01T00:00:00Z&q=P2%3D%3D%22beta%22'
echo
echo


echo "07. GET temporal entities with q=P1>30;P2==gamma - should return only E3"
echo "========================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2025-01-01T00:00:00Z&q=P1%3E30%3BP2%3D%3D%22gamma%22'
echo
echo


echo "08. GET temporal entities with q=P1==10|P1==100 - should return E1 and E3"
echo "=========================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2025-01-01T00:00:00Z&q=P1%3D%3D10%7CP1%3D%3D100'
echo
echo


echo "09. POST temporal query with q=P1>30 - should return E2 and E3"
echo "================================================================"
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "T"
    }
  ],
  "q": "P1>30",
  "temporalQ": {
    "timerel": "before",
    "timeAt": "2025-01-01T00:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


echo "10. GET temporal entities with q=P1==5..55 - range, should return E1 and E2"
echo "============================================================================"
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2025-01-01T00:00:00Z&q=P1%3D%3D5..55'
echo
echo


--REGEXPECT--
01. Create entity E1 (type T) with P1=10, P2=alpha
====================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. Create entity E2 (type T) with P1=50, P2=beta
===================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E2



03. Create entity E3 (type T) with P1=100, P2=gamma
=====================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E3



04. GET temporal entities with q=P1>30 - should return E2 and E3
=================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E2".*"id":"urn:ngsi-ld:entities:E3".*\])


05. GET temporal entities with q=P1==10 - should return only E1
================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E1".*\])


06. GET temporal entities with q=P2==beta - should return only E2
==================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E2".*\])


07. GET temporal entities with q=P1>30;P2==gamma - should return only E3
=========================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E3".*\])


08. GET temporal entities with q=P1==10|P1==100 - should return E1 and E3
==========================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E1".*"id":"urn:ngsi-ld:entities:E3".*\])


09. POST temporal query with q=P1>30 - should return E2 and E3
================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E2".*"id":"urn:ngsi-ld:entities:E3".*\])


10. GET temporal entities with q=P1==5..55 - range, should return E1 and E2
============================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E1".*"id":"urn:ngsi-ld:entities:E2".*\])


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
