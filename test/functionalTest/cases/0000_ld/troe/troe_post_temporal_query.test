# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
POST /temporal/entityOperations/query - temporal query via POST body

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental

--SHELL--

#
# 01. Create entity E1 (type T) with P1=10
# 02. Create entity E2 (type T) with P1=20, P2="hello"
# 03. Create entity E3 (type T2) with P1=30
# 04. Update E1 P1 to 15
# 05. POST temporal query with entities type=T - should return E1 and E2
# 06. POST temporal query with entities type=T, count=true - verify count header
# 07. POST temporal query without temporalQ - 400 error
# 08. POST temporal query without entities and attrs - 400 error
# 09. POST temporal query with type != "Query" - 400 error
# 10. POST temporal query with entities type=T2 - only E3
# 11. POST temporal query with attrs filter
#

echo "01. Create entity E1 (type T) with P1=10"
echo "=========================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 10,
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create entity E2 (type T) with P1=20, P2=hello"
echo "==================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E2",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 20,
    "observedAt": "2024-01-01T10:00:00Z"
  },
  "P2": {
    "type": "Property",
    "value": "hello",
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E3 (type T2) with P1=30"
echo "==========================================="
payload='{
  "id": "urn:ngsi-ld:entities:E3",
  "type": "T2",
  "P1": {
    "type": "Property",
    "value": 30,
    "observedAt": "2024-01-01T10:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Update E1 P1 to 15"
echo "========================"
payload='{
  "P1": {
    "type": "Property",
    "value": 15,
    "observedAt": "2024-01-01T11:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" -X PATCH
echo
echo


sleep 1


echo "04b. Debug: check what's in the TRoE entities table"
echo "===================================================="
postgresCmd -sql "SELECT id, type, opmode FROM entities ORDER BY id"
echo
echo


echo "04c. Debug: GET temporal entities with type=T to compare with POST"
echo "=================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities?type=T&timerel=before&timeAt=2025-01-01T00:00:00Z'
echo
echo


echo "05. POST temporal query with entities type=T - should return E1 and E2"
echo "======================================================================="
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "T"
    }
  ],
  "temporalQ": {
    "timerel": "before",
    "timeAt": "2025-01-01T00:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


echo "06. POST temporal query with entities type=T, count=true - verify count header"
echo "==============================================================================="
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "T"
    }
  ],
  "temporalQ": {
    "timerel": "before",
    "timeAt": "2025-01-01T00:00:00Z"
  }
}'
orionCurl --url '/ngsi-ld/v1/temporal/entityOperations/query?count=true' --payload "$payload"
echo
echo


echo "07. POST temporal query without temporalQ - 400 error"
echo "======================================================"
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "T"
    }
  ]
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


echo "08. POST temporal query without entities and attrs - 400 error"
echo "==============================================================="
payload='{
  "type": "Query",
  "temporalQ": {
    "timerel": "before",
    "timeAt": "2025-01-01T00:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


echo "09. POST temporal query with type != Query - 400 error"
echo "======================================================="
payload='{
  "type": "NotAQuery",
  "entities": [
    {
      "type": "T"
    }
  ],
  "temporalQ": {
    "timerel": "before",
    "timeAt": "2025-01-01T00:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


echo "10. POST temporal query with entities type=T2 - only E3"
echo "========================================================"
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "T2"
    }
  ],
  "temporalQ": {
    "timerel": "before",
    "timeAt": "2025-01-01T00:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


echo "11. POST temporal query with attrs filter"
echo "==========================================="
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "T"
    }
  ],
  "attrs": ["P2"],
  "temporalQ": {
    "timerel": "before",
    "timeAt": "2025-01-01T00:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/temporal/entityOperations/query --payload "$payload"
echo
echo


--REGEXPECT--
01. Create entity E1 (type T) with P1=10
==========================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. Create entity E2 (type T) with P1=20, P2=hello
===================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E2



03. Create entity E3 (type T2) with P1=30
===========================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E3



04. Update E1 P1 to 15
========================
HTTP/1.1 204 No Content
Date: REGEX(.*)



04b. Debug: check what's in the TRoE entities table
====================================================
REGEX(.*)



04c. Debug: GET temporal entities with type=T to compare with POST
==================================================================
REGEX(.*)



05. POST temporal query with entities type=T - should return E1 and E2
=======================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E1".*"id":"urn:ngsi-ld:entities:E2".*\])


06. POST temporal query with entities type=T, count=true - verify count header
===============================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
NGSILD-Results-Count: 2

REGEX(\[.*"id":"urn:ngsi-ld:entities:E1".*"id":"urn:ngsi-ld:entities:E2".*\])


07. POST temporal query without temporalQ - 400 error
======================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "temporalQ",
    "title": "Mandatory field missing",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


08. POST temporal query without entities and attrs - 400 error
===============================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "entities or attrs must be provided",
    "title": "Missing required field",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


09. POST temporal query with type != Query - 400 error
=======================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "must be 'Query'",
    "title": "Invalid value for 'type'",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


10. POST temporal query with entities type=T2 - only E3
========================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"id":"urn:ngsi-ld:entities:E3".*\])


11. POST temporal query with attrs filter
===========================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(\[.*"P2".*\])


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
