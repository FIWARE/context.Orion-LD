# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Temporal entity query with datasetId filter

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental

--SHELL--

#
# 01. Create entity E1 with P1 having default dataset and P1 with datasetId=urn:ds1
# 02. Update P1 (default) to 20
# 03. GET temporal without datasetId - all instances returned as arrays
# 04. GET temporal with datasetId=urn:ds1 - only instances with urn:ds1
#

echo "01. Create entity E1 with P1 default and P1 with datasetId=urn:ds1"
echo "==================================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "P1": [
    {
      "type": "Property",
      "value": 10,
      "observedAt": "2024-01-01T10:00:00Z"
    },
    {
      "type": "Property",
      "value": 100,
      "datasetId": "urn:ds1",
      "observedAt": "2024-01-01T10:00:00Z"
    }
  ]
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep 1.1


echo "02. Update P1 (default) to 20"
echo "=============================="
payload='{
  "P1": {
    "type": "Property",
    "value": 20,
    "observedAt": "2024-01-01T11:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" --verb PATCH
echo
echo


echo "03. GET temporal without datasetId - all instances returned as arrays"
echo "====================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z'
echo
echo


echo "04. GET temporal with datasetId=urn:ds1 - only instances with urn:ds1"
echo "======================================================================"
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&datasetId=urn:ds1'
echo
echo


--REGEXPECT--
01. Create entity E1 with P1 default and P1 with datasetId=urn:ds1
===================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. Update P1 (default) to 20
==============================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. GET temporal without datasetId - all instances returned as arrays
=====================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": [
        {
            "datasetId": "urn:ds1",
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": 100
        },
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T11:00:00Z",
            "type": "Property",
            "value": 20
        },
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": 10
        }
    ],
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


04. GET temporal with datasetId=urn:ds1 - only instances with urn:ds1
======================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": [
        {
            "datasetId": "urn:ds1",
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-01T10:00:00Z",
            "type": "Property",
            "value": 100
        }
    ],
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
