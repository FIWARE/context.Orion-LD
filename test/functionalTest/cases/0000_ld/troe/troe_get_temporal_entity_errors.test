# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Native temporal entity query - error handling for GET /temporal/entities/{entityId}

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental

--SHELL--

#
# 01. GET temporal entity without timerel parameter - expect 400
# 02. GET temporal entity with timerel but without timeAt - expect 400
# 03. GET temporal entity with invalid timerel value - expect 400
# 04. GET temporal entity with timerel=between but no endTimeAt - expect 400
# 05. GET temporal entity for non-existing entity - expect 404
# 06. Create entity E1 with attribute P1
# 07. GET temporal entity for E1 with valid params - expect 200
#

echo "01. GET temporal entity without timerel parameter - expect 400"
echo "============================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timeAt=2024-01-01T00:00:00Z'
echo
echo


echo "02. GET temporal entity with timerel but without timeAt - expect 400"
echo "===================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before'
echo
echo


echo "03. GET temporal entity with invalid timerel value - expect 400"
echo "==============================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=invalid&timeAt=2024-01-01T00:00:00Z'
echo
echo


echo "04. GET temporal entity with timerel=between but no endTimeAt - expect 400"
echo "=========================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=between&timeAt=2024-01-01T00:00:00Z'
echo
echo


echo "05. GET temporal entity for non-existing entity - expect 404"
echo "============================================================"
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E999?timerel=before&timeAt=2099-12-31T23:59:59Z'
echo
echo


echo "06. Create entity E1 with attribute P1"
echo "======================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 42,
    "observedAt": "2024-06-15T12:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "07. GET temporal entity for E1 with valid params - expect 200"
echo "============================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z'
echo
echo


--REGEXPECT--
01. GET temporal entity without timerel parameter - expect 400
=============================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "timerel",
    "title": "Missing required URI parameter 'timerel' when 'timeAt' is present",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


02. GET temporal entity with timerel but without timeAt - expect 400
====================================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "timeAt",
    "title": "Missing required URI parameter 'timeAt' when 'timerel' is present",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


03. GET temporal entity with invalid timerel value - expect 400
===============================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "invalid",
    "title": "Invalid value for URI parameter 'timerel'",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


04. GET temporal entity with timerel=between but no endTimeAt - expect 400
==========================================================================
HTTP/1.1 400 Bad Request
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "endTimeAt",
    "title": "Missing required URI parameter 'endTimeAt' for timerel=between",
    "type": "https://uri.etsi.org/ngsi-ld/errors/BadRequestData"
}


05. GET temporal entity for non-existing entity - expect 404
============================================================
HTTP/1.1 404 Not Found
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "urn:ngsi-ld:entities:E999",
    "title": "Entity Not Found",
    "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}


06. Create entity E1 with attribute P1
=======================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



07. GET temporal entity for E1 with valid params - expect 200
=============================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": [
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-06-15T12:00:00Z",
            "type": "Property",
            "value": 42
        }
    ],
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
