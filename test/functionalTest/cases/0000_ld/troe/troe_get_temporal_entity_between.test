# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Native temporal entity query with timerel=between - GET /temporal/entities/{entityId}

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental

--SHELL--

#
# 01. Create entity E1 with P1=100 and observedAt in January
# 02. Update P1=200 with observedAt in March
# 03. Update P1=300 with observedAt in June
# 04. See all attributes in temporal database
# 05. GET temporal entity with timerel=between covering all entries
#

echo "01. Create entity E1 with P1=100 and observedAt in January"
echo "==========================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 100,
    "observedAt": "2024-01-15T12:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep 1.1


echo "02. Update P1=200 with observedAt in March"
echo "============================================"
payload='{
  "P1": {
    "type": "Property",
    "value": 200,
    "observedAt": "2024-03-15T12:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" --verb PATCH
echo
echo


sleep 1.1


echo "03. Update P1=300 with observedAt in June"
echo "==========================================="
payload='{
  "P1": {
    "type": "Property",
    "value": 300,
    "observedAt": "2024-06-15T12:00:00Z"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" --verb PATCH
echo
echo


echo "04. See all attributes in temporal database"
echo "============================================"
postgresCmd -sql "SELECT opMode,id,valueType,entityId,number,observedAt,ts FROM attributes ORDER BY ts"
echo
echo


echo "05. GET temporal entity with timerel=between covering all entries"
echo "================================================================="
orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=between&timeAt=2020-01-01T00:00:00Z&endTimeAt=2099-12-31T23:59:59Z'
echo
echo


--REGEXPECT--
01. Create entity E1 with P1=100 and observedAt in January
===========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. Update P1=200 with observedAt in March
============================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. Update P1=300 with observedAt in June
===========================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



04. See all attributes in temporal database
============================================
opmode,id,valuetype,entityid,number,observedat,ts
Create,https://uri.etsi.org/ngsi-ld/default-context/P1,Number,urn:ngsi-ld:entities:E1,100,2024-01-15 12:00:00,REGEX(202.*)
Replace,https://uri.etsi.org/ngsi-ld/default-context/P1,Number,urn:ngsi-ld:entities:E1,200,2024-03-15 12:00:00,REGEX(202.*)
Replace,https://uri.etsi.org/ngsi-ld/default-context/P1,Number,urn:ngsi-ld:entities:E1,300,2024-06-15 12:00:00,REGEX(202.*)


05. GET temporal entity with timerel=between covering all entries
=================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "P1": [
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-06-15T12:00:00Z",
            "type": "Property",
            "value": 300
        },
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-03-15T12:00:00Z",
            "type": "Property",
            "value": 200
        },
        {
            "instanceId": "REGEX(.*)",
            "observedAt": "2024-01-15T12:00:00Z",
            "type": "Property",
            "value": 100
        }
    ],
    "id": "urn:ngsi-ld:entities:E1",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
