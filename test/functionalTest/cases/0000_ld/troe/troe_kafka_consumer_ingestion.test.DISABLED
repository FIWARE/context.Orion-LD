# DISABLED: This test requires a running Kafka broker (localhost:9092) and kcat.
# To enable: remove .DISABLED suffix and ensure Kafka is running and kcat is installed.
#
# Install kcat:
#   Ubuntu/Debian: sudo apt-get install kcat
#   macOS:         brew install kcat
#
# Start Kafka in KRaft mode (no Zookeeper needed):
#
#   CLUSTER_ID=$(docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid)
#
#   docker run -d --name kafka -p 9092:9092 \
#     -e KAFKA_NODE_ID=1 \
#     -e KAFKA_PROCESS_ROLES=broker,controller \
#     -e KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093 \
#     -e KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092 \
#     -e KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093 \
#     -e KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \
#     -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 \
#     -e CLUSTER_ID=$CLUSTER_ID \
#     confluentinc/cp-kafka:7.6.0
#
# Create topic (runs inside the Kafka container):
#   docker exec kafka kafka-topics --create --topic orionld-test --bootstrap-server localhost:9092 --partitions 2

# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Kafka consumer ingestion - entity updates via Kafka topic are persisted in MongoDB and TRoE

--SHELL-INIT--
export BROKER=orionld
dbInit CB
pgInit $CB_DB_NAME
brokerStart CB 100 IPv4 -troe -experimental -kafka -kafkaBrokerList localhost:9092 -kafkaTopic orionld-test -kafkaGroupId orionld-functest -kafkaBatchSize 10 -kafkaBatchLingerMs 500

--SHELL--

#
# 01. Produce a single entity message to Kafka topic
# 02. Wait for the consumer to process the batch
# 03. GET the entity from the REST API - verify it exists in MongoDB
# 04. See the entity in the temporal database (TRoE)
# 05. See the attributes in the temporal database
# 06. Produce a batch of 3 entities to Kafka topic
# 07. Wait for processing
# 08. GET all entities of type Sensor - should see K1..K4
# 09. See all entities in the temporal database
#

echo "01. Produce a single entity message to Kafka topic"
echo "==================================================="
echo '{"id":"urn:ngsi-ld:Sensor:K1","type":"Sensor","temperature":{"type":"Property","value":23.5,"observedAt":"2024-06-15T10:00:00Z","unitCode":"CEL"}}' | kcat -P -b localhost:9092 -t orionld-test -k urn:ngsi-ld:Sensor:K1
echo "Message produced"
echo
echo


echo "02. Wait for the consumer to process the batch"
echo "================================================"
sleep 2
echo "Done waiting"
echo
echo


echo "03. GET the entity from the REST API - verify it exists in MongoDB"
echo "=================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Sensor:K1
echo
echo


echo "04. See the entity in the temporal database (TRoE)"
echo "==================================================="
postgresCmd -sql "SELECT opMode,id,type FROM entities WHERE id='urn:ngsi-ld:Sensor:K1'"
echo
echo


echo "05. See the attributes in the temporal database"
echo "================================================"
postgresCmd -sql "SELECT opMode,id,valueType,entityId,number,unitcode,observedAt FROM attributes WHERE entityId='urn:ngsi-ld:Sensor:K1'"
echo
echo


echo "06. Produce a batch of 3 entities to Kafka topic"
echo "================================================="
echo '[{"id":"urn:ngsi-ld:Sensor:K2","type":"Sensor","temperature":{"type":"Property","value":24.1}},{"id":"urn:ngsi-ld:Sensor:K3","type":"Sensor","temperature":{"type":"Property","value":25.7}},{"id":"urn:ngsi-ld:Sensor:K4","type":"Sensor","temperature":{"type":"Property","value":22.3}}]' | kcat -P -b localhost:9092 -t orionld-test -k batch
echo "Batch produced"
echo
echo


echo "07. Wait for processing"
echo "========================"
sleep 2
echo "Done waiting"
echo
echo


echo "08. GET all entities of type Sensor - should see K1..K4"
echo "========================================================"
orionCurl --url '/ngsi-ld/v1/entities?type=Sensor'
echo
echo


echo "09. See all entities in the temporal database"
echo "==============================================="
postgresCmd -sql "SELECT opMode,id,type FROM entities ORDER BY id"
echo
echo


--REGEXPECT--
01. Produce a single entity message to Kafka topic
===================================================
Message produced


02. Wait for the consumer to process the batch
================================================
Done waiting


03. GET the entity from the REST API - verify it exists in MongoDB
==================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "id": "urn:ngsi-ld:Sensor:K1",
    "temperature": {
        "observedAt": "2024-06-15T10:00:00.000Z",
        "type": "Property",
        "unitCode": "CEL",
        "value": 23.5
    },
    "type": "Sensor"
}



04. See the entity in the temporal database (TRoE)
===================================================
opmode,id,type
REGEX(.*),urn:ngsi-ld:Sensor:K1,https://uri.etsi.org/ngsi-ld/default-context/Sensor



05. See the attributes in the temporal database
================================================
opmode,id,valuetype,entityid,number,unitcode,observedat
REGEX(.*),https://uri.etsi.org/ngsi-ld/default-context/temperature,Number,urn:ngsi-ld:Sensor:K1,23.5,CEL,2024-06-15 10:00:00



06. Produce a batch of 3 entities to Kafka topic
=================================================
Batch produced


07. Wait for processing
========================
Done waiting


08. GET all entities of type Sensor - should see K1..K4
========================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

REGEX(.*)


09. See all entities in the temporal database
===============================================
opmode,id,type
REGEX(.*),urn:ngsi-ld:Sensor:K1,https://uri.etsi.org/ngsi-ld/default-context/Sensor
REGEX(.*),urn:ngsi-ld:Sensor:K2,https://uri.etsi.org/ngsi-ld/default-context/Sensor
REGEX(.*),urn:ngsi-ld:Sensor:K3,https://uri.etsi.org/ngsi-ld/default-context/Sensor
REGEX(.*),urn:ngsi-ld:Sensor:K4,https://uri.etsi.org/ngsi-ld/default-context/Sensor



--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
