# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
PUT Entity and TRoE with large String

--SHELL-INIT--
dbInit CB
pgInit $CB_DB_NAME
orionldStart CB -troe 

--SHELL--

# 01. Create an entity E1 with attr S1

echo "01. Create an entity E1 with attr S1"
echo "============================================"
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "S1": {
    "type": "Property",
    "value": ""
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo

echo "02. See the string-attribute in the temporal database"
echo "==================================================="
postgresCmd -sql "SELECT opmode,id,valueType,entityId,ts FROM attributes"
echo
echo
--REGEXPECT--
01. Create an entity E1 with attr S1
============================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. See the string-attribute in the temporal database
===================================================
opmode,id,valuetype,entityid,ts
Create,https://uri.etsi.org/ngsi-ld/default-context/S1,String,urn:ngsi-ld:entities:E1,REGEX(202.*)


--TEARDOWN--
brokerStop CB
dbDrop CB
pgDrop $CB_DB_NAME
