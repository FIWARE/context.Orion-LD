# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Batch Upsert of an entity whose stored _id has no type

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--

#
# entityLookupBy_id_Id() only hands the caller a type node if the stored '_id' actually has a
# 'type' - it warns about the "Database Error?" case and leaves the pointer untouched otherwise.
# batchEntitiesFinalCheck() read that pointer's value regardless, to compare the stored type
# against the incoming one, and a typeless entity in the database therefore killed the broker on
# every batch write touching that id.
#
# Such entities do occur: an empty entity id lets unrelated entities collapse onto the same '_id'.
#
# 01. Insert an entity whose _id has an id but no type, straight into mongo
# 02. Batch upsert that entity - no stored type to compare against, so no alteration check
# 03. The broker is still there - create an ordinary entity
#

echo "01. Insert an entity whose _id has an id but no type, straight into mongo"
echo "========================================================================="
mongoCmd2 ftest 'db.entities.insert({ _id: { id: "urn:ngsi-ld:E1", servicePath: "/" }, attrNames: [], attrs: {}, creDate: 1, modDate: 1 })'
echo
echo


echo "02. Batch upsert that entity - no stored type to compare against, so no alteration check"
echo "========================================================================================"
payload='[
  {
    "id": "urn:ngsi-ld:E1",
    "type": "T",
    "P1": {
      "type": "Property",
      "value": 1
    }
  }
]'
orionCurl --url '/ngsi-ld/v1/entityOperations/upsert?options=update' --payload "$payload"
echo
echo


echo "03. The broker is still there - create an ordinary entity"
echo "========================================================="
payload='{
  "id": "urn:ngsi-ld:E2",
  "type": "T"
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


--REGEXPECT--
01. Insert an entity whose _id has an id but no type, straight into mongo
=========================================================================
MongoDB shell version REGEX(.*)
connecting to: mongodb:REGEX(.*)
MongoDB server version: REGEX(.*)
WriteResult({ "nInserted" : 1 })
bye


02. Batch upsert that entity - no stored type to compare against, so no alteration check
========================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



03. The broker is still there - create an ordinary entity
=========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E2



--TEARDOWN--
brokerStop CB
dbDrop CB
