# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Prometheus metrics on dedicated port (8000)

--SHELL-INIT--
dbInit CB
orionldStart CB -promPort 8000

--SHELL--

#
# 01. Create an entity to trigger ngsildRequests counter
# 02. Query entities to trigger another request
# 03. Query a non-existing entity to trigger ngsildRequestsFailed counter
# 04. GET /metrics on port 8000 and verify counters are present
#

echo "01. Create an entity to trigger ngsildRequests counter"
echo "======================================================"
payload='{
  "id": "urn:ngsi-ld:T:001",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 1
  }
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "02. Query entities to trigger another request"
echo "=============================================="
orionCurl --url /ngsi-ld/v1/entities?type=T
echo
echo


echo "03. Query a non-existing entity to trigger ngsildRequestsFailed counter"
echo "========================================================================"
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:T:doesnotexist
echo
echo


echo "04. GET /metrics on port 8000 and verify counters are present"
echo "=============================================================="
orionCurl --url /metrics --port 8000  --noPayloadCheck # | grep -E "^(ngsild|notifications|distOps|connections|subscriptions|request)"
echo
echo


--REGEXPECT--
01. Create an entity to trigger ngsildRequests counter
======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:T:001



02. Query entities to trigger another request
==============================================
HTTP/1.1 200 OK
Content-Length: 74
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "P1": {
            "type": "Property",
            "value": 1
        },
        "id": "urn:ngsi-ld:T:001",
        "type": "T"
    }
]


03. Query a non-existing entity to trigger ngsildRequestsFailed counter
========================================================================
HTTP/1.1 404 Not Found
Content-Length: 128
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "urn:ngsi-ld:T:doesnotexist",
    "title": "Entity Not Found",
    "type": "https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound"
}


04. GET /metrics on port 8000 and verify counters are present
==============================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: text/plain; REGEX(.*)
Date: REGEX(.*)

# HELP ngsildRequests NGSILD Requests
# TYPE ngsildRequests counter
ngsildRequests 3
# HELP ngsildRequestsFailed Failed NGSILD Requests
# TYPE ngsildRequestsFailed counter
ngsildRequestsFailed 1
# HELP notifications Notifications
# TYPE notifications counter
notifications 0
# HELP notificationsFailed Failed Notifications
# TYPE notificationsFailed counter
notificationsFailed 0
# HELP distOps Forwarded Distributed Operations
# TYPE distOps counter
distOps 0
# HELP distOpsFailed Failed Distributed Operations
# TYPE distOpsFailed counter
distOpsFailed 0
# HELP connectionsActive Active HTTP connections
# TYPE connectionsActive gauge
connectionsActive 0
# HELP subscriptionsCached Subscriptions in cache
# TYPE subscriptionsCached gauge
subscriptionsCached 0
# HELP requestDurationSeconds Request duration in seconds
# TYPE requestDurationSeconds histogram
requestDurationSeconds_bucket{le="0.001"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.002"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.003"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.004"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.005"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.010"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.025"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.050"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.100"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.250"} REGEX(\d+)
requestDurationSeconds_bucket{le="0.500"} REGEX(\d+)
requestDurationSeconds_bucket{le="1"} REGEX(\d+)
requestDurationSeconds_bucket{le="5"} REGEX(\d+)
requestDurationSeconds_bucket{le="10"} REGEX(\d+)
requestDurationSeconds_bucket{le="+Inf"} REGEX(\d+)
requestDurationSeconds_sum 0.00REGEX(\d)
requestDurationSeconds_count 3



--TEARDOWN--
brokerStop CB
dbDrop CB
