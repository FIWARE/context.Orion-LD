    },
    {
      "type": "T2"
    },
    {
      "idPattern": ".*E3.*",
      "type": "T3"
    }
  ],
  "watchedAttributes": [
    "P1",
    "P2"
  ],
  "datasetId": [
    "urn:ngsi-ld:dataset:1"
  ],
  "q": "P1>10",
  "geoQ": {
    "geometry": "Point",
    "georel": "near;maxDistance==100",
    "coordinates": [
      1,
      2
    ],
    "geoproperty": "location"
  },
  "status": "active",
  "isActive": true,
  "notification": {
    "attributes": [
      "P1",
      "P2"
    ],
    "format": "keyValues",
    "endpoint": {
      "uri": "http://valid.url/url",
      "accept": "application/json",
      "receiverInfo": [
        {
          "key": "H1",
          "value": "V1"
        }
      ]
    },
    "status": "ok"
  },
  "expiresAt": "2050-12-31T10:00:00.000Z",
  "throttling": 5,
  "lang": "en",
  "origin": "cache",
  "jsonldContext": "https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld"
}



