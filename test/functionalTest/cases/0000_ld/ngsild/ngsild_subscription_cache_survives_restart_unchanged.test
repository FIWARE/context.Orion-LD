# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
A cached Subscription renders identically before and after a broker restart

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly

--SHELL--

#
# A Subscription reaches the subscription cache by two very different roads:
# straight from the POST payload, and - after a restart - from the database, via
# dbModelToApiSubscription. GET renders the cached tree, so the two roads must end
# in the SAME tree: whatever a GET answers, it must answer again after a restart.
#
# That makes this an oracle for the shape of the cached subscription. Every member
# below is one that the two roads used to disagree about: 'type' and 'jsonldContext'
# (added by the database road only), an 'idPattern' of ".*", a 'showChanges' and a
# 'sysAttrs' of false (dropped by the database road only), a 'datasetId' given as a
# String (turned into an Array by the database road only), plus the aliases, which
# are resolved against the @context of the GET, not of the POST.
#
# The GETs ask for prettyPrint, so the member ORDER is compared too - a sorted
# rendering would hide a reordering.
#
# 01. Create subscription S1, with every member that has two spellings
# 02. GET S1 - rendered from the cache the POST filled
# 03. PATCH S1 - the cache item is rebuilt, in place
# 04. GET S1 - rendered from the cache the PATCH updated
# 05. GET /subscriptions - the same subscription, from the list route
# 06. Restart the broker - the cache is now filled from the database
# 07. GET S1 - MUST be identical to step 04
# 08. GET /subscriptions - MUST be identical to step 05
#

echo "01. Create subscription S1, with every member that has two spellings"
echo "===================================================================="
payload='{
  "id": "urn:ngsi-ld:subscriptions:S1",
  "type": "Subscription",
  "subscriptionName": "S1",
  "description": "Subscription with all the two-spelling members",
  "entities": [
    {
      "id": "urn:ngsi-ld:E1",
      "type": "T1"
    },
    {
      "idPattern": ".*",
      "type": "T2"
    },
    {
      "idPattern": ".*E3.*",
      "type": "T3"
    }
  ],
  "watchedAttributes": [ "P1", "P2" ],
  "datasetId": "urn:ngsi-ld:dataset:1",
  "q": "P1>10",
  "geoQ": {
    "geometry": "Point",
    "coordinates": [1,2],
    "georel": "near;maxDistance==100",
    "geoproperty": "location"
  },
  "isActive": true,
  "lang": "en",
  "notification": {
    "attributes": [ "P1", "P2" ],
    "format": "keyValues",
    "showChanges": false,
    "sysAttrs": false,
    "endpoint": {
      "uri": "http://valid.url/url",
      "accept": "application/json",
      "receiverInfo": [ { "key": "H1", "value": "V1" } ]
    }
  },
  "expiresAt": "2050-12-31T10:00:00Z",
  "throttling": 5
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload" -H 'Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "02. GET S1 - rendered from the cache the POST filled"
echo "==================================================="
orionCurl --url '/ngsi-ld/v1/subscriptions/urn:ngsi-ld:subscriptions:S1?prettyPrint=yes&spaces=2' --noPayloadCheck -H 'Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "03. PATCH S1 - the cache item is rebuilt, in place"
echo "================================================="
payload='{
  "subscriptionName": "S1 - patched",
  "geoQ": {
    "geometry": "Point",
    "coordinates": [3,4],
    "georel": "near;maxDistance==200",
    "geoproperty": "location"
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions/urn:ngsi-ld:subscriptions:S1 -X PATCH --payload "$payload" -H 'Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "04. GET S1 - rendered from the cache the PATCH updated"
echo "====================================================="
orionCurl --url '/ngsi-ld/v1/subscriptions/urn:ngsi-ld:subscriptions:S1?prettyPrint=yes&spaces=2' --noPayloadCheck -H 'Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "05. GET /subscriptions - the same subscription, from the list route"
echo "=================================================================="
orionCurl --url '/ngsi-ld/v1/subscriptions?prettyPrint=yes&spaces=2' --noPayloadCheck -H 'Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "06. Restart the broker - the cache is now filled from the database"
echo "================================================================="
brokerStop CB
orionldStart CB -mongocOnly
echo
echo


echo "07. GET S1 - MUST be identical to step 04"
echo "========================================"
orionCurl --url '/ngsi-ld/v1/subscriptions/urn:ngsi-ld:subscriptions:S1?prettyPrint=yes&spaces=2' --noPayloadCheck -H 'Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "08. GET /subscriptions - MUST be identical to step 05"
echo "===================================================="
orionCurl --url '/ngsi-ld/v1/subscriptions?prettyPrint=yes&spaces=2' --noPayloadCheck -H 'Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


--REGEXPECT--
01. Create subscription S1, with every member that has two spellings
====================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:subscriptions:S1



02. GET S1 - rendered from the cache the POST filled
===================================================
HTTP/1.1 200 OK
Content-Length: 1163
Content-Type: application/json
Date: REGEX(.*)
Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"

{
  "id": "urn:ngsi-ld:subscriptions:S1",
  "type": "Subscription",
  "subscriptionName": "S1",
  "description": "Subscription with all the two-spelling members",
  "entities": [
    {
      "id": "urn:ngsi-ld:E1",
