# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Bug about PATCH Entity2 not rrmoving 'observedAt' from 'mdNames'

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--
#
# 01. Create an entity E1 with an attr P1 having observedAt and unitCode as MDs
# 01b. See E1 in DB - observe observedAt and unitCode in mdNames
# 02. Patch E1, removing P1:observedAt
# 02b. See E1 in DB - make sure P1:observedAt is gone from 'mdNames'
#

echo "01. Create an entity E1 with an attr P1 having observedAt and unitCode as MDs"
echo "============================================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "P1": {
    "type": "Property",
    "value": 1,
    "observedAt": "2022-02-24T17:45:00.001Z",
    "unitCode": "step1"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "01b. See E1 in DB - observe observedAt and unitCode in mdNames"
echo "=============================================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "02. Patch E1, removing P1:observedAt"
echo "===================================="
payload='{
  "P1": {
    "value": 2,
    "observedAt": "urn:ngsi-ld:null",
    "unitCode": "step2"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1 -X PATCH --payload "$payload"
echo
echo


echo "02b. See E1 in DB - make sure P1:observedAt is gone from 'mdNames'"
echo "=================================================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


--REGEXPECT--
01. Create an entity E1 with an attr P1 having observedAt and unitCode as MDs
=============================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



01b. See E1 in DB - observe observedAt and unitCode in mdNames
==============================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
{
	"_id" : {
		"id" : "urn:E1",
		"type" : "https://uri.etsi.org/ngsi-ld/default-context/T",
		"servicePath" : "/"
	},
	"attrNames" : [
		"https://uri.etsi.org/ngsi-ld/default-context/P1"
	],
	"attrs" : {
		"https://uri=etsi=org/ngsi-ld/default-context/P1" : {
			"type" : "Property",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : 1,
			"mdNames" : [
				"observedAt",
				"unitCode"
			],
			"md" : {
				"observedAt" : {
					"value" : 1645724700.001
				},
				"unitCode" : {
					"value" : "step1"
				}
			}
		}
	},
	"creDate" : REGEX(.*),
	"modDate" : REGEX(.*),
	"lastCorrelator" : ""
}
bye


02. Patch E1, removing P1:observedAt
====================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



02b. See E1 in DB - make sure P1:observedAt is gone from 'mdNames'
==================================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
{
	"_id" : {
		"id" : "urn:E1",
		"type" : "https://uri.etsi.org/ngsi-ld/default-context/T",
		"servicePath" : "/"
	},
	"attrNames" : [
		"https://uri.etsi.org/ngsi-ld/default-context/P1"
	],
	"attrs" : {
		"https://uri=etsi=org/ngsi-ld/default-context/P1" : {
			"type" : "Property",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : 2,
			"mdNames" : [
				"unitCode"
			],
			"md" : {
				"unitCode" : {
					"value" : "step2"
				}
			}
		}
	},
	"creDate" : REGEX(.*),
	"modDate" : REGEX(.*),
	"lastCorrelator" : ""
}
bye


--TEARDOWN--
brokerStop CB
dbDrop CB
