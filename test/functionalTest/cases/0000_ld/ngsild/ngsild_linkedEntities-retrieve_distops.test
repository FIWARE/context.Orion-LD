# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Distributed Linked Entity Retrieval 

--SHELL-INIT--
dbInit CB
dbInit CP1
orionldStart CB  -mongocOnly -forwarding -wip entityMaps -t 0-255
orionldStart CP1 -mongocOnly -t 0-255

--SHELL--

#
# 01. Create an entity urn:E1 with 3 relationships, R2, R3, and R4 (referencing entities urn:E2, urn:E3, and urn:E4)
# 02. Create a registration in CB, pointing to CP1 for the entities urn:E2, urn:E3, and urn:E4
# 03. Create those 3 entities (urn:E2, urn:E3, and urn:E4) in CP1
# 04. Retrieve the entity urn:E1 with ?join=flat
# 05. Retrieve the entity urn:E1 with ?join=inline
# 06. Create an entity urn:E5, with a relationship R1 referencing urn:E6
# 07. Create an entity urn:E6
# 08. PATCH urn:E1, adding a relationship R5, referencing urn:E5
# 10. Retrieve the entity urn:E1 with ?join=flat and joinLevel=2
# 11. Retrieve the entity urn:E1 with ?join=flat (joinLevel == 1 by default) with local=true - see only urn:E1
#

echo "01. Create an entity urn:E1 with 3 relationships, R2, R3, and R4 (referencing entities urn:E2, urn:E3, and urn:E4)"
echo "=================================================================================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "P1": 1,
  "R1": {
    "object": "urn:E2"
  },
  "R2": {
    "object": "urn:E3"
  },
  "R3": {
    "object": "urn:E4"
  },
  "R0": {
    "object": "urn:E1"
 }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. Create a registration in CB, pointing to CP1 for the entities urn:E2, urn:E3, and urn:E4"
echo "============================================================================================"
payload='{
  "id": "urn:R1",
  "type": "ContextSourceRegistration",
  "information": [
    {
      "entities": [
        {
          "type": "T"
        }
      ]
    }
  ],
  "endpoint": "http://'$(hostname)':'$CP1_PORT'"
}'
orionCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "03. Create those 3 entities (urn:E2, urn:E3, and urn:E4) in CP1"
echo "==============================================================="
payload='{
  "id": "urn:E2",
  "type": "T",
  "P1": 2
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload" --port $CP1_PORT
echo

payload='{
  "id": "urn:E3",
  "type": "T",
  "P1": 3
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload" --port $CP1_PORT
echo

payload='{
  "id": "urn:E4",
  "type": "T",
  "P1": 4
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload" --port $CP1_PORT
echo
echo


echo "03b. Get all entities from CP1"
echo "=============================="
orionCurl --url /ngsi-ld/v1/entities?local=true --port $CP1_PORT
echo
echo


echo "04. Retrieve the entity urn:E1 with ?join=flat"
echo "=============================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1?join=flat
echo
echo


echo "05. Retrieve the entity urn:E1 with ?join=inline"
echo "==============================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1?join=inline
echo
echo


echo "06. Create an entity urn:E5, with a relationship R1 referencing urn:E6"
echo "======================================================================"
payload='{
  "id": "urn:E5",
  "type": "T",
  "R1": {
    "object": "urn:E6"
  }
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "07. Create an entity urn:E6"
echo "==========================="
payload='{
  "id": "urn:E6",
  "type": "T",
  "P1": 6
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "08. PATCH urn:E1, adding a relationship R5, referencing urn:E5"
echo "=============================================================="
payload='{
  "R5": {
    "object": "urn:E5"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1 -X PATCH --payload "$payload"
echo
echo


echo "09. Retrieve the entity urn:E1 with ?join=flat (joinLevel == 1 by default)"
echo "=========================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1?join=flat
echo
echo


echo "10. Retrieve the entity urn:E1 with ?join=flat and joinLevel=2"
echo "=============================================================="
orionCurl --url '/ngsi-ld/v1/entities/urn:E1?join=flat&joinLevel=2'
echo
echo


echo "11. Retrieve the entity urn:E1 with ?join=flat (joinLevel == 1 by default) with local=true - see only urn:E1"
echo "============================================================================================================"
orionCurl --url '/ngsi-ld/v1/entities/urn:E1?join=flat&local=true'
echo
echo


--REGEXPECT--
01. Create an entity urn:E1 with 3 relationships, R2, R3, and R4 (referencing entities urn:E2, urn:E3, and urn:E4)
==================================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



02. Create a registration in CB, pointing to CP1 for the entities urn:E2, urn:E3, and urn:E4
============================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/urn:R1



03. Create those 3 entities (urn:E2, urn:E3, and urn:E4) in CP1
===============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E2


HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E3


HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E4



