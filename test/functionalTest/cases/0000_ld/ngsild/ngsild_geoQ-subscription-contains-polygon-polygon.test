# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ contains Polygon - entity polygon must contain subscription polygon

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "contains" and a small polygon in central Spain.
# Only entities whose polygon CONTAINS the subscription polygon should trigger notifications.
#
# Subscription polygon (lon, lat):
#   (-5, 39), (-3, 39), (-3, 41), (-5, 41), (-5, 39)
#
# 01. Create subscription S1 with geoQ contains Polygon
# 02. Create entity E1 with polygon covering all Iberia - MATCH (contains sub polygon)
# 03. Create entity E2 with polygon in France - NO MATCH
# 04. Create entity E3 with polygon covering western Spain - MATCH (contains sub polygon)
# 05. Dump ftClient - see 2 notifications: E1 and E3
#


echo "01. Create subscription S1 with geoQ contains Polygon"
echo "======================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Region"
    }
  ],
  "geoQ": {
    "georel": "contains",
    "geometry": "Polygon",
    "coordinates": [[[-5, 39], [-3, 39], [-3, 41], [-5, 41], [-5, 39]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with polygon covering all Iberia - MATCH"
echo "============================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E1",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Iberian Peninsula"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with polygon in France - NO MATCH"
echo "======================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E2",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "France"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[0, 45], [4, 45], [4, 49], [0, 49], [0, 45]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with polygon covering western Spain - MATCH"
echo "================================================================"
payload='{
  "id": "urn:ngsi-ld:Region:E3",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Western Spain"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-6, 38], [-2, 38], [-2, 42], [-6, 42], [-6, 38]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "05. Dump ftClient - see 2 notifications: E1 and E3"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ contains Polygon
======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with polygon covering all Iberia - MATCH
=============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E1



03. Create entity E2 with polygon in France - NO MATCH
=======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E2



04. Create entity E3 with polygon covering western Spain - MATCH
================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E3



05. Dump ftClient - see 2 notifications: E1 and E3
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Region:E1",
      "type": "Region",
      "name": {
        "type": "Property",
        "value": "Iberian Peninsula"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -10,
                36
              ],
              [
                4,
                36
              ],
              [
                4,
                44
              ],
              [
                -10,
                44
              ],
              [
                -10,
                36
              ]
            ]
          ]
        }
      }
    }
  ]
}
================================================================================

