Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Region:E3",
      "type": "Region",
      "name": {
        "type": "Property",
        "value": "Western Spain"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -6,
                38
              ],
              [
                -2,
                38
              ],
              [
                -2,
                42
              ],
              [
                -6,
