# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ within Polygon - entity location is also a Polygon

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "within" a polygon covering the Iberian Peninsula (rough bounding box).
# Entity locations are Polygons, not Points.
# "within" means the entity polygon must be entirely contained in the subscription polygon.
#
# Subscription polygon vertices (lon, lat):
#   (-10, 36), (4, 36), (4, 44), (-10, 44), (-10, 36)
#
# E1: Central Spain    - fully inside        -> notification expected
# E2: France           - fully outside       -> no notification
# E3: Pyrenees         - partially overlapping -> no notification
# E4: Southern Portugal - fully inside        -> notification expected
#
# 01. Create subscription S1 with geoQ within Polygon (Iberian Peninsula box)
# 02. Create entity E1 with Polygon fully inside (Central Spain) - notification expected
# 03. Create entity E2 with Polygon fully outside (France) - no notification
# 04. Create entity E3 with Polygon partially overlapping (Pyrenees) - no notification
# 05. Create entity E4 with Polygon fully inside (Southern Portugal) - notification expected
# 06. Dump ftClient - see 2 notifications: E1 and E4
#


echo "01. Create subscription S1 with geoQ within Polygon (Iberian Peninsula box)"
echo "==========================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Region"
    }
  ],
  "geoQ": {
    "georel": "within",
    "geometry": "Polygon",
    "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with Polygon fully inside (Central Spain) - notification expected"
echo "======================================================================================"
payload='{
  "id": "urn:ngsi-ld:Region:E1",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Central Spain"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-5, 39], [-2, 39], [-2, 42], [-5, 42], [-5, 39]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with Polygon fully outside (France) - no notification"
echo "==========================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E2",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "France"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[0, 45], [4, 45], [4, 49], [0, 49], [0, 45]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with Polygon partially overlapping (Pyrenees) - no notification"
echo "====================================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E3",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Pyrenees"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[2, 40], [6, 40], [6, 46], [2, 46], [2, 40]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Create entity E4 with Polygon fully inside (Southern Portugal) - notification expected"
echo "=========================================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E4",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Southern Portugal"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-9, 37], [-7, 37], [-7, 40], [-9, 40], [-9, 37]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "06. Dump ftClient - see 2 notifications: E1 and E4"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ within Polygon (Iberian Peninsula box)
===========================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with Polygon fully inside (Central Spain) - notification expected
======================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E1



03. Create entity E2 with Polygon fully outside (France) - no notification
===========================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E2



04. Create entity E3 with Polygon partially overlapping (Pyrenees) - no notification
=====================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E3



05. Create entity E4 with Polygon fully inside (Southern Portugal) - notification expected
==========================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E4



06. Dump ftClient - see 2 notifications: E1 and E4
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Region:E1",
      "type": "Region",
      "name": {
        "type": "Property",
        "value": "Central Spain"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -5,
                39
              ],
              [
                -2,
                39
              ],
              [
                -2,
                42
              ],
              [
                -5,
                42
              ],
              [
                -5,
                39
              ]
            ]
          ]
        }
      }
    }
  ]
}
================================================================================

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Region:E4",
      "type": "Region",
      "name": {
        "type": "Property",
        "value": "Southern Portugal"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -9,
                37
              ],
              [
                -7,
                37
              ],
              [
                -7,
                40
              ],
