# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ disjoint Polygon-Polygon - entity polygon must not touch subscription polygon

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "disjoint" from a polygon covering the Iberian Peninsula.
# Only entities whose polygon does NOT touch/overlap the subscription polygon should trigger notifications.
#
# Subscription polygon (lon, lat):
#   (-10, 36), (4, 36), (4, 44), (-10, 44), (-10, 36)
#
# 01. Create subscription S1 with geoQ disjoint Polygon
# 02. Create entity E1 with polygon inside Iberia - NO MATCH (not disjoint)
# 03. Create entity E2 with polygon in Scandinavia - MATCH (disjoint)
# 04. Create entity E3 with polygon overlapping boundary - NO MATCH (not disjoint)
# 05. Create entity E4 with polygon in North Africa - MATCH (disjoint)
# 06. Dump ftClient - see 2 notifications: E2 and E4
#


echo "01. Create subscription S1 with geoQ disjoint Polygon"
echo "======================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Region"
    }
  ],
  "geoQ": {
    "georel": "disjoint",
    "geometry": "Polygon",
    "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with polygon inside Iberia - NO MATCH"
echo "=========================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E1",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Central Spain"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-5, 39], [-3, 39], [-3, 41], [-5, 41], [-5, 39]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with polygon in Scandinavia - MATCH"
echo "========================================================"
payload='{
  "id": "urn:ngsi-ld:Region:E2",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Scandinavia"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[10, 55], [20, 55], [20, 65], [10, 65], [10, 55]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with polygon overlapping boundary - NO MATCH"
echo "================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E3",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Pyrenees-France"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[2, 40], [6, 40], [6, 46], [2, 46], [2, 40]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Create entity E4 with polygon in North Africa - MATCH"
echo "========================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E4",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "North Africa"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-5, 30], [5, 30], [5, 35], [-5, 35], [-5, 30]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "06. Dump ftClient - see 2 notifications: E2 and E4"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ disjoint Polygon
======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with polygon inside Iberia - NO MATCH
==========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E1



03. Create entity E2 with polygon in Scandinavia - MATCH
========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E2



04. Create entity E3 with polygon overlapping boundary - NO MATCH
=================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E3



05. Create entity E4 with polygon in North Africa - MATCH
=========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E4



06. Dump ftClient - see 2 notifications: E2 and E4
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Region:E2",
      "type": "Region",
      "name": {
        "type": "Property",
        "value": "Scandinavia"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                10,
                55
              ],
              [
                20,
                55
              ],
              [
                20,
                65
              ],
              [
                10,
                65
              ],
              [
                10,
                55
              ]
            ]
          ]
        }
      }
    }
  ]
}
================================================================================

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Region:E4",
      "type": "Region",
      "name": {
        "type": "Property",
        "value": "North Africa"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                -5,
                30
              ],
              [
                5,
                30
              ],
              [
                5,
                35
              ],
              [
                -5,
