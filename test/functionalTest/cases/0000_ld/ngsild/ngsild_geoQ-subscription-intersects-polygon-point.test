# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ intersects Polygon - entity with Point location

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "intersects" a polygon covering the Iberian Peninsula (rough bounding box).
# "intersects" means the entity geometry touches or is inside the subscription polygon.
#
# Polygon vertices (lon, lat):
#   (-10, 36), (4, 36), (4, 44), (-10, 44), (-10, 36)
#
# Points inside:
#   Madrid:     lon=-3.691944, lat=40.418889
#   Lisbon:     lon=-9.139337, lat=38.722252
#
# Points outside:
#   Paris:      lon=2.352222,  lat=48.856614
#
# 01. Create subscription S1 with geoQ intersects Polygon (Iberian Peninsula box)
# 02. Create entity E1 at Madrid (inside polygon) - notification expected
# 03. Create entity E2 at Paris (outside polygon) - no notification
# 04. Create entity E3 at Lisbon (inside polygon) - notification expected
# 05. Dump ftClient - see 2 notifications: E1 and E3
#


echo "01. Create subscription S1 with geoQ intersects Polygon (Iberian Peninsula box)"
echo "================================================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "City"
    }
  ],
  "geoQ": {
    "georel": "intersects",
    "geometry": "Polygon",
    "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 at Madrid (inside polygon) - notification expected"
echo "========================================================================"
payload='{
  "id": "urn:ngsi-ld:City:E1",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Madrid"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-3.691944, 40.418889]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 at Paris (outside polygon) - no notification"
echo "=================================================================="
payload='{
  "id": "urn:ngsi-ld:City:E2",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Paris"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.352222, 48.856614]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 at Lisbon (inside polygon) - notification expected"
echo "========================================================================"
payload='{
  "id": "urn:ngsi-ld:City:E3",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Lisbon"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-9.139337, 38.722252]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "05. Dump ftClient - see 2 notifications: E1 and E3"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ intersects Polygon (Iberian Peninsula box)
================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 at Madrid (inside polygon) - notification expected
========================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E1



03. Create entity E2 at Paris (outside polygon) - no notification
==================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E2



04. Create entity E3 at Lisbon (inside polygon) - notification expected
========================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E3



05. Dump ftClient - see 2 notifications: E1 and E3
===================================================
HTTP/1.1 200 OK
