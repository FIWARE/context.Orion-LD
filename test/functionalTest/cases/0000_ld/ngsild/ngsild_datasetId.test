# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Very simple test of datasetId support for ALL concerned endpoints

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly

--SHELL--

#
# 01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default
# 02. GET the entity, without datasetId - see all instances
# 03. GET all entities, without datasetId - see all instances
# 04. GET the entity, with datasetId urn:ngsi-ld:dataset:D1 - see ONE instance of A1
# 05. GET all entities, with datasetId urn:ngsi-ld:dataset:D1 - see ONE instance of A1
# 06. GET the entity, with datasetId list urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2 - see two instances of A1
# 07. GET all entities, with datasetId list urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2 - see two instances of A1
# 08. GET the entity, with datasetId @none - see only default value of A1
# 09. GET all entities, with datasetId @none - see only default value of A1
# 10. POST Query all entities, without datasetId - see all instances
# 11. POST Query all entities, with datasetId urn:ngsi-ld:dataset:D1 - see ONE instance of A1
# 12. POST Query all entities, with datasetId list urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2 - see two instances of A1
# 13. POST Query all entities, with datasetId @none - see only default value of A1
#

echo "01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default"
echo "======================================================================================================"
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "A1": [
    {
      "type": "Property",
      "value": "A1:Default"
    },
    {
      "type": "Property",
      "value": "A1:D1",
      "datasetId": "urn:ngsi-ld:dataset:D1"
    },
    {
      "type": "Property",
      "value": "A1:D2",
      "datasetId": "urn:ngsi-ld:dataset:D2"
    },
    {
      "type": "Property",
      "value": "A1:D3",
      "datasetId": "urn:ngsi-ld:dataset:D3"
    }
  ]
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "01b. See the entity in mongo"
echo "============================"
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "02. GET the entity, without datasetId - see all instances"
echo "========================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1
echo
echo


echo "03. GET all entities, without datasetId - see all instances"
echo "==========================================================="
orionCurl --url /ngsi-ld/v1/entities?local=true
echo
echo


echo "04. GET the entity, with datasetId urn:ngsi-ld:dataset:D1 - see ONE instance of A1"
echo "=================================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1?datasetId=urn:ngsi-ld:dataset:D1
echo
echo


echo "05. GET all entities, with datasetId urn:ngsi-ld:dataset:D1 - see ONE instance of A1"
echo "===================================================================================="
orionCurl --url '/ngsi-ld/v1/entities?local=true&datasetId=urn:ngsi-ld:dataset:D1'
echo
echo


echo "06. GET the entity, with datasetId list urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2 - see two instances of A1"
echo "==============================================================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1?datasetId=urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2
echo
echo


echo "07. GET all entities, with datasetId list urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2 - see two instances of A1"
echo "================================================================================================================="
orionCurl --url '/ngsi-ld/v1/entities?local=true&datasetId=urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2'
echo
echo


echo "08. GET the entity, with datasetId @none - see only default value of A1"
echo "======================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1?datasetId=@none
echo
echo


echo "09. GET all entities, with datasetId @none - see only default value of A1"
echo "========================================================================="
orionCurl --url '/ngsi-ld/v1/entities?local=true&datasetId=@none'
echo
echo


echo "10. POST Query all entities, without datasetId - see all instances"
echo "=================================================================="
payload='{
  "type": "Query",
  "local": true
}'
orionCurl --url '/ngsi-ld/v1/entityOperations/query?prettyPrint=yes' --payload "$payload" --noPayloadCheck
echo
echo


echo "11. POST Query all entities, with datasetId urn:ngsi-ld:dataset:D1 - see ONE instance of A1"
echo "==========================================================================================="
payload='{
  "type": "Query",
  "local": true,
  "datasetId": [ "urn:ngsi-ld:dataset:D1" ]
}'
orionCurl --url '/ngsi-ld/v1/entityOperations/query?prettyPrint=yes' --payload "$payload" --noPayloadCheck
echo
echo


echo "12. POST Query all entities, with datasetId list urn:ngsi-ld:dataset:D1,urn:ngsi-ld:dataset:D2 - see two instances of A1"
echo "========================================================================================================================"
payload='{
  "type": "Query",
  "local": true,
  "datasetId": [ "urn:ngsi-ld:dataset:D1", "urn:ngsi-ld:dataset:D2" ]
}'
orionCurl --url '/ngsi-ld/v1/entityOperations/query?prettyPrint=yes' --payload "$payload" --noPayloadCheck
echo
echo


echo "13. POST Query all entities, with datasetId @none - see only default value of A1"
echo "================================================================================"
payload='{
  "type": "Query",
  "local": true,
  "datasetId": [ "@none" ]
}'
orionCurl --url '/ngsi-ld/v1/entityOperations/query?prettyPrint=yes' --payload "$payload" --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default
======================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



01b. See the entity in mongo
============================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
{
	"_id" : {
		"id" : "urn:ngsi-ld:entities:E1",
		"type" : "https://uri.etsi.org/ngsi-ld/default-context/T",
		"servicePath" : "/"
	},
	"attrNames" : [
		"https://uri.etsi.org/ngsi-ld/default-context/A1"
	],
	"attrs" : {
		"https://uri=etsi=org/ngsi-ld/default-context/A1" : {
			"type" : "Property",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : "A1:Default",
			"mdNames" : [ ]
		}
	},
	"creDate" : REGEX(.*),
	"modDate" : REGEX(.*),
	"lastCorrelator" : "",
	"@datasets" : {
		"https://uri=etsi=org/ngsi-ld/default-context/A1" : [
			{
				"type" : "Property",
				"value" : "A1:D1",
				"datasetId" : "urn:ngsi-ld:dataset:D1",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			},
			{
				"type" : "Property",
				"value" : "A1:D2",
				"datasetId" : "urn:ngsi-ld:dataset:D2",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			},
			{
				"type" : "Property",
				"value" : "A1:D3",
				"datasetId" : "urn:ngsi-ld:dataset:D3",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			}
		]
	}
}
bye


