# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ contains Point - entity Polygon contains subscription Point

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# "contains" with Point subscription geometry, entity has Polygon location.
# "contains" means the entity's geometry CONTAINS the subscription's reference geometry.
# So: sub has a Point (Madrid), entity has a Polygon. Match if the entity polygon contains the sub point.
#
# Subscription reference point: Madrid [-3.691944, 40.418889]
#
# Entities:
#   E1: Iberian Peninsula polygon (contains Madrid)  - notification expected
#   E2: France polygon (does NOT contain Madrid)     - no notification
#   E3: Central Spain polygon (contains Madrid)      - notification expected
#
# 01. Create subscription S1 with geoQ contains Point at Madrid
# 02. Create entity E1 with Polygon covering Iberian Peninsula (contains Madrid) - notification expected
# 03. Create entity E2 with Polygon covering France (does NOT contain Madrid) - no notification
# 04. Create entity E3 with Polygon covering central Spain (contains Madrid) - notification expected
# 05. Dump ftClient - see 2 notifications: E1 and E3
#


echo "01. Create subscription S1 with geoQ contains Point at Madrid"
echo "============================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Region"
    }
  ],
  "geoQ": {
    "georel": "contains",
    "geometry": "Point",
    "coordinates": [-3.691944, 40.418889],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with Polygon covering Iberian Peninsula (contains Madrid) - notification expected"
echo "======================================================================================================"
payload='{
  "id": "urn:ngsi-ld:Region:E1",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Iberian Peninsula"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with Polygon covering France (does NOT contain Madrid) - no notification"
echo "============================================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E2",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "France"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-2, 43], [8, 43], [8, 51], [-2, 51], [-2, 43]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with Polygon covering central Spain (contains Madrid) - notification expected"
echo "=================================================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E3",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Central Spain"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-5, 39], [-2, 39], [-2, 42], [-5, 42], [-5, 39]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "05. Dump ftClient - see 2 notifications: E1 and E3"
echo "=================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ contains Point at Madrid
=============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with Polygon covering Iberian Peninsula (contains Madrid) - notification expected
======================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E1



03. Create entity E2 with Polygon covering France (does NOT contain Madrid) - no notification
=============================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E2



04. Create entity E3 with Polygon covering central Spain (contains Madrid) - notification expected
==================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E3



05. Dump ftClient - see 2 notifications: E1 and E3
==================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

