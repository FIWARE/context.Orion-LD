# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ disjoint Polygon - entity linestring must not touch subscription polygon

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "disjoint" from a polygon covering the Iberian Peninsula.
# Only entities whose linestring does NOT touch/overlap the subscription polygon should trigger notifications.
#
# Subscription polygon (lon, lat):
#   (-10, 36), (4, 36), (4, 44), (-10, 44), (-10, 36)
#
# 01. Create subscription S1 with geoQ disjoint Polygon
# 02. Create entity E1 with linestring inside Iberia - NO MATCH (not disjoint)
# 03. Create entity E2 with linestring in northern Europe - MATCH (disjoint)
# 04. Create entity E3 with linestring crossing boundary - NO MATCH (not disjoint)
# 05. Create entity E4 with linestring in North Africa - MATCH (disjoint)
# 06. Dump ftClient - see 2 notifications: E2 and E4
#


echo "01. Create subscription S1 with geoQ disjoint Polygon"
echo "======================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Route"
    }
  ],
  "geoQ": {
    "georel": "disjoint",
    "geometry": "Polygon",
    "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with linestring inside Iberia - NO MATCH"
echo "============================================================="
payload='{
  "id": "urn:ngsi-ld:Route:E1",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Madrid-Lisbon"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-3.691944, 40.418889], [-9.139337, 38.722252]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with linestring in northern Europe - MATCH"
echo "==============================================================="
payload='{
  "id": "urn:ngsi-ld:Route:E2",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Hamburg-Stockholm"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[5, 50], [15, 55]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with linestring crossing boundary - NO MATCH"
echo "================================================================="
payload='{
  "id": "urn:ngsi-ld:Route:E3",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Madrid-Paris"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-3.691944, 40.418889], [2.352222, 48.856614]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Create entity E4 with linestring in North Africa - MATCH"
echo "============================================================"
payload='{
  "id": "urn:ngsi-ld:Route:E4",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Casablanca-Algiers"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-5, 32], [5, 33]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "06. Dump ftClient - see 2 notifications: E2 and E4"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ disjoint Polygon
======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with linestring inside Iberia - NO MATCH
=============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E1



03. Create entity E2 with linestring in northern Europe - MATCH
===============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E2



04. Create entity E3 with linestring crossing boundary - NO MATCH
=================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E3



05. Create entity E4 with linestring in North Africa - MATCH
============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E4



06. Dump ftClient - see 2 notifications: E2 and E4
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST http://REGEX(.*)/notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
Ngsild-Attribute-Format: Normalized

{
    "data": [
        {
            "id": "urn:ngsi-ld:Route:E2",
            "location": {
                "type": "GeoProperty",
                "value": {
                    "coordinates": [
                        [
                            5,
                            50
                        ],
                        [
                            15,
                            55
                        ]
                    ],
                    "type": "LineString"
                }
            },
            "name": {
                "type": "Property",
                "value": "Hamburg-Stockholm"
            },
            "type": "Route"
        }
    ],
    "id": "urn:ngsi-ld:Notification:REGEX(.*)",
    "notifiedAt": "REGEX(.*)",
    "subscriptionId": "urn:ngsi-ld:Subscription:S1",
    "type": "Notification"
}
=======================================
POST http://REGEX(.*)/notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
Ngsild-Attribute-Format: Normalized

{
    "data": [
        {
            "id": "urn:ngsi-ld:Route:E4",
            "location": {
                "type": "GeoProperty",
                "value": {
                    "coordinates": [
                        [
                            -5,
                            32
                        ],
                        [
                            5,
                            33
                        ]
                    ],
                    "type": "LineString"
                }
            },
            "name": {
                "type": "Property",
                "value": "Casablanca-Algiers"
            },
            "type": "Route"
        }
    ],
    "id": "urn:ngsi-ld:Notification:REGEX(.*)",
    "notifiedAt": "REGEX(.*)",
    "subscriptionId": "urn:ngsi-ld:Subscription:S1",
    "type": "Notification"
}
=======================================



--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
