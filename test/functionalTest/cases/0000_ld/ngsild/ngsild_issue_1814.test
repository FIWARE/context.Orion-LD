# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Issue #1814

--SHELL-INIT--
dbInit CB
dbInit CP1
orionldStart CB -experimental -forwarding -wip entityMaps
orionldStart CP1 -experimental

--SHELL--

#
# 01. Create an entity 'cow001' of type 'Animal' on CP1
# 02. Create a registration for 'Animal' in CB for CP1
# 03. Query cb for all entities of type 'Animal' - see 'cow001' from CP1 
# 04. As step 03, but add an attrs filter for 'location' - see 'cow001' from CP1 (the issue #1814 says it's a 404 Not Found)
# 05. As step 03, but with Accept: application/geo+json - see 'cow001' from CP1 (the issue #1814 says location is NULL)
# 06. Retrieve 'cow001' from CB (forward to CP1), with 'attrs=location' as issue 1814 suggests
# 07. Retrieve 'cow001' from CB (forward to CP1), with 'Accept: application/geo+json' as issue 1814 suggests
#

echo "01. Create an entity 'cow001' of type 'Animal' on CP1"
echo "===================================================="
payload='{
    "id": "urn:ngsi-ld:Animal:cow001",
    "type": "Animal",
    "species": {
        "type": "Property",
        "value": "dairy cattle"
    },
    "name": {
        "type": "Property",
        "value": "Beany"
    },
    "heartRate": {
        "type": "Property",
        "value": 51,
        "unitCode": "5K"
    },
    "location": {
        "type": "GeoProperty",
        "value": {
            "type": "Point",
            "coordinates": [
                13.35257,
                52.51139
            ]
        },
        "observedAt": "2024-02-02T15:00:00.000Z"
    },
    "locatedAt": {
        "type": "Relationship",
        "object": "urn:ngsi-ld:AgriParcel:004"
    },
    "ownedBy": {
        "type": "Relationship",
        "object": "urn:ngsi-ld:Person:person001"
    },
    "fedWith": {
        "type": "Property",
        "value": "Hay"
    },
    "birthdate": {
        "type": "Property",
        "value": "2019-01-22T00:00:00.000Z"
    },
    "sex": {
        "type": "VocabProperty",
        "vocab": "Male"
    },
    "phenologicalCondition": {
        "type": "VocabProperty",
        "vocab": "maleAdult"
    },
    "reproductiveCondition": {
        "type": "VocabProperty",
        "vocab": "active"
    },
    "weight": {
        "type": "Property",
        "value": 772,
        "unitCode": "KGM"
    },
    "legalId": {
        "type": "Property",
        "value": "M-bull001-Beany"
    }
}'
orionCurl --url /ngsi-ld/v1/entities/ --payload "$payload" --port $CP1_PORT
echo
echo


echo "02. Create a registration for 'Animal' in CB for CP1"
echo "===================================================="
payload='{
  "type": "ContextSourceRegistration",
  "information": [
    {
      "entities": [
        {
          "type": "Animal"
        }
      ]
    }
  ],
  "mode": "inclusive",
  "operations": [ "federationOps" ],
  "endpoint": "localhost:'$CP1_PORT'"
}'
orionCurl --url /ngsi-ld/v1/csourceRegistrations --payload "$payload"
echo
echo


echo "03. Query cb for all entities of type 'Animal' - see 'cow001' from CP1"
echo "======================================================================"
orionCurl --url /ngsi-ld/v1/entities?type=Animal
echo
echo


echo "04. As step 03, but add an attrs filter for 'location' - see 'cow001' from CP1 (the issue #1814 says it's a 404 Not Found)"
echo "======================================================================e==================================================="
orionCurl --url '/ngsi-ld/v1/entities?type=Animal&attrs=location'
echo
echo


echo "05. As step 03, but with Accept: application/geo+json - see 'cow001' from CP1 (the issue #1814 says location is NULL)"
echo "====================================================================================================================="
orionCurl --url /ngsi-ld/v1/entities?type=Animal --out application/geo+json
echo
echo


echo "06. Retrieve 'cow001' from CB (forward to CP1), with 'attrs=location' as issue 1814 suggests"
echo "============================================================================================"
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:Animal:cow001?type=Animal&attrs=location'
echo
echo


echo "07. Retrieve 'cow001' from CB (forward to CP1), with 'Accept: application/geo+json' as issue 1814 suggests"
echo "=========================================================================================================="
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:Animal:cow001?type=Animal' --out application/geo+json
echo
echo



--REGEXPECT--
01. Create an entity 'cow001' of type 'Animal' on CP1
====================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Animal:cow001



02. Create a registration for 'Animal' in CB for CP1
====================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/csourceRegistrations/REGEX(.*)



