# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ within Polygon - entity with MultiPoint location

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "within" a polygon covering the Iberian Peninsula (rough bounding box).
# Entity locations use MultiPoint geometry.
# "within" means ALL points in the MultiPoint must be inside the polygon.
#
# Polygon vertices (lon, lat):
#   (-10, 36), (4, 36), (4, 44), (-10, 44), (-10, 36)
#
# MultiPoints:
#   E1: Madrid (-3.691944, 40.418889) + Lisbon (-9.139337, 38.722252)  - all inside
#   E2: Madrid (-3.691944, 40.418889) + Paris (2.352222, 48.856614)    - one outside
#   E3: Paris (2.352222, 48.856614) + Berlin (13.404954, 52.520008)    - all outside
#   E4: Toledo (-4.035825, 39.867459) + Valencia (-0.364853, 39.461008) - all inside
#
# 01. Create subscription S1 with geoQ within Polygon (Iberian Peninsula box)
# 02. Create entity E1 with MultiPoint all inside (Madrid + Lisbon) - notification expected
# 03. Create entity E2 with MultiPoint one outside (Madrid + Paris) - no notification
# 04. Create entity E3 with MultiPoint all outside (Paris + Berlin) - no notification
# 05. Create entity E4 with MultiPoint all inside (Toledo + Valencia) - notification expected
# 06. Dump ftClient - see 2 notifications: E1 and E4
#


echo "01. Create subscription S1 with geoQ within Polygon (Iberian Peninsula box)"
echo "==========================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "CityGroup"
    }
  ],
  "geoQ": {
    "georel": "within",
    "geometry": "Polygon",
    "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with MultiPoint all inside (Madrid + Lisbon) - notification expected"
echo "========================================================================================="
payload='{
  "id": "urn:ngsi-ld:CityGroup:E1",
  "type": "CityGroup",
  "name": {
    "type": "Property",
    "value": "Iberian Capitals"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "MultiPoint",
      "coordinates": [[-3.691944, 40.418889], [-9.139337, 38.722252]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with MultiPoint one outside (Madrid + Paris) - no notification"
echo "==================================================================================="
payload='{
  "id": "urn:ngsi-ld:CityGroup:E2",
  "type": "CityGroup",
  "name": {
    "type": "Property",
    "value": "Cross-border"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "MultiPoint",
      "coordinates": [[-3.691944, 40.418889], [2.352222, 48.856614]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with MultiPoint all outside (Paris + Berlin) - no notification"
echo "==================================================================================="
payload='{
  "id": "urn:ngsi-ld:CityGroup:E3",
  "type": "CityGroup",
  "name": {
    "type": "Property",
    "value": "Northern Europe"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "MultiPoint",
      "coordinates": [[2.352222, 48.856614], [13.404954, 52.520008]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Create entity E4 with MultiPoint all inside (Toledo + Valencia) - notification expected"
echo "=========================================================================================="
payload='{
  "id": "urn:ngsi-ld:CityGroup:E4",
  "type": "CityGroup",
  "name": {
    "type": "Property",
    "value": "Spanish Cities"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "MultiPoint",
      "coordinates": [[-4.035825, 39.867459], [-0.364853, 39.461008]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "06. Dump ftClient - see 2 notifications: E1 and E4"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ within Polygon (Iberian Peninsula box)
===========================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with MultiPoint all inside (Madrid + Lisbon) - notification expected
=========================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:CityGroup:E1



03. Create entity E2 with MultiPoint one outside (Madrid + Paris) - no notification
===================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:CityGroup:E2



04. Create entity E3 with MultiPoint all outside (Paris + Berlin) - no notification
===================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:CityGroup:E3



05. Create entity E4 with MultiPoint all inside (Toledo + Valencia) - notification expected
==========================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:CityGroup:E4



06. Dump ftClient - see 2 notifications: E1 and E4
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:CityGroup:E1",
      "type": "CityGroup",
      "name": {
        "type": "Property",
        "value": "Iberian Capitals"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "MultiPoint",
          "coordinates": [
            [
              -3.691944,
              40.418889
            ],
            [
              -9.139337,
              38.722252
            ]
          ]
        }
      }
    }
  ]
}
================================================================================

