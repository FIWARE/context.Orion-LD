# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Update an entity attribute (that is a VocabProperty) using PATCH Attribute

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--
#
# 00. Create an entity urn:E1 with one attribute per type
#
# 01. GET the attribute p_i (it's a property with an integer value)
# 02. GET the attribute p_i with sysAttrs
# 03. GET the attribute p_i in Concise format
# 04. GET the attribute p_i in Simplified format
#
# 11. GET the attribute p_f (it's a property with a JSON Float value)
# 12. GET the attribute p_f with sysAttrs
# 13. GET the attribute p_f in Concise format
# 14. GET the attribute p_f in Simplified format
#
# 21. GET the attribute p_b (it's a property with a JSON Boolean value)
# 22. GET the attribute p_b with sysAttrs
# 23. GET the attribute p_b in Concise format
# 24. GET the attribute p_b in Simplified format
#
# 31. GET the attribute p_s (it's a property with a JSON String value)
# 32. GET the attribute p_s with sysAttrs
# 33. GET the attribute p_s in Concise format
# 34. GET the attribute p_s in Simplified format
#
# 41. GET the attribute p_o (it's a property with a JSON Object value)
# 42. GET the attribute p_o with sysAttrs
# 43. GET the attribute p_o in Concise format
# 44. GET the attribute p_o in Simplified format
#
# 51. GET the attribute p_a (it's a property with a JSON Array value)
# 52. GET the attribute p_a with sysAttrs
# 53. GET the attribute p_a in Concise format
# 54. GET the attribute p_a in Simplified format
#
# 61. GET the attribute r_s (it's a relationship with a JSON String value)
# 62. GET the attribute r_s with sysAttrs
# 63. GET the attribute r_s in Concise format
# 64. GET the attribute r_s in Simplified format
#
# 71. GET the attribute r_a (it's a relationship with a JSON Array value)
# 72. GET the attribute r_a with sysAttrs
# 73. GET the attribute r_a in Concise format
# 74. GET the attribute r_a in Simplified format
#
# 81. GET the attribute v_s (it's a Vocab with a JSON String value)
# 82. GET the attribute v_s with sysAttrs
# 83. GET the attribute v_s in Concise format
# 84. GET the attribute v_s in Simplified format   ------------- FAILS !!!
#
# 91. GET the attribute v_a (it's a Vocab with a JSON Array value)
# 92. GET the attribute v_a with sysAttrs
# 93. GET the attribute v_a in Concise format
# 94. GET the attribute v_a in Simplified format   ------------- FAILS !!!
#
# 101. GET the attribute l_s (it's a Lang with a JSON String value)
# 102. GET the attribute l_s with sysAttrs
# 103. GET the attribute l_s in Concise format
# 104. GET the attribute l_s in Simplified format   ------------- FAILS !!!
#
# 111. GET the attribute l_a (it's a Lang with a JSON Array value)
# 112. GET the attribute l_a with sysAttrs
# 113. GET the attribute l_a in Concise format
# 114. GET the attribute l_a in Simplified format  ------------- FAILS !!!
#
# 121. GET the attribute j_o (it's a JsonProperty with a JSON Object value)
# 122. GET the attribute j_o with sysAttrs
# 123. GET the attribute j_o in Concise format
# 124. GET the attribute j_o in Simplified format   ------------- FAILS !!!
#
#

echo "00. Create an entity urn:E1 with one attribute per type"
echo "======================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "p_i": {
    "type": "Property",
    "value": 12,
    "xtra": 1
  },
  "p_f": {
    "type": "Property",
    "value": 3.14,
    "xtra": 1
  },
  "p_b": {
    "type": "Property",
    "value": true,
    "xtra": 1
  },
  "p_s": {
    "type": "Property",
    "value": "A String",
    "xtra": 1
  },
  "p_o": {
    "type": "Property",
    "value": {
      "i": 1,
      "f": 3.14
    },
    "xtra": 1
  },
  "p_a": {
    "type": "Property",
    "value": [ "an", "array" ],
    "xtra": 1
  },
  "r_s": {
    "type": "Relationship",
    "object": "urn:E2",
    "xtra": 1
  },
  "r_a": {
    "type": "Relationship",
    "object": [ "urn:E2", "urn:E3" ],
    "xtra": 1
  },
  "v_s": {
    "type": "VocabularyProperty",
    "vocab": "sensor",
    "xtra": 1
  },
  "v_a": {
    "type": "VocabularyProperty",
    "vocab": [ "sensor", "sensor2" ],
    "xtra": 1
  },
  "l_s": {
    "type": "LanguageProperty",
    "languageMap": {
      "en": "one",
      "es": "uno",
      "sv": "ett"
    },
    "xtra": 1
  },
  "l_a": {
    "type": "LanguageProperty",
    "languageMap": {
      "en": [ "one", "two" ],
      "es": [ "uno", "dos" ],
      "sv": [ "ett", "tva" ]
    },
    "xtra": 1
  },
  "j_o": {
    "type": "JsonProperty",
    "json": {
      "this": 2,
      "is": 3
    },
    "xtra": 1
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "01. GET the attribute p_i (it's a property with an integer value)"
echo "================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i
echo
echo


echo "02. GET the attribute p_i with sysAttrs"
echo "======================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i?options=sysAttrs
echo
echo


echo "03. GET the attribute p_i in Concise format"
echo "==========================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i?format=concise
echo
echo


echo "04. GET the attribute p_i in Simplified format"
echo "=============================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i?format=simplified
echo
echo


