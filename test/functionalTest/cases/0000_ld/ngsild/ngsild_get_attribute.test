# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Update an entity attribute (that is a VocabProperty) using PATCH Attribute

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--
#
# 00. Create an entity urn:E1 with one attribute per type
#
# 01. GET the attribute p_i (it's a property with an integer value)
# 02. GET the attribute p_i with sysAttrs
# 03. GET the attribute p_i in Concise format
# 04. GET the attribute p_i in Simplified format
#
# 11. GET the attribute p_o (it's a property with a JSON Object value)
# 12. GET the attribute p_o with sysAttrs
# 13. GET the attribute p_o in Concise format
# 14. GET the attribute p_o in Simplified format
#
# 21. GET the attribute r_s (it's a relationship with a JSON String value)
# 22. GET the attribute r_s with sysAttrs
# 23. GET the attribute r_s in Concise format
# 24. GET the attribute r_s in Simplified format
#

echo "00. Create an entity urn:E1 with one attribute per type"
echo "======================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "p_i": {
    "type": "Property",
    "value": 12,
    "xtra": 1
  },
  "p_o": {
    "type": "Property",
    "value": {
      "i": 1,
      "f": 3.14
    },
    "xtra": 1
  },
  "r_s": {
    "type": "Relationship",
    "object": "urn:E2",
    "xtra": 1
  },
  "v": {
    "type": "VocabularyProperty",
    "vocab": "sensor"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "01. GET the attribute p_i (it's a property with an integer value)"
echo "================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i
echo
echo


echo "02. GET the attribute p_i with sysAttrs"
echo "======================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i?options=sysAttrs
echo
echo


echo "03. GET the attribute p_i in Concise format"
echo "==========================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i?format=concise
echo
echo


echo "04. GET the attribute p_i in Simplified format"
echo "=============================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_i?format=simplified
echo
echo


echo "11. GET the attribute p_o (it's a property with a JSON Object value)"
echo "===================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_o
echo
echo


echo "12. GET the attribute p_o with sysAttrs"
echo "======================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_o?options=sysAttrs
echo
echo


echo "13. GET the attribute p_o in Concise format"
echo "==========================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_o?format=concise
echo
echo


echo "14. GET the attribute p_o in Simplified format"
echo "=============================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/p_o?format=simplified
echo
echo


echo "21. GET the attribute r_s (it's a relationship with a JSON String value)"
echo "========================================================================"
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/r_s
echo
echo


echo "22. GET the attribute r_s with sysAttrs"
echo "======================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/r_s?options=sysAttrs
echo
echo


echo "23. GET the attribute r_s in Concise format"
echo "==========================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/r_s?format=concise
echo
echo


echo "24. GET the attribute r_s in Simplified format"
echo "=============================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/r_s?format=simplified
echo
echo


--REGEXPECT--
00. Create an entity urn:E1 with one attribute per type
=======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



01. GET the attribute p_i (it's a property with an integer value)
=================================================================
HTTP/1.1 200 OK
Content-Length: 67
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "type": "Property",
    "value": 12,
    "xtra": {
        "type": "Property",
        "value": 1
    }
}


02. GET the attribute p_i with sysAttrs
=======================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "createdAt": REGEX(.*),
    "modifiedAt": REGEX(.*),
    "type": "Property",
    "value": 12,
    "xtra": {
        "createdAt": REGEX(.*),
        "modifiedAt": REGEX(.*),
        "type": "Property",
        "value": 1
    }
}


03. GET the attribute p_i in Concise format
===========================================
HTTP/1.1 200 OK
Content-Length: 21
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "value": 12,
    "xtra": 1
}


04. GET the attribute p_i in Simplified format
==============================================
HTTP/1.1 200 OK
Content-Length: 12
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "value": 12
}


11. GET the attribute p_o (it's a property with a JSON Object value)
====================================================================
HTTP/1.1 200 OK
Content-Length: 81
Content-Type: application/json
