# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Linked Entity Query

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly

--SHELL--

#
# 01. Create an entity urn:E1 with 3 relationships, R2, R3, and R4 (referencing entities urn:E2, urn:E3, and urn:E4)
# 02. Create those 3 entities (urn:E2, urn:E3, and urn:E4)
# 05. Query entities with ?join=flat
# 06. Query entities with with ?join=inline
#

echo "01. Create an entity urn:E1 with 3 relationships, R2, R3, and R4 (referencing entities urn:E2, urn:E3, and urn:E4)"
echo "=================================================================================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "P1": 1,
  "R1": {
    "object": "urn:E2"
  },
  "R1.2": {
    "object": "urn:E2"
  },
  "R2": {
    "object": "urn:E3"
  },
  "R3": {
    "object": "urn:E4"
  },
  "R0": {
    "object": "urn:E1"
 }
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "02. Create those 3 entities (urn:E2, urn:E3, and urn:E4)"
echo "========================================================"
payload='{
  "id": "urn:E2",
  "type": "T",
  "P1": 2
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo

payload='{
  "id": "urn:E3",
  "type": "T",
  "P1": 3
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo

payload='{
  "id": "urn:E4",
  "type": "T",
  "P1": 4
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "05. Query entities with ?join=flat"
echo "=================================="
orionCurl --url '/ngsi-ld/v1/entities?join=flat&local=true'
echo
echo


echo "06. Query entities with with ?join=inline"
echo "========================================="
orionCurl --url '/ngsi-ld/v1/entities?join=inline&local=true'
echo
echo


--REGEXPECT--
01. Create an entity urn:E1 with 3 relationships, R2, R3, and R4 (referencing entities urn:E2, urn:E3, and urn:E4)
==================================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



02. Create those 3 entities (urn:E2, urn:E3, and urn:E4)
========================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E2


HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E3


HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E4



05. Query entities with ?join=flat
==================================
HTTP/1.1 200 OK
Content-Length: 486
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
