        "P1": {
            "type": "Property",
            "value": 1
        },
        "R0": {
            "object": "urn:E1",
            "type": "Relationship"
        },
        "R1": {
            "object": "urn:E2",
            "type": "Relationship"
        },
        "R1.2": {
            "object": "urn:E2",
            "type": "Relationship"
        },
        "R2": {
            "object": "urn:E3",
            "type": "Relationship"
        },
        "R3": {
            "object": "urn:E4",
            "type": "Relationship"
        },
        "id": "urn:E1",
        "type": "T"
    },
    {
        "P1": {
            "type": "Property",
            "value": 2
        },
        "id": "urn:E2",
        "type": "T"
    },
    {
        "P1": {
            "type": "Property",
            "value": 3
        },
        "id": "urn:E3",
        "type": "T"
    },
    {
        "P1": {
            "type": "Property",
            "value": 4
        },
        "id": "urn:E4",
        "type": "T"
    }
]


