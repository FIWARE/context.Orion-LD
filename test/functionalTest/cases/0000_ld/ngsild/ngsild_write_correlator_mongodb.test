# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Write correlator (NGSILD-Correlator) is persisted in MongoDB lastCorrelator for every write path

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--

#
# This test verifies, WITHOUT TRoE, that the write correlator is stored in the
# entity document in MongoDB (field 'lastCorrelator') and that it is updated by
# every kind of write on the entity:
#
# 01. Create entity E1 (NGSILD-Correlator: urn:opc:write:create)
# 02. MongoDB: E1 stores lastCorrelator = urn:opc:write:create
# 03. Append an attribute to E1 (NGSILD-Correlator: urn:opc:write:append)
# 04. MongoDB: lastCorrelator updated to urn:opc:write:append
# 05. Patch an attribute of E1 (NGSILD-Correlator: urn:opc:write:patch)
# 06. MongoDB: lastCorrelator updated to urn:opc:write:patch
# 07. Delete an attribute of E1 (NGSILD-Correlator: urn:opc:write:delete)
# 08. MongoDB: lastCorrelator updated to urn:opc:write:delete
# 09. Create entity E2 with NO correlator header -> MongoDB lastCorrelator stays empty
# 10. MongoDB: only client-supplied correlators are mirrored, so E2.lastCorrelator is empty
#

echo "01. Create entity E1 (NGSILD-Correlator: urn:opc:write:create)"
echo "=============================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E1",
  "type": "T",
  "temperature": { "type": "Property", "value": 23.5 }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload" -H "NGSILD-Correlator: urn:opc:write:create"
echo
echo


echo "02. MongoDB: E1 stores lastCorrelator = urn:opc:write:create"
echo "==========================================================="
mongoCmd2 ftest 'db.entities.findOne({"_id.id":"urn:ngsi-ld:entities:E1"}).lastCorrelator'
echo
echo


echo "03. Append an attribute to E1 (NGSILD-Correlator: urn:opc:write:append)"
echo "======================================================================"
payload='{
  "pressure": { "type": "Property", "value": 1013 }
}'
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs' --payload "$payload" -H "NGSILD-Correlator: urn:opc:write:append"
echo
echo


echo "04. MongoDB: lastCorrelator updated to urn:opc:write:append"
echo "=========================================================="
mongoCmd2 ftest 'db.entities.findOne({"_id.id":"urn:ngsi-ld:entities:E1"}).lastCorrelator'
echo
echo


echo "05. Patch an attribute of E1 (NGSILD-Correlator: urn:opc:write:patch)"
echo "===================================================================="
payload='{
  "value": 42
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs/temperature -X PATCH --payload "$payload" -H "NGSILD-Correlator: urn:opc:write:patch"
echo
echo


echo "06. MongoDB: lastCorrelator updated to urn:opc:write:patch"
echo "========================================================="
mongoCmd2 ftest 'db.entities.findOne({"_id.id":"urn:ngsi-ld:entities:E1"}).lastCorrelator'
echo
echo


echo "07. Delete an attribute of E1 (NGSILD-Correlator: urn:opc:write:delete)"
echo "======================================================================"
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs/pressure -X DELETE -H "NGSILD-Correlator: urn:opc:write:delete"
echo
echo


echo "08. MongoDB: lastCorrelator updated to urn:opc:write:delete"
echo "=========================================================="
mongoCmd2 ftest 'db.entities.findOne({"_id.id":"urn:ngsi-ld:entities:E1"}).lastCorrelator'
echo
echo


echo "09. Create entity E2 with NO correlator header -> MongoDB lastCorrelator stays empty"
echo "==================================================================================="
payload='{
  "id": "urn:ngsi-ld:entities:E2",
  "type": "T",
  "machineState": "running"
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "10. MongoDB: only client-supplied correlators are mirrored, so E2.lastCorrelator is empty"
echo "========================================================================================"
mongoCmd2 ftest 'db.entities.findOne({"_id.id":"urn:ngsi-ld:entities:E2"}).lastCorrelator === ""'
echo
echo


--REGEXPECT--
01. Create entity E1 (NGSILD-Correlator: urn:opc:write:create)
==============================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1



02. MongoDB: E1 stores lastCorrelator = urn:opc:write:create
===========================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
urn:opc:write:create
bye


03. Append an attribute to E1 (NGSILD-Correlator: urn:opc:write:append)
======================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



04. MongoDB: lastCorrelator updated to urn:opc:write:append
==========================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
urn:opc:write:append
bye


05. Patch an attribute of E1 (NGSILD-Correlator: urn:opc:write:patch)
====================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



06. MongoDB: lastCorrelator updated to urn:opc:write:patch
=========================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
urn:opc:write:patch
bye


07. Delete an attribute of E1 (NGSILD-Correlator: urn:opc:write:delete)
======================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



08. MongoDB: lastCorrelator updated to urn:opc:write:delete
==========================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
urn:opc:write:delete
bye


09. Create entity E2 with NO correlator header -> MongoDB lastCorrelator stays empty
===================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E2



10. MongoDB: only client-supplied correlators are mirrored, so E2.lastCorrelator is empty
========================================================================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
true
bye


--TEARDOWN--
brokerStop CB
dbDrop CB
