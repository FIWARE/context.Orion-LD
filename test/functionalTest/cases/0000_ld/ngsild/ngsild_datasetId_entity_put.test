# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Attribute Delete with datasetId

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly

--SHELL--

#
# 01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default
# 01b. See the entity in the database
# 02. GET the entity - see the datasets
# 03. Replace E1 without any datasetIds
# 03b. See the entity in the database
# 04. GET the entity - see no datasets
# 05. Replace E1 with datasetIds
# 06. GET the entity - see the new datasets
# 06b. See the entity in the database
#

echo "01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default"
echo "======================================================================================================"
payload='{
  "id": "urn:E1",
  "type": "T",
  "A1": [
    {
      "type": "Property",
      "value": "A1:Default"
    },
    {
      "type": "Property",
      "value": "A1:D1",
      "datasetId": "urn:ngsi-ld:dataset:D1"
    },
    {
      "type": "Property",
      "value": "A1:D2",
      "datasetId": "urn:ngsi-ld:dataset:D2"
    }
  ]
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "01b. See the entity in the database"
echo "=================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "02. GET the entity - see the datasets"
echo "====================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1
echo
echo


echo "03. Replace E1 without any datasetIds"
echo "====================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "A1": 31,
  "A2": 32
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1 -X PUT --payload "$payload"
echo
echo


echo "03b. See the entity in the database"
echo "=================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "04. GET the entity - see no datasets"
echo "===================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1
echo
echo


echo "05. Replace E1 with datasetIds"
echo "=============================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "A1": [
    {
      "type": "Property",
      "value": 51,
      "datasetId": "urn:ngsi-ld:dataset:D3"
    },
    {
      "value": 52,
      "datasetId": "urn:ngsi-ld:dataset:D4"
    },
    {
      "value": 53
    }
  ],
  "A2": [
    {
      "value": 54    
    }
  ]
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1 -X PUT --payload "$payload"
echo
echo


echo "06. GET the entity - see the new datasets"
echo "========================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1
echo
echo


echo "06b. See the entity in the database"
echo "=================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


--REGEXPECT--
01. Create an entity E1 with an attribute A1 having 3 datasets (D1, D2, and D3) apart from the default
======================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



01b. See the entity in the database
==================================
MongoDB shell version REGEX(.*)
connecting to: REGEX(.*)
MongoDB server version: REGEX(.*)
{
	"_id" : {
		"id" : "urn:E1",
		"type" : "https://uri.etsi.org/ngsi-ld/default-context/T",
		"servicePath" : "/"
	},
	"attrNames" : [
		"https://uri.etsi.org/ngsi-ld/default-context/A1"
	],
	"attrs" : {
		"https://uri=etsi=org/ngsi-ld/default-context/A1" : {
			"type" : "Property",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : "A1:Default",
			"mdNames" : [ ]
		}
	},
	"creDate" : REGEX(.*),
	"modDate" : REGEX(.*),
	"lastCorrelator" : "",
	"@datasets" : {
		"https://uri=etsi=org/ngsi-ld/default-context/A1" : [
			{
				"type" : "Property",
				"value" : "A1:D1",
				"datasetId" : "urn:ngsi-ld:dataset:D1",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			},
			{
				"type" : "Property",
				"value" : "A1:D2",
				"datasetId" : "urn:ngsi-ld:dataset:D2",
				"createdAt" : REGEX(.*),
				"modifiedAt" : REGEX(.*)
			}
		]
	}
}
bye


