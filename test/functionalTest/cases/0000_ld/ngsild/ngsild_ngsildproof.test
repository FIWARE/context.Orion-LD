			"type" : "Property",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : 1,
			"mdNames" : [
				"ngsildproof"
			],
			"md" : {
				"ngsildproof" : {
					"type" : "Property",
