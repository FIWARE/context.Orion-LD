# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
GET Entities by type

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly

--SHELL--

#
# 01. Create an entity urn:E1 with an attribute A1 that has an ngsildproof sub-attribute
# 02. GET the entity, see the ngsildproof sub-attribute "the way we want it"
# 03. See the entity in the database
# 04. Create an entity urn:E2 with an attribute A1 that has an ngsildproof sub-attribute, different value
# 05. Query over A1.ngsildproof, see only urn:E1
#


echo "01. Create an entity urn:E1 with an attribute A1 that has an ngsildproof sub-attribute"
echo "======================================================================================"
payload='{
  "id": "urn:E1",
  "type": "T",
  "A1": {
    "type": "Property",
    "value": 1,
    "ngsildproof": {
      "type": "Property",
      "entityIdSealed": "urn:E1",
      "entityTypeSealed": "T",
      "value": {
        "type": "DataIntegrityProof",
        "created": "2025-01-27T21:02:24Z",
        "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT",
        "cryptosuite": "eddsa-rdfc-2022",
        "proofPurpose": "assertionMethod",
        "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eS"
      }
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET the entity, see the ngsildproof sub-attribute 'the way we want it'"
echo "=========================================================================="
orionCurl --url /ngsi-ld/v1/entities?type=T
echo
echo


echo "03. See the entity in the database"
echo "=================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "04. Create an entity urn:E2 with an attribute A1 that has an ngsildproof sub-attribute, different value"
echo "======================================================================================================="
payload='{
  "id": "urn:E2",
  "type": "T",
  "A1": {
    "type": "Property",
    "value": 1,
    "ngsildproof": {
      "type": "Property",
      "entityIdSealed": "urn:E2",
      "entityTypeSealed": "T",
      "value": {
        "type": "DataIntegrityProof",
        "created": "2025-02-27T21:02:24Z",
        "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT",
        "cryptosuite": "eddsa-rdfc-2022",
        "proofPurpose": "assertionMethod",
        "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eT"
      }
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Query over A1.ngsildproof, see only urn:E1"
echo "=============================================="
orionCurl --url '/ngsi-ld/v1/entities?q=A1.ngsildproof\[proofValue\]==%22z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eS%22'
echo
echo


echo "05. Query for existence of A1.ngsildproof - see both entities"
echo "============================================================="
orionCurl --url '/ngsi-ld/v1/entities?q=A1.ngsildproof'
echo
echo


--REGEXPECT--
01. Create an entity urn:E1 with an attribute A1 that has an ngsildproof sub-attribute
======================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



02. GET the entity, see the ngsildproof sub-attribute 'the way we want it'
==========================================================================
HTTP/1.1 200 OK
Content-Length: 395
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "A1": {
            "ngsildproof": {
                "type": "Property",
                "value": {
                    "created": "2025-01-27T21:02:24Z",
                    "cryptosuite": "eddsa-rdfc-2022",
                    "proofPurpose": "assertionMethod",
                    "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eS",
                    "type": "DataIntegrityProof",
                    "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT"
                }
            },
            "type": "Property",
            "value": 1
        },
        "id": "urn:E1",
        "type": "T"
    }
]


03. See the entity in the database
==================================
