# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
GET Entities by type

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
ftClientStart -t 0-5000

--SHELL--

#
# 01. Create an entity urn:E1 with an attribute A1 that has an ngsildproof sub-attribute
# 02. GET the entity, see the ngsildproof sub-attribute "the way we want it"
# 02b. See the entity in the database
# 03. Create an entity urn:E2 with an attribute A1 that has an ngsildproof sub-attribute, different value
# 04. Query over A1.ngsildproof, see only urn:E1
# 05. Query for existence of A1.ngsildproof - see both entities
# 06. Create an entity urn:E3 with two attributes A1 and A2, both as empty as can be 
# 07. GET urn:E3, see attributes A1 and A2
# 08. Create a subscription on changes in A1
# 09. PATCH urn:E3, giving ngsildproof sub-attributes to A1 and A2
# 10. GET urn:E3, see attributes A1 and A2 with their ngsildproof sub-attributes
# 11. Dump ftClient to see one notification
#

echo "01. Create an entity urn:E1 with an attribute A1 that has an ngsildproof sub-attribute"
echo "======================================================================================"
payload='{
  "id": "urn:E1",
  "type": "T",
  "A1": {
    "type": "Property",
    "value": 1,
    "ngsildproof": {
      "type": "Property",
      "entityIdSealed": "urn:E1",
      "entityTypeSealed": "T",
      "value": {
        "type": "DataIntegrityProof",
        "created": "2025-01-27T21:02:24Z",
        "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT",
        "cryptosuite": "eddsa-rdfc-2022",
        "proofPurpose": "assertionMethod",
        "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eS"
      }
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "02. GET the entity, see the ngsildproof sub-attribute 'the way we want it'"
echo "=========================================================================="
orionCurl --url /ngsi-ld/v1/entities?type=T
echo
echo


echo "02b. See the entity in the database"
echo "==================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "03. Create an entity urn:E2 with an attribute A1 that has an ngsildproof sub-attribute, different value"
echo "======================================================================================================="
payload='{
  "id": "urn:E2",
  "type": "T",
  "A1": {
    "type": "Property",
    "value": 1,
    "ngsildproof": {
      "type": "Property",
      "entityIdSealed": "urn:E2",
      "entityTypeSealed": "T",
      "value": {
        "type": "DataIntegrityProof",
        "created": "2025-02-27T21:02:24Z",
        "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT",
        "cryptosuite": "eddsa-rdfc-2022",
        "proofPurpose": "assertionMethod",
        "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eT"
      }
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Query over A1.ngsildproof, see only urn:E1"
echo "=============================================="
orionCurl --url '/ngsi-ld/v1/entities?q=A1.ngsildproof\[proofValue\]==%22z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eS%22'
echo
echo


echo "05. Query for existence of A1.ngsildproof - see both entities"
echo "============================================================="
orionCurl --url '/ngsi-ld/v1/entities?q=A1.ngsildproof'
echo
echo


echo "06. Create an entity urn:E3 with two attributes A1 and A2, both as empty as can be"
echo "=================================================================================="
payload='{
  "id": "urn:E3",
  "type": "T",
  "A1": "urn:nil",
  "A2": "urn:nil"
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "07. GET urn:E3, see attributes A1 and A2"
echo "========================================"
orionCurl --url /ngsi-ld/v1/entities/urn:E3?local=true
echo
echo


echo "08. Create a subscription on changes in A1"
echo "=========================================="
payload='{
  "id": "urn:s1",
  "type": "Subscription",
  "entities": [
    {
      "type": "T"
    }
  ],
  "watchedAttributes": [ "A1", "A2" ],
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify"
    },
    "format": "concise"
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "09. PATCH urn:E3, giving ngsildproof sub-attributes to A1 and A2"
echo "================================================================"
payload='{
  "A1": {
    "value": "A1 in step 08",
    "ngsildproof": {
      "type": "Property",
      "entityIdSealed": "urn:E3",
      "entityTypeSealed": "T",
      "value": {
        "type": "DataIntegrityProof",
        "created": "2025-02-27T21:02:24Z",
        "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT",
        "cryptosuite": "eddsa-rdfc-2022",
        "proofPurpose": "assertionMethod",
        "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eT"
      }
    }
  },
  "A2": {
    "value": "A2 in step 08",
    "ngsildproof": {
      "type": "Property",
      "entityIdSealed": "urn:E3",
      "entityTypeSealed": "T",
      "value": {
        "type": "DataIntegrityProof",
        "created": "2025-02-27T21:02:24Z",
        "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT",
        "cryptosuite": "eddsa-rdfc-2022",
        "proofPurpose": "assertionMethod",
        "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eT"
      }
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E3/attrs -X PATCH --payload "$payload"
echo
echo


echo "10. GET urn:E3, see attributes A1 and A2 with their ngsildproof sub-attributes"
echo "=============================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E3
echo
echo


echo "11. Dump ftClient to see one notification"
echo "========================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create an entity urn:E1 with an attribute A1 that has an ngsildproof sub-attribute
======================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



02. GET the entity, see the ngsildproof sub-attribute 'the way we want it'
==========================================================================
HTTP/1.1 200 OK
Content-Length: 395
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "A1": {
            "ngsildproof": {
                "type": "Property",
                "value": {
                    "created": "2025-01-27T21:02:24Z",
                    "cryptosuite": "eddsa-rdfc-2022",
                    "proofPurpose": "assertionMethod",
                    "proofValue": "z3XrH3diVCqpVHXkE7WbnictqyQCkJBGTx....NRTzmuoWU1Y2FyqGfSV9eS",
                    "type": "DataIntegrityProof",
                    "verificationMethod": "https://example.edu/issuers/565049#z6MkwXG2WjeQnN....Hc6SaVWoT"
                }
            },
            "type": "Property",
            "value": 1
        },
        "id": "urn:E1",
        "type": "T"
    }
]


