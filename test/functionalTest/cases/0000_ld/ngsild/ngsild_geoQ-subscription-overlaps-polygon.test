# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ overlaps Polygon - notify only entities whose Polygon partially overlaps

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "overlaps" and a Polygon covering western Spain.
# "overlaps" in GEOS means the two geometries have the same dimension,
# overlap partially, but neither contains the other.
#
# Subscription polygon (western Spain):
#   [[-6, 38], [-2, 38], [-2, 42], [-6, 42], [-6, 38]]
#
# E1: Polygon partially overlapping (eastern Spain) - notification expected
#   [[-4, 39], [0, 39], [0, 43], [-4, 43], [-4, 39]]
#   Overlaps on the -4 to -2 strip
#
# E2: Polygon fully inside sub polygon (contained) - no notification (not "overlaps")
#   [[-5, 39], [-3, 39], [-3, 41], [-5, 41], [-5, 39]]
#
# E3: Polygon completely outside (France) - no notification
#   [[0, 45], [4, 45], [4, 49], [0, 49], [0, 45]]
#
# E4: Polygon partially overlapping (Portugal side) - notification expected
#   [[-9, 37], [-5, 37], [-5, 41], [-9, 41], [-9, 37]]
#   Overlaps on the -6 to -5 strip
#
# 01. Create subscription S1 with geoQ overlaps Polygon (western Spain)
# 02. Create entity E1 with Polygon partially overlapping (eastern Spain) - notification expected
# 03. Create entity E2 with Polygon fully inside sub polygon - no notification
# 04. Create entity E3 with Polygon completely outside (France) - no notification
# 05. Create entity E4 with Polygon partially overlapping (Portugal side) - notification expected
# 06. Dump ftClient - see 2 notifications: E1 and E4
#


echo "01. Create subscription S1 with geoQ overlaps Polygon (western Spain)"
echo "====================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Region"
    }
  ],
  "geoQ": {
    "georel": "overlaps",
    "geometry": "Polygon",
    "coordinates": [[[-6, 38], [-2, 38], [-2, 42], [-6, 42], [-6, 38]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with Polygon partially overlapping (eastern Spain) - notification expected"
echo "==============================================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E1",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Eastern Spain"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-4, 39], [0, 39], [0, 43], [-4, 43], [-4, 39]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with Polygon fully inside sub polygon - no notification"
echo "============================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E2",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Central Spain"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-5, 39], [-3, 39], [-3, 41], [-5, 41], [-5, 39]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with Polygon completely outside (France) - no notification"
echo "==============================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E3",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "France"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[0, 45], [4, 45], [4, 49], [0, 49], [0, 45]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Create entity E4 with Polygon partially overlapping (Portugal side) - notification expected"
echo "==============================================================================================="
payload='{
  "id": "urn:ngsi-ld:Region:E4",
  "type": "Region",
  "name": {
    "type": "Property",
    "value": "Portugal"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Polygon",
      "coordinates": [[[-9, 37], [-5, 37], [-5, 41], [-9, 41], [-9, 37]]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "06. Dump ftClient - see 2 notifications: E1 and E4"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ overlaps Polygon (western Spain)
=====================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with Polygon partially overlapping (eastern Spain) - notification expected
===============================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E1



03. Create entity E2 with Polygon fully inside sub polygon - no notification
=============================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E2



04. Create entity E3 with Polygon completely outside (France) - no notification
===============================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E3



05. Create entity E4 with Polygon partially overlapping (Portugal side) - notification expected
===============================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Region:E4



06. Dump ftClient - see 2 notifications: E1 and E4
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

