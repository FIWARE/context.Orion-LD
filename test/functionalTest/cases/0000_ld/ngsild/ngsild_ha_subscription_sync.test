{
    "description": "patched on CB",
    "entities": [
        {
            "type": "T"
        }
    ],
    "id": "urn:S1",
    "isActive": true,
    "jsonldContext": "REGEX(.*)",
    "notification": {
        "endpoint": {
            "accept": "application/json",
            "uri": "http://localhost:9997/notify"
        },
        "format": "normalized",
        "status": "ok"
    },
    "origin": "cache",
    "status": "active",
    "type": "Subscription"
}


