# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Issue #1783 - entity query with application/geo+json

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental -wip entityMaps -forwarding -t 0-255

--SHELL--

