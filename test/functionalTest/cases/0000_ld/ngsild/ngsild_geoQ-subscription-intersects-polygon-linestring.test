# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ intersects Polygon - entity with LineString location

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "intersects" and a polygon covering the Iberian Peninsula.
# Entities have LineString locations instead of Point.
#
# Polygon vertices (lon, lat):
#   (-10, 36), (4, 36), (4, 44), (-10, 44), (-10, 36)
#
# LineStrings:
#   E1: Madrid to Toledo   [-3.691944, 40.418889] -> [-4.035825, 39.867459]  (fully inside)
#   E2: Paris to Berlin    [2.352222, 48.856614]  -> [13.404954, 52.520008]  (fully outside)
#   E3: Lisbon to Paris    [-9.139337, 38.722252] -> [2.352222, 48.856614]   (crosses boundary)
#
# 01. Create subscription S1 with geoQ intersects Polygon (Iberian Peninsula box)
# 02. Create entity E1 with LineString fully inside polygon (Madrid to Toledo) - notification expected
# 03. Create entity E2 with LineString fully outside polygon (Paris to Berlin) - no notification
# 04. Create entity E3 with LineString crossing polygon boundary (Lisbon to Paris) - notification expected
# 05. Dump ftClient - see 2 notifications: E1 and E3
#


echo "01. Create subscription S1 with geoQ intersects Polygon (Iberian Peninsula box)"
echo "================================================================================"
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Route"
    }
  ],
  "geoQ": {
    "georel": "intersects",
    "geometry": "Polygon",
    "coordinates": [[[-10, 36], [4, 36], [4, 44], [-10, 44], [-10, 36]]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with LineString fully inside polygon (Madrid to Toledo) - notification expected"
echo "===================================================================================================="
payload='{
  "id": "urn:ngsi-ld:Route:E1",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Madrid-Toledo"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-3.691944, 40.418889], [-4.035825, 39.867459]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with LineString fully outside polygon (Paris to Berlin) - no notification"
echo "=============================================================================================="
payload='{
  "id": "urn:ngsi-ld:Route:E2",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Paris-Berlin"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[2.352222, 48.856614], [13.404954, 52.520008]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with LineString crossing polygon boundary (Lisbon to Paris) - notification expected"
echo "========================================================================================================"
payload='{
  "id": "urn:ngsi-ld:Route:E3",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Lisbon-Paris"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-9.139337, 38.722252], [2.352222, 48.856614]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "05. Dump ftClient - see 2 notifications: E1 and E3"
echo "==================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ intersects Polygon (Iberian Peninsula box)
================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with LineString fully inside polygon (Madrid to Toledo) - notification expected
====================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E1



03. Create entity E2 with LineString fully outside polygon (Paris to Berlin) - no notification
==============================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E2



04. Create entity E3 with LineString crossing polygon boundary (Lisbon to Paris) - notification expected
========================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E3



05. Dump ftClient - see 2 notifications: E1 and E3
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Route:E1",
      "type": "Route",
      "name": {
        "type": "Property",
        "value": "Madrid-Toledo"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "LineString",
          "coordinates": [
            [
              -3.691944,
              40.418889
            ],
            [
              -4.035825,
              39.867459
            ]
          ]
        }
      }
    }
  ]
}
================================================================================

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:Route:E3",
      "type": "Route",
      "name": {
        "type": "Property",
        "value": "Lisbon-Paris"
      },
      "location": {
        "type": "GeoProperty",
        "value": {
          "type": "LineString",
          "coordinates": [
            [
              -9.139337,
              38.722252
            ],
            [
              2.352222,
              48.856614
            ]
          ]
        }
      }
    }
  ]
}



--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
