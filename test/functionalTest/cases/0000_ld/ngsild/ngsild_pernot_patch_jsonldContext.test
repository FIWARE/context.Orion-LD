# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
PATCH Pernot Subscription - update jsonldContext and verify notification Link header

--SHELL-INIT--
dbInit CB
orionldStart CB -pernot -experimental
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# 01. Create a pernot subscription urn:S1 with the default core context, timeInterval 2
# 02. Create entity urn:E1 type T
# 03. Sleep 2 secs - let the pernot loop fire with the original context
# 04. Dump ftClient - see notification with Link header using core context
# 05. PATCH urn:S1 - change jsonldContext to testContext
# 06. GET urn:S1 from cache - see jsonldContext is testContext
# 07. GET urn:S1 from database - see jsonldContext is testContext
# 08. Sleep 2 secs - let the pernot loop fire with the new context
# 09. Dump ftClient - see notification with Link header using testContext
#

echo "01. Create a pernot subscription urn:S1 with the default core context, timeInterval 2"
echo "====================================================================================="
payload='{
  "id": "urn:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "T"
    }
  ],
  "timeInterval": 2,
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity urn:E1 type T"
echo "==============================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "P1": 1
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Sleep 2 secs - let the pernot loop fire with the original context"
echo "====================================================================="
sleep 2
echo
echo


echo "04. Dump ftClient - see notification with Link header using core context"
echo "========================================================================"
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo
orionCurl --url /dump --port $FT_PORT -X DELETE > /dev/null 2>&1


echo "05. PATCH urn:S1 - change jsonldContext to testContext"
echo "====================================================="
payload='{
  "jsonldContext": "https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld"
}'
orionCurl --url /ngsi-ld/v1/subscriptions/urn:S1 --payload "$payload" -X PATCH
echo
echo


echo "06. GET urn:S1 from cache - see jsonldContext is testContext"
echo "============================================================"
orionCurl --url /ngsi-ld/v1/subscriptions/urn:S1
echo
echo


echo "07. GET urn:S1 from database - see jsonldContext is testContext"
echo "=============================================================="
orionCurl --url '/ngsi-ld/v1/subscriptions/urn:S1?options=fromDb'
echo
echo


echo "08. Sleep 2 secs - let the pernot loop fire with the new context"
echo "================================================================"
sleep 2
echo
echo


echo "09. Dump ftClient - see notification with Link header using testContext"
echo "======================================================================="
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create a pernot subscription urn:S1 with the default core context, timeInterval 2
=====================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:S1



02. Create entity urn:E1 type T
===============================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



03. Sleep 2 secs - let the pernot loop fire with the original context
=====================================================================


04. Dump ftClient - see notification with Link header using core context
========================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST http://REGEX(.*)/notify?subscriptionId=urn:S1
Content-Length: REGEX(\d+)
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
Ngsild-Attribute-Format: Normalized

{
    "data": [
        {
            "P1": {
                "type": "Property",
                "value": 1
            },
            "id": "urn:E1",
            "type": "T"
        }
    ],
    "id": "urn:ngsi-ld:Notification:REGEX(.*)",
    "notifiedAt": "REGEX(.*)",
    "subscriptionId": "urn:S1",
    "type": "Notification"
}
=======================================



05. PATCH urn:S1 - change jsonldContext to testContext
=====================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



06. GET urn:S1 from cache - see jsonldContext is testContext
============================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "entities": [
        {
            "type": "T"
        }
    ],
    "id": "urn:S1",
    "isActive": true,
    "jsonldContext": "https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld",
    "notification": {
        "endpoint": {
            "accept": "application/json",
            "uri": "http://REGEX(.*)/notify"
        },
        "format": "normalized",
        "lastNotification": "REGEX(.*)",
        "lastSuccess": "REGEX(.*)",
        "noMatch": REGEX(\d+),
        "status": "ok",
        "timesSent": REGEX(\d+)
    },
    "origin": "cache",
    "status": "active",
    "timeInterval": 2,
    "type": "Subscription"
}


07. GET urn:S1 from database - see jsonldContext is testContext
==============================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "entities": [
        {
            "type": "T"
        }
    ],
    "id": "urn:S1",
    "isActive": true,
    "jsonldContext": "https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld",
    "notification": {
        "endpoint": {
            "accept": "application/json",
            "uri": "http://REGEX(.*)/notify"
        },
        "format": "normalized",
        "lastNotification": "REGEX(.*)",
        "lastSuccess": "REGEX(.*)",
        "noMatch": REGEX(\d+),
        "status": "ok",
        "timesSent": REGEX(\d+)
    },
    "origin": "database",
    "status": "active",
    "timeInterval": 2,
    "type": "Subscription"
}


08. Sleep 2 secs - let the pernot loop fire with the new context
================================================================


09. Dump ftClient - see notification with Link header using testContext
=======================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST http://REGEX(.*)/notify?subscriptionId=urn:S1
Content-Length: REGEX(\d+)
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Content-Type: application/json
Link: <https://fiware.github.io/NGSI-LD_TestSuite/ldContext/testContext.jsonld>REGEX(.*)
Ngsild-Attribute-Format: Normalized

{
    "data": [
        {
            "P1": {
                "type": "Property",
                "value": 1
            },
            "id": "urn:E1",
            "type": "T"
        }
    ],
    "id": "urn:ngsi-ld:Notification:REGEX(.*)",
    "notifiedAt": "REGEX(.*)",
    "subscriptionId": "urn:S1",
    "type": "Notification"
}
=======================================



--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
