# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Core context in response of entity query and retrieval

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--

#
# 01. Create entity urn:E1, with @context https://fiware.github.io/data-models/context.jsonld
# 02. Create entity urn:E1, with @context https://fiware.github.io/data-models/context.jsonld
# 03. Retrieve urn:E1, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response
# 04. Query entities, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response
# 05. POST Query entities, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response
#

echo "01. Create entity urn:E1, with @context https://fiware.github.io/data-models/context.jsonld"
echo "================================================================================="
payload='{
  "id": "urn:E1",
  "type": "ByInvoice",
  "Cash": 100 
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload" -H 'Link: <https://fiware.github.io/data-models/context.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "02. Create entity urn:E1, with @context https://fiware.github.io/data-models/context.jsonld"
echo "================================================================================="
payload='{
  "id": "urn:E2",
  "type": "ByInvoice",
  "Cash": 100 
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload" -H 'Link: <https://fiware.github.io/data-models/context.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "03. Retrieve urn:E1, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response"
echo "=============================================================================================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:E1 --out application/ld+json -H 'Link: <https://fiware.github.io/data-models/context.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "04. Query entities, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response"
echo "============================================================================================================================="
orionCurl --url /ngsi-ld/v1/entities?type=ByInvoice --out application/ld+json -H 'Link: <https://fiware.github.io/data-models/context.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo


echo "05. POST Query entities, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response"
echo "=================================================================================================================================="
payload='{
  "type": "Query",
  "entities": [
    {
      "type": "ByInvoice"
    }
  ]
}'
orionCurl --url /ngsi-ld/v1/entityOperations/query --payload "$payload" --out application/ld+json -H 'Link: <https://fiware.github.io/data-models/context.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"'
echo
echo

--REGEXPECT--
01. Create entity urn:E1, with @context https://fiware.github.io/data-models/context.jsonld
=================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



02. Create entity urn:E1, with @context https://fiware.github.io/data-models/context.jsonld
=================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E2



03. Retrieve urn:E1, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response
==============================================================================================================================
HTTP/1.1 200 OK
Content-Length: 197
Content-Type: application/ld+json
Date: REGEX(.*)

{
    "@context": [
        "https://fiware.github.io/data-models/context.jsonld",
        "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)"
    ],
    "Cash": {
        "type": "Property",
        "value": 100
    },
    "id": "urn:E1",
    "type": "ByInvoice"
}


04. Query entities, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response
=============================================================================================================================
HTTP/1.1 200 OK
Content-Length: 397
Content-Type: application/ld+json
Date: REGEX(.*)

[
    {
        "@context": [
            "https://fiware.github.io/data-models/context.jsonld",
            "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)"
        ],
        "Cash": {
            "type": "Property",
            "value": 100
        },
        "id": "urn:E1",
        "type": "ByInvoice"
    },
    {
        "@context": [
            "https://fiware.github.io/data-models/context.jsonld",
            "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)"
        ],
        "Cash": {
            "type": "Property",
            "value": 100
        },
        "id": "urn:E2",
        "type": "ByInvoice"
    }
]


05. POST Query entities, with @context https://fiware.github.io/data-models/context.jsonld and Accept ld+json - see core context in response
==================================================================================================================================
HTTP/1.1 200 OK
Content-Length: 397
Content-Type: application/ld+json
Date: REGEX(.*)

[
    {
        "@context": [
            "https://fiware.github.io/data-models/context.jsonld",
            "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)"
        ],
        "Cash": {
            "type": "Property",
            "value": 100
        },
        "id": "urn:E1",
        "type": "ByInvoice"
    },
    {
        "@context": [
            "https://fiware.github.io/data-models/context.jsonld",
            "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)"
        ],
        "Cash": {
            "type": "Property",
            "value": 100
        },
        "id": "urn:E2",
        "type": "ByInvoice"
    }
]


--TEARDOWN--
brokerStop CB
dbDrop CB

