        {
            "id": "urn:ngsi-ld:City:E4",
            "location": {
                "type": "GeoProperty",
                "value": {
                    "coordinates": [
                        -4.117588,
                        40.94801
                    ],
                    "type": "Point"
                }
            },
            "name": {
                "type": "Property",
                "value": "Segovia"
            },
            "type": "City"
        }
    ],
    "id": "urn:ngsi-ld:Notification:REGEX(.*)",
