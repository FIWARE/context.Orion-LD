# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ near donut (both maxDistance and minDistance)

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription centered at Madrid (lon=-3.691944, lat=40.418889)
# with minDistance 50km and maxDistance 100km (a "donut" ring).
#
# Points inside the donut (50km < distance < 100km):
#   Toledo:       lon=-4.035825, lat=39.867459  (~69km from Madrid)
#   Segovia:      lon=-4.117588, lat=40.948010  (~68km from Madrid)
#
# Points too close (< 50km, inside the hole):
#   Alcala:       lon=-3.363532, lat=40.481784  (~29km from Madrid)
#
# Points too far (> 100km, outside the donut):
#   Barcelona:    lon=2.154006,  lat=41.366656  (~506km from Madrid)
#
# 01. Create subscription S1 with geoQ near;maxDistance==100000;minDistance==50000
# 02. Create entity E1 at Toledo (in donut ~69km) - notification expected
# 03. Create entity E2 at Alcala (too close ~29km) - no notification
# 04. Create entity E3 at Barcelona (too far ~506km) - no notification
# 05. Create entity E4 at Segovia (in donut ~68km) - notification expected
# 06. Dump ftClient - see 2 notifications: E1 (Toledo) and E4 (Segovia)
#


echo "01. Create subscription S1 with geoQ near;maxDistance==100000;minDistance==50000"
echo "==============================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "City"
    }
  ],
  "geoQ": {
    "georel": "near;maxDistance==100000;minDistance==50000",
    "geometry": "Point",
    "coordinates": [-3.691944, 40.418889],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 at Toledo (in donut ~69km) - notification expected"
echo "======================================================================="
payload='{
  "id": "urn:ngsi-ld:City:E1",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Toledo"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-4.035825, 39.867459]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 at Alcala (too close ~29km) - no notification"
echo "=================================================================="
payload='{
  "id": "urn:ngsi-ld:City:E2",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Alcala de Henares"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-3.363532, 40.481784]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 at Barcelona (too far ~506km) - no notification"
echo "===================================================================="
payload='{
  "id": "urn:ngsi-ld:City:E3",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Barcelona"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.154006, 41.366656]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "05. Create entity E4 at Segovia (in donut ~68km) - notification expected"
echo "========================================================================"
payload='{
  "id": "urn:ngsi-ld:City:E4",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Segovia"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-4.117588, 40.948010]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "06. Dump ftClient - see 2 notifications: E1 (Toledo) and E4 (Segovia)"
echo "======================================================================"
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ near;maxDistance==100000;minDistance==50000
===============================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 at Toledo (in donut ~69km) - notification expected
=======================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E1



03. Create entity E2 at Alcala (too close ~29km) - no notification
==================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E2



04. Create entity E3 at Barcelona (too far ~506km) - no notification
====================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E3



05. Create entity E4 at Segovia (in donut ~68km) - notification expected
========================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E4



06. Dump ftClient - see 2 notifications: E1 (Toledo) and E4 (Segovia)
======================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST http://REGEX(.*)/notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
Ngsild-Attribute-Format: Normalized

{
    "data": [
        {
            "id": "urn:ngsi-ld:City:E1",
            "location": {
                "type": "GeoProperty",
                "value": {
                    "coordinates": [
                        -4.035825,
                        39.867459
                    ],
                    "type": "Point"
                }
            },
            "name": {
                "type": "Property",
                "value": "Toledo"
            },
            "type": "City"
        }
    ],
    "id": "urn:ngsi-ld:Notification:REGEX(.*)",
    "notifiedAt": "REGEX(.*)",
    "subscriptionId": "urn:ngsi-ld:Subscription:S1",
    "type": "Notification"
}
=======================================
