# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Pagination with large offset and big entities (allowDiskUse test)

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental -pageSize 100

typeset -i eNo
eNo=1

# Create 2000 entities with VERY large payloads to exceed MongoDB's sort memory limit (100 MB)
# Each entity is ~80KB, so 2000 entities = ~160MB which will trigger memory limit during sort+skip
while [ $eNo -le 2000 ]
do
  eId=$(printf "urn:ngsi-ld:entities:E%05d" $eNo)
  
  # Generate a 50KB string of data per attribute
  LARGE_DATA=$(printf "x%.0s" {1..50000})
  
  # Create large payload with multiple attributes - each entity will be ~70-80KB
  payload='{
    "id": "'$eId'",
    "type": "LargeEntity",
    "A1": {
      "type": "Property",
      "value": "E'$eNo':A1-'$LARGE_DATA'"
    },
    "A2": {
      "type": "Property",
      "value": "E'$eNo':A2-'$LARGE_DATA'"
    },
    "description": {
      "type": "Property",
      "value": "Large entity number '$eNo' with significant payload size to trigger MongoDB sort memory limits when using offset and sort on large result sets. This text helps pad the document size. '$LARGE_DATA'"
    },
    "timestamp": {
      "type": "Property",
      "value": '$eNo'
    }
  }'
  orionCurl --url /ngsi-ld/v1/entities --payload "$payload" > /dev/null 2>&1
  eNo=$eNo+1
done

--SHELL--

#
# 01. Query entities without offset - should return first 100 entities (pageSize)
# 02. Query entities with offset=500 and limit=50 - should return 50 entities (tests sorting with large offset on 2000 large entities)
# 03. Query entities with offset=1000 and limit=50 - should return 50 entities (medium offset with large payload)
# 04. Query entities with offset=1800 and limit=200 - should return 200 entities (large offset with large payload - tests allowDiskUse)
#

echo "01. Query entities without offset - should return first 100 entities (pageSize)"
echo "==============================================================================="
orionCurl --url /ngsi-ld/v1/entities?type=LargeEntity | grep '"id"'
echo
echo


echo "02. Query entities with offset=500 and limit=50 - should return 50 entities (tests sorting with large offset on 2000 large entities)"
echo "===================================================================================================================================="
orionCurl --url '/ngsi-ld/v1/entities?type=LargeEntity&offset=500&limit=50' | grep '"id"'
echo
echo


echo "03. Query entities with offset=1000 and limit=50 - should return 50 entities (medium offset with large payload)"
echo "==============================================================================================================="
orionCurl --url '/ngsi-ld/v1/entities?type=LargeEntity&offset=1000&limit=50' | grep '"id"'
echo
echo


echo "04. Query entities with offset=1800 and limit=200 - should return 200 entities (large offset with large payload - tests allowDiskUse)"
echo "====================================================================================================================================="
orionCurl --url '/ngsi-ld/v1/entities?type=LargeEntity&offset=1800&limit=200' | grep '"id"'
echo
echo


--REGEXPECT--
