--NAME--
POST /entities/{id}/attrs with datasetId instances is rejected (501) without corrupting the entity

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--

#
# POST /entities/{entityId}/attrs does not implement datasetId instances. An
# attribute carrying a datasetId, or an array of instances, must be rejected with
# 501 - and must NOT modify the entity. (Before the fix an EMPTY attribute was
# written over the stored default instance, and the broker then crashed trying to
# render the updated entity for notifications.)
#
# 01. POST E1 with A = [ default(0), D1(1) ]
# 02. POST /attrs with a D2 instance of A -> 501 Not Implemented
# 03. POST /attrs with an array of A instances -> 501 Not Implemented
# 04. GET E1 -> 200, entity intact (default 0, D1 1)
# 05. POST /attrs with a plain attribute B -> 204 (the ordinary path still works)
# 06. GET E1 -> 200, A intact + B
#

echo "01. POST E1 (A: default + D1)"
echo "============================="
payload='{
  "id": "urn:ngsi-ld:E1",
  "type": "T",
  "A": [
    { "type": "Property", "value": 0 },
    { "type": "Property", "value": 1, "datasetId": "urn:ngsi-ld:dataset:D1" }
  ]
}'
orionCurl --url /ngsi-ld/v1/entities -X POST --payload "$payload"
echo
echo


echo "02. POST /attrs with a D2 instance of A -> 501"
echo "=============================================="
payload='{ "A": { "type": "Property", "value": 2, "datasetId": "urn:ngsi-ld:dataset:D2" } }'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs -X POST --payload "$payload"
echo
echo


echo "03. POST /attrs with an array of A instances -> 501"
echo "==================================================="
payload='{
  "A": [
    { "type": "Property", "value": 10 },
    { "type": "Property", "value": 12, "datasetId": "urn:ngsi-ld:dataset:D2" }
  ]
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs -X POST --payload "$payload"
echo
echo


echo "04. GET E1 - 200, entity intact"
echo "==============================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1
echo
echo


echo "05. POST /attrs with a plain attribute B -> 204"
echo "==============================================="
payload='{ "B": { "type": "Property", "value": 3 } }'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1/attrs -X POST --payload "$payload"
echo
echo


echo "06. GET E1 - 200, A intact + B"
echo "=============================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:E1
echo
echo


--REGEXPECT--
01. POST E1 (A: default + D1)
=============================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:E1



02. POST /attrs with a D2 instance of A -> 501
==============================================
HTTP/1.1 501 Not Implemented
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "datasetId instances are not supported by POST /entities/{entityId}/attrs",
    "title": "Not Implemented",
    "type": "https://uri.etsi.org/ngsi-ld/errors/OperationNotSupported"
}


03. POST /attrs with an array of A instances -> 501
===================================================
HTTP/1.1 501 Not Implemented
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "datasetId instances are not supported by POST /entities/{entityId}/attrs",
    "title": "Not Implemented",
    "type": "https://uri.etsi.org/ngsi-ld/errors/OperationNotSupported"
}


04. GET E1 - 200, entity intact
===============================
HTTP/1.1 200 OK
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"

{
    "A": [
        {
            "type": "Property",
            "value": 0
        },
        {
            "datasetId": "urn:ngsi-ld:dataset:D1",
            "type": "Property",
            "value": 1
        }
    ],
    "id": "urn:ngsi-ld:E1",
    "type": "T"
}


05. POST /attrs with a plain attribute B -> 204
===============================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



06. GET E1 - 200, A intact + B
==============================
HTTP/1.1 200 OK
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld>; rel="http://www.w3.org/ns/json-ld#context"; type="application/ld+json"

{
    "A": [
        {
            "type": "Property",
            "value": 0
        },
        {
            "datasetId": "urn:ngsi-ld:dataset:D1",
            "type": "Property",
            "value": 1
        }
    ],
    "B": {
        "type": "Property",
        "value": 3
    },
    "id": "urn:ngsi-ld:E1",
    "type": "T"
}


--TEARDOWN--
brokerStop CB
dbDrop CB
