# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Update an entity attribute (that is a VocabProperty) using PATCH

--SHELL-INIT--
dbInit CB
orionldStart CB -experimental

--SHELL--
#
# 01. Create an entity E1 with a property v1 that is a vocab string
# 01b. See the entity in the database
# 02. PATCH E1/v1 making v1 a vocab array of string
# 02b. See the entity in the database
# 03. GET E1 and see the new v1
#

echo "01. Create an entity E1 with a property v1 that is a vocab string"
echo "================================================================="
payload='{
  "id": "urn:E1",
  "type": "T",
  "v1": {
    "type": "VocabularyProperty",
    "vocab": "sensor"
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "01b. See the entity in the database"
echo "==================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "02. PATCH E1/v1 making v1 a vocab array of string"
echo "================================================="
payload='{
  "vocab": [ "sensor1", "actuator" ]
}'
orionCurl --url /ngsi-ld/v1/entities/urn:E1/attrs/v1 -X PATCH --payload "$payload"
echo
echo


echo "02b. See the entity in the database"
echo "==================================="
mongoCmd2 ftest "db.entities.findOne()"
echo
echo


echo "03. GET E1 and see the new v1"
echo "============================="
orionCurl --url '/ngsi-ld/v1/entities/urn:E1?prettyPrint=yes' --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create an entity E1 with a property v1 that is a vocab string
=================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:E1



01b. See the entity in the database
===================================
MongoDB shell version REGEX(.*)
connecting to: mongodb://localhost:27017/ftest?compressors=disabled&gssapiServiceName=mongodb
MongoDB server version: REGEX(.*)
{
	"_id" : {
		"id" : "urn:E1",
		"type" : "https://uri.etsi.org/ngsi-ld/default-context/T",
		"servicePath" : "/"
	},
	"attrNames" : [
		"https://uri.etsi.org/ngsi-ld/default-context/v1"
	],
	"attrs" : {
		"https://uri=etsi=org/ngsi-ld/default-context/v1" : {
			"type" : "VocabProperty",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : "https://uri.etsi.org/ngsi-ld/default-context/sensor",
			"mdNames" : [ ]
		}
	},
	"creDate" : REGEX(.*),
	"modDate" : REGEX(.*),
	"lastCorrelator" : ""
}
bye


02. PATCH E1/v1 making v1 a vocab array of string
=================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



02b. See the entity in the database
===================================
MongoDB shell version REGEX(.*)
connecting to: mongodb://localhost:27017/ftest?compressors=disabled&gssapiServiceName=mongodb
MongoDB server version: REGEX(.*)
{
	"_id" : {
		"id" : "urn:E1",
		"type" : "https://uri.etsi.org/ngsi-ld/default-context/T",
		"servicePath" : "/"
	},
	"attrNames" : [
		"https://uri.etsi.org/ngsi-ld/default-context/v1"
	],
	"attrs" : {
		"https://uri=etsi=org/ngsi-ld/default-context/v1" : {
			"type" : "VocabProperty",
			"creDate" : REGEX(.*),
			"modDate" : REGEX(.*),
			"value" : [
				"https://uri.etsi.org/ngsi-ld/default-context/sensor1",
				"https://uri.etsi.org/ngsi-ld/default-context/actuator"
			],
			"mdNames" : [ ]
		}
	},
	"creDate" : REGEX(.*),
	"modDate" : REGEX(.*),
	"lastCorrelator" : ""
}
bye


03. GET E1 and see the new v1
=============================
HTTP/1.1 200 OK
Content-Length: 135
Content-Type: application/json
Date: REGEX(.*)
Link: REGEX(.*)

{
  "id": "urn:E1",
  "type": "T",
  "v1": {
    "type": "VocabProperty",
    "vocab": [
      "sensor1",
      "actuator"
    ]
  }
}



--TEARDOWN--
brokerStop CB
dbDrop CB
