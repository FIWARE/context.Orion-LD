# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Test of orionld version service, with branch name

#
# 'kjson version' is asserted LITERALLY here, unlike its neighbours.
#
# The k-libs are pinned per release branch in several different places, and they
# drifted apart once already: the docker base image sat on kjson release/0.11
# while everything else had moved to 0.11.1, so every image built from that base
# was missing three bug fixes - and nothing noticed, because every k-lib version
# in the test suite was REGEX'd. This one line is what notices.
#
# When kjson is bumped, this test fails and the pin in
# docker/build-ubi/04.install-k-libs.sh is what to check.
#

--SHELL-INIT--
dbInit CB
orionldStart CB -troe

--SHELL--

#
# 01. GET /ngsi-ld/ex/v1/version
# 02. Make sure the branch output from Step 01 is the same as current branch
#


echo "01. GET /ngsi-ld/ex/v1/version"
echo "=============================="
orionCurl --url /ngsi-ld/ex/v1/version --noPayloadCheck
echo
echo


echo "02. Make sure the branch output from Step 01 is the same as current branch"
echo "=========================================================================="
branchAccordingToBroker=$(echo $_response | awk -F\"branch\" '{ print $2 }' | awk -F\" '{ print $2 }')
branchAccordingToGit=$(git branch  2> /dev/null | grep ^\* | awk '{ print $2 }') 
if [ "$branchAccordingToBroker" != "$branchAccordingToGit" ]
then
  echo "Branch According To Git:    $branchAccordingToGit"
  echo "Branch According To Broker: $branchAccordingToBroker"
else
  echo Branch is OK
fi
echo
echo


--REGEXPECT--
01. GET /ngsi-ld/ex/v1/version
==============================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)

{
  "Core Context": "https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)",
  "Next File Descriptor": REGEX(.*),
  "Orion-LD version": REGEX(.*),
  "based on orion": "1.15.0-next",
  "boost version": REGEX(.*),
  "branch": REGEX(.*),
  "bson version": "2.2.2",
  "cached subscriptions": 0,
  "geos version": "REGEX(.*)",
  "kalloc version": "REGEX(.*)",
  "kbase version": "REGEX(.*)",
  "khash version": "REGEX(.*)",
  "kjson version": "0.12.0",
  "kprom version": "0.1.0",
  "ktrace version": "REGEX(.*)",
  "libcurl version": REGEX(.*),
  "libuuid version": REGEX(.*),
  "microhttpd version": "1.0.2-0",
  "mongoc version": "2.2.2",
  "mongocpp version": "REGEX((1.1.2|1.1.3))",
  "mongodb server version": "REGEX(.*)",
  "openssl version": REGEX(.*),
  "postgres libpq version": "REGEX(.*)",
  "postgres server version": "REGEX(.*)",
  "rapidjson version": REGEX(.*)
}



02. Make sure the branch output from Step 01 is the same as current branch
==========================================================================
Branch is OK


--TEARDOWN--
brokerStop CB
dbDrop CB
