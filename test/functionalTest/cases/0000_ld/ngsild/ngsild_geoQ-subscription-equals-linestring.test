# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ equals LineString - entity linestring must be identical to subscription linestring

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription with georel "equals" and a LineString from Madrid to Toledo.
# Only entities whose linestring is identical should trigger notifications.
#
# Subscription linestring (lon, lat):
#   (-3.691944, 40.418889), (-4.035825, 39.867459)
#
# 01. Create subscription S1 with geoQ equals LineString
# 02. Create entity E1 with exact same linestring - MATCH
# 03. Create entity E2 with different linestring Paris-Berlin - NO MATCH
# 04. Create entity E3 with same endpoints but extra waypoint - NO MATCH
# 05. Dump ftClient - see 1 notification: E1 only
#


echo "01. Create subscription S1 with geoQ equals LineString"
echo "======================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Route"
    }
  ],
  "geoQ": {
    "georel": "equals",
    "geometry": "LineString",
    "coordinates": [[-3.691944, 40.418889], [-4.035825, 39.867459]],
    "geoproperty": "location"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 with exact same linestring - MATCH"
echo "======================================================="
payload='{
  "id": "urn:ngsi-ld:Route:E1",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Madrid-Toledo"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-3.691944, 40.418889], [-4.035825, 39.867459]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 with different linestring Paris-Berlin - NO MATCH"
echo "======================================================================"
payload='{
  "id": "urn:ngsi-ld:Route:E2",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Paris-Berlin"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[2.352222, 48.856614], [13.404954, 52.520008]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 with same endpoints but extra waypoint - NO MATCH"
echo "======================================================================"
payload='{
  "id": "urn:ngsi-ld:Route:E3",
  "type": "Route",
  "name": {
    "type": "Property",
    "value": "Madrid-Toledo-via"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "LineString",
      "coordinates": [[-3.691944, 40.418889], [-3.8, 40.1], [-4.035825, 39.867459]]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "05. Dump ftClient - see 1 notification: E1 only"
echo "================================================"
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ equals LineString
=======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 with exact same linestring - MATCH
=======================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E1



03. Create entity E2 with different linestring Paris-Berlin - NO MATCH
======================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E2



04. Create entity E3 with same endpoints but extra waypoint - NO MATCH
======================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:Route:E3



05. Dump ftClient - see 1 notification: E1 only
================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST http://REGEX(.*)/notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Content-Type: application/json
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
Ngsild-Attribute-Format: Normalized

{
    "data": [
        {
            "id": "urn:ngsi-ld:Route:E1",
            "location": {
                "type": "GeoProperty",
                "value": {
                    "coordinates": [
                        [
                            -3.691944,
                            40.418889
                        ],
                        [
                            -4.035825,
                            39.867459
                        ]
                    ],
                    "type": "LineString"
                }
            },
            "name": {
                "type": "Property",
                "value": "Madrid-Toledo"
            },
            "type": "Route"
        }
    ],
    "id": "urn:ngsi-ld:Notification:REGEX(.*)",
    "notifiedAt": "REGEX(.*)",
    "subscriptionId": "urn:ngsi-ld:Subscription:S1",
    "type": "Notification"
}
=======================================



--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
