# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Subscription with geoQ near;maxDistance using custom geoproperty (not location)

--SHELL-INIT--
dbInit CB
orionldStart CB -mongocOnly
$REPO_HOME/scripts/configFile.sh > ~/.ftClient
chmod 777 ~/.ftClient
ftClientStart -v -t 200

--SHELL--

#
# Subscription centered at Madrid (lon=-3.691944, lat=40.418889) with maxDistance 100km.
# Using custom geoproperty "observationPoint" instead of default "location".
#
# Points inside (< 100km from Madrid):
#   Toledo:       lon=-4.035825, lat=39.867459  (~69km)
#
# Points outside (> 100km from Madrid):
#   Barcelona:    lon=2.154006,  lat=41.366656  (~506km)
#
# 01. Create subscription S1 with geoQ near;maxDistance==100000, geoproperty=observationPoint
# 02. Create entity E1 at Toledo with observationPoint (inside) - notification expected
# 03. Create entity E2 at Barcelona with observationPoint (outside) - no notification
# 04. Create entity E3 at Toledo with location (inside distance, but wrong geoproperty) - no notification
# 05. Dump ftClient - see 1 notification: E1 only
#


echo "01. Create subscription S1 with geoQ near;maxDistance==100000, geoproperty=observationPoint"
echo "=========================================================================================="
payload='{
  "id": "urn:ngsi-ld:Subscription:S1",
  "type": "Subscription",
  "entities": [
    {
      "type": "City"
    }
  ],
  "geoQ": {
    "georel": "near;maxDistance==100000",
    "geometry": "Point",
    "coordinates": [-3.691944, 40.418889],
    "geoproperty": "observationPoint"
  },
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify",
      "accept": "application/json"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "02. Create entity E1 at Toledo with observationPoint (inside) - notification expected"
echo "===================================================================================="
payload='{
  "id": "urn:ngsi-ld:City:E1",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Toledo"
  },
  "observationPoint": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-4.035825, 39.867459]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "03. Create entity E2 at Barcelona with observationPoint (outside) - no notification"
echo "==================================================================================="
payload='{
  "id": "urn:ngsi-ld:City:E2",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Barcelona"
  },
  "observationPoint": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [2.154006, 41.366656]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


echo "04. Create entity E3 at Toledo with location (inside distance, but wrong geoproperty) - no notification"
echo "======================================================================================================="
payload='{
  "id": "urn:ngsi-ld:City:E3",
  "type": "City",
  "name": {
    "type": "Property",
    "value": "Toledo-wrong-geo"
  },
  "location": {
    "type": "GeoProperty",
    "value": {
      "type": "Point",
      "coordinates": [-4.035825, 39.867459]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
echo
echo


sleep .1
echo "05. Dump ftClient - see 1 notification: E1 only"
echo "================================================"
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Create subscription S1 with geoQ near;maxDistance==100000, geoproperty=observationPoint
==========================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/subscriptions/urn:ngsi-ld:Subscription:S1



02. Create entity E1 at Toledo with observationPoint (inside) - notification expected
====================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E1



03. Create entity E2 at Barcelona with observationPoint (outside) - no notification
===================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E2



04. Create entity E3 at Toledo with location (inside distance, but wrong geoproperty) - no notification
=======================================================================================================
HTTP/1.1 201 Created
Content-Length: 0
Date: REGEX(.*)
Location: /ngsi-ld/v1/entities/urn:ngsi-ld:City:E3



05. Dump ftClient - see 1 notification: E1 only
================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

POST /notify?subscriptionId=urn:ngsi-ld:Subscription:S1
Content-Length: REGEX(\d+)
Content-Type: application/json
User-Agent: orionld/REGEX(.*)
Host: REGEX(.*)
Accept: application/json
Ngsild-Attribute-Format: Normalized
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
  "id": "urn:ngsi-ld:Notification:REGEX(.*)",
  "type": "Notification",
  "subscriptionId": "urn:ngsi-ld:Subscription:S1",
  "notifiedAt": "REGEX(.*)",
  "data": [
    {
      "id": "urn:ngsi-ld:City:E1",
      "type": "City",
      "name": {
        "type": "Property",
        "value": "Toledo"
      },
      "observationPoint": {
        "type": "GeoProperty",
        "value": {
          "type": "Point",
          "coordinates": [
            -4.035825,
            39.867459
          ]
        }
      }
    }
  ]
}



--TEARDOWN--
brokerStop CB
ftClientStop
dbDrop CB
