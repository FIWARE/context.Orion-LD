# VALGRIND_READY

#
# ?ddsSync=false explicit override: broker default (with ddsSupport on) is
# sync, but the caller can opt out per-request and get today's fire-and-forget
# semantics. PATCH returns 204 right away with no reply merged; the reply
# arrives asynchronously a moment later.
#

--NAME--
DDS Service: ?ddsSync=false overrides the broker default and keeps fire-and-forget

--SHELL-INIT--
ddsClean

$REPO_HOME/scripts/configFile.sh \
  --ddsService "add_two_ints,Calculator,urn:ngsi-ld:calc:1,operation" \
  --ddsTypesDirectory "$REPO_HOME/test/functionalTest/ddsTypes" \
  > $HOME/.orionld

ros2ServiceStart --service add_two_ints --samples 10
sleep 5

dbInit CB
orionldStart CB -mongocOnly -wip dds

sleep 5

--SHELL--
valgrindSleep 5

#
# 01. PATCH with ?ddsSync=false
# 02. GET entity WITHOUT sleep - reply sub-attr must NOT yet be present
# 03. Sleep + GET - reply sub-attr must eventually arrive via the async path
#

echo "01. PATCH operation attribute with ddsSync=false"
echo "================================================="
payload='{
  "operation": {
    "type": "Property",
    "value": {
      "a": 2,
      "b": 3
    }
  }
}'
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?ddsSync=false' -X PATCH --payload "$payload"
echo
echo


echo "02. GET immediately (reply must NOT yet be merged)"
echo "==================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?options=concise
echo
echo


echo "03. Sleep and GET again - reply must have arrived asynchronously"
echo "================================================================="
sleep 2
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?options=concise
echo
echo


--REGEXPECT--
01. PATCH operation attribute with ddsSync=false
=================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



02. GET immediately (reply must NOT yet be merged)
===================================================
HTTP/1.1 200 OK
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": "fastdds",
    "id": "urn:ngsi-ld:calc:1",
    "operation": {
        "a": 2,
        "b": 3
    },
    "type": "Calculator"
}


03. Sleep and GET again - reply must have arrived asynchronously
=================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": "fastdds",
    "id": "urn:ngsi-ld:calc:1",
    "operation": {
        "reply": {
            "ddsDataType": "example_interfaces::srv::dds_::AddTwoInts_Response_",
            "participantId": "REGEX([0-9a-f.]+)",
            "publishedAt": REGEX(-?\d+),
            "requestId": 1,
            "value": {
                "sum": 5
            },
            "xId": "REGEX([0-9a-f.]+)"
        },
        "request": {
            "ddsDataType": "example_interfaces::srv::dds_::AddTwoInts_Request_",
            "publishedAt": REGEX(\d+),
            "requestId": 1,
            "value": {
                "a": 2,
                "b": 3
            }
        },
        "value": {
            "a": 2,
            "b": 3
        }
    },
    "type": "Calculator"
}


--TEARDOWN--
ddsClean
ros2ServiceStop
brokerStop CB
dbDrop CB
rm -f $HOME/.orionld
