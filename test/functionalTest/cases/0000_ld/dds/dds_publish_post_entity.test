# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
The broker pushes to DDS via POST /entities/{entityId}/attrs

--SHELL-INIT--
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.orionld
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.ftClient
dbInit CB
orionldStart CB -mongocOnly -wip dds
ftClientStart -t 0-5000 --dds

--SHELL--

#
# 01. Ask FT to publish an entity urn:ngsi-ld:camera:cam1 on topic 'P1'
# 02. GET urn:ngsi-ld:camera:cam1 from CB
# 03. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value
# 04. GET urn:ngsi-ld:camera:cam1 from CB, see the update
# 05. Dump/Reset the ftClient for DDS notifications - see the PATCH in DDS
# 06. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value + one more => no publish
# 07. GET urn:ngsi-ld:camera:cam1 from CB, see the update
# 08. Dump/Reset the ftClient for DDS notifications - see no PATCH in DDS
# 09. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value except for one missing field - no publish
# 10. GET urn:ngsi-ld:camera:cam1 from CB, see the update
# 11. Dump the ftClient for DDS notifications - see no update in DDS
# 12. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value - DDS publish
# 13. Dump/Reset the ftClient for DDS notifications - see the update in DDS
#

echo "01. Ask FT to publish an entity urn:ngsi-ld:camera:cam1 on topic 'P1'"
echo "====================================================================="
payload='{
  "s": "step 01"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:ngsi-ld:camera:cam1&entityType=T&ddsTopicName=P1' --port $FT_PORT --payload "$payload"

# The ftClient gets a callback on the topic for its own request - deleting it
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck -X DELETE


echo "02. GET urn:ngsi-ld:camera:cam1 from CB"
echo "======================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1
echo
echo


echo "03. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value"
echo "========================================================================="
payload='{
  "shutterSpeed": {
    "value": {
      "s": "step 03",
      "i": 3,
      "f": 3.3,
      "b": true,
      "ia": [ 3, 3 ]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1/attrs --payload "$payload"
echo
echo


echo "04. GET urn:ngsi-ld:camera:cam1 from CB, see the update"
echo "======================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1
echo
echo


echo "05. Dump/Reset the ftClient for DDS notifications - see the PATCH in DDS"
echo "========================================================================"
sleep .1
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck -X DELETE
echo
echo


echo "06. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value + one more => no publish"
echo "=================================================================================================="
payload='{
  "shutterSpeed": {
    "value": {
      "s": "step 06",
      "i": 6,
      "f": 6.6,
      "b": false,
      "ia": [ 6, 6 ],
      "nada": 66
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1/attrs --payload "$payload"
echo
echo


echo "07. GET urn:ngsi-ld:camera:cam1 from CB, see the update"
echo "======================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1
echo
echo


echo "08. Dump/Reset the ftClient for DDS notifications - see no PATCH in DDS"
echo "======================================================================="
sleep .1
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck
echo
echo


echo "09. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value except for one missing field - no publish"
echo "==================================================================================================================="
payload='{
  "shutterSpeed": {
    "value": {
      "s": "step 09",
      "f": 9.9,
      "b": true,
      "ia": [ 9, 9 ]
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1/attrs --payload "$payload"
echo
echo


echo "10. GET urn:ngsi-ld:camera:cam1 from CB, see the update"
echo "======================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1
echo
echo


echo "11. Dump the ftClient for DDS notifications - see no update in DDS"
echo "=================================================================="
sleep .1
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck
echo
echo


echo "12. POST urn:ngsi-ld:camera:cam1, attribute shutterSpeed - complete value - DDS publish"
echo "======================================================================================="
payload='{
  "shutterSpeed": {
    "value": {
      "s": "step 12",
      "f": 12.12,
      "b": false,
      "ia": [ 12, 12 ],
      "i": 12
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1/attrs --payload "$payload"
echo
echo


echo "13. Dump/Reset the ftClient for DDS notifications - see the update in DDS"
echo "========================================================================="
sleep .1
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck -X DELETE
echo
echo


--REGEXPECT--
01. Ask FT to publish an entity urn:ngsi-ld:camera:cam1 on topic 'P1'
=====================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)

HTTP/1.1 200 OK
Content-Length: 0
Date: REGEX(.*)


02. GET urn:ngsi-ld:camera:cam1 from CB
=======================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": {
        "type": "Property",
        "value": "fastdds"
    },
    "id": "urn:ngsi-ld:camera:cam1",
    "shutterSpeed": {
        "ddsDataType": {
            "type": "Property",
            "value": "NgsildSample"
        },
        "participantId": {
            "type": "Property",
            "value": "REGEX(.*)"
        },
        "publishedAt": {
            "type": "Property",
            "value": REGEX(.*)
        },
        "type": "Property",
        "value": {
            "b": false,
            "f": 0,
            "i": 0,
            "ia": [
                1,
                2
            ],
            "s": "step 01"
        },
        "xId": {
            "type": "Property",
            "value": "REGEX(.*)"
        }
    },
    "type": "Camera"
}


