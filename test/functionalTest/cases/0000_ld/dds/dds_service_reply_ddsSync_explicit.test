# VALGRIND_READY

#
# Explicit ?ddsSync=true: the PATCH must block until the DDS reply is merged.
# The GET immediately after the PATCH (no sleep) must already see the reply
# sub-attribute. Requires the ROS2 AdditionServer via ros2ServiceStart.
#

--NAME--
DDS Service: explicit ?ddsSync=true blocks PATCH until reply is merged

--SHELL-INIT--
ddsClean

$REPO_HOME/scripts/configFile.sh \
  --ddsService "add_two_ints,Calculator,urn:ngsi-ld:calc:1,operation" \
  --ddsTypesDirectory "$REPO_HOME/test/functionalTest/ddsTypes" \
  > $HOME/.orionld

ros2ServiceStart --service add_two_ints --samples 10
sleep 5

dbInit CB
orionldStart CB -mongocOnly -wip dds

# Wait for DDS discovery between broker and ROS2 server.
sleep 5

--SHELL--
valgrindSleep 5

#
# 01. PATCH with ?ddsSync=true
# 02. GET entity WITHOUT any sleep - reply sub-attribute must already be present
#

echo "01. PATCH operation attribute with ddsSync=true"
echo "================================================"
payload='{
  "operation": {
    "type": "Property",
    "value": {
      "a": 4,
      "b": 6
    }
  }
}'
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?ddsSync=true' -X PATCH --payload "$payload"
echo
echo


echo "02. GET entity (no sleep - reply must already be merged)"
echo "========================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?options=concise
echo
echo


--REGEXPECT--
01. PATCH operation attribute with ddsSync=true
================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



02. GET entity (no sleep - reply must already be merged)
=========================================================
HTTP/1.1 200 OK
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": "fastdds",
    "id": "urn:ngsi-ld:calc:1",
    "operation": {
        "reply": {
            "ddsDataType": "example_interfaces::srv::dds_::AddTwoInts_Response_",
            "instanceHandleId": "REGEX([0-9a-f.]+)",
            "participantId": "REGEX([0-9a-f.]+)",
            "publishedAt": REGEX(-?\d+),
            "requestId": 1,
            "value": {
                "sum": 10
            }
        },
        "request": {
            "ddsDataType": "example_interfaces::srv::dds_::AddTwoInts_Request_",
            "publishedAt": REGEX(\d+),
            "requestId": 1,
            "value": {
                "a": 4,
                "b": 6
            }
        },
        "value": {
            "a": 4,
            "b": 6
        }
    },
    "type": "Calculator"
}


--TEARDOWN--
ddsClean
ros2ServiceStop
brokerStop CB
dbDrop CB
rm -f $HOME/.orionld
