# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
the test client publishes on DDS, the broker receives DDS notifications and creates/updates the corresponding NGSI-LD entities

--SHELL-INIT--
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.orionld
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.ftClient
dbInit CB
orionldStart CB -mongocOnly -wip dds
ftClientStop
ftClientStart -t 0-5000 -v --dds

--SHELL--

#
# 01. Ask FT to publish an entity urn:ngsi-ld:camera:cam1 on topic 'P1'
# 02. GET urn:ngsi-ld:camera:cam1 from CB
# 03. PATCH urn:ngsi-ld:camera:cam1, attribute shutterSpeed
# 04. GET urn:ngsi-ld:camera:cam1 from CB, see the update
# 05. Dump/Reset the ftClient for DDS notifications - see the PATCH in DDS
# 06. PATCH urn:ngsi-ld:camera:cam1, adding an attribute A1 - nothing published in DDS (A1 is not in config file)
# 07. Dump the ftClient for DDS notifications - see nothing
#

echo "01. Ask FT to publish an entity urn:ngsi-ld:camera:cam1 on topic 'P1'"
echo "====================================================================="
payload='{
  "s": "step 1"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:ngsi-ld:camera:cam1&entityType=T&ddsTopicName=P1' --port $FT_PORT --payload "$payload"

# The ftClient gets a callback on the topic for its own request - deleting it
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck -X DELETE


echo "02. GET urn:ngsi-ld:camera:cam1 from CB"
echo "======================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1
echo
echo


echo "03. PATCH urn:ngsi-ld:camera:cam1, attribute shutterSpeed"
echo "========================================================="
payload='{
  "shutterSpeed": {
    "value": {
      "s": "step 3"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1 -X PATCH --payload "$payload"
echo
echo


echo "04. GET urn:ngsi-ld:camera:cam1 from CB, see the update"
echo "======================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1
echo
echo


echo "05. Dump/Reset the ftClient for DDS notifications - see the PATCH in DDS"
echo "========================================================================"
sleep .01
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck -X DELETE
echo
echo


echo "06. PATCH urn:ngsi-ld:camera:cam1, adding an attribute A1 - nothing published in DDS (A1 is not in config file)"
echo "==============================================================================================================="
payload='{
  "A1": {
    "value": "step 6"
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:camera:cam1 -X PATCH --payload "$payload"
echo
echo


echo "07. Dump the ftClient for DDS notifications - see nothing"
echo "========================================================="
sleep .01
orionCurl --url /dds/dump --port $FT_PORT --noPayloadCheck
echo
echo


--REGEXPECT--
01. Ask FT to publish an entity urn:ngsi-ld:camera:cam1 on topic 'P1'
=====================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)

HTTP/1.1 200 OK
Content-Length: 0
Date: REGEX(.*)


02. GET urn:ngsi-ld:camera:cam1 from CB
=======================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": {
        "type": "Property",
        "value": "fastdds"
    },
    "id": "urn:ngsi-ld:camera:cam1",
    "shutterSpeed": {
        "ddsDataType": {
            "type": "Property",
            "value": "NgsildSample"
        },
        "participantId": {
            "type": "Property",
            "value": "REGEX(.*)"
        },
        "publishedAt": {
            "type": "Property",
            "value": REGEX(.*)
        },
        "type": "Property",
        "value": {
            "b": false,
            "f": 0,
            "i": 0,
            "ia": [
                1,
                2
            ],
            "s": "step 1"
        },
        "xId": {
            "type": "Property",
            "value": "REGEX(.*)"
        }
    },
    "type": "Camera"
}


03. PATCH urn:ngsi-ld:camera:cam1, attribute shutterSpeed
=========================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



04. GET urn:ngsi-ld:camera:cam1 from CB, see the update
=======================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": {
        "type": "Property",
        "value": "fastdds"
    },
    "id": "urn:ngsi-ld:camera:cam1",
    "shutterSpeed": {
        "ddsDataType": {
            "type": "Property",
            "value": "NgsildSample"
        },
        "participantId": {
            "type": "Property",
            "value": "REGEX(.*)"
        },
        "publishedAt": {
            "type": "Property",
            "value": REGEX(.*)
        },
        "type": "Property",
        "value": {
            "b": false,
            "f": 0,
            "i": 0,
            "ia": [
                1,
                2
            ],
            "s": "step 3"
        },
        "xId": {
            "type": "Property",
            "value": "REGEX(.*)"
        }
    },
    "type": "Camera"
}


05. Dump/Reset the ftClient for DDS notifications - see the PATCH in DDS
========================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Date: REGEX(.*)

[
  {
    "P1": {
      "data": {
        "REGEX(.*)": {
          "b": false,
          "f": 0,
          "i": 0,
          "ia": [
            1,
            2
          ],
          "s": "step 3"
        }
      },
      "type": "NgsildSample"
    },
    "id": "REGEX(.*)",
    "type": "fastdds"
  }
]

HTTP/1.1 200 OK
Content-Length: 0
Date: REGEX(.*)




06. PATCH urn:ngsi-ld:camera:cam1, adding an attribute A1 - nothing published in DDS (A1 is not in config file)
===============================================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



07. Dump the ftClient for DDS notifications - see nothing
=========================================================
HTTP/1.1 200 OK
Content-Length: 0
Date: REGEX(.*)




--TEARDOWN--
ftClientStop
brokerStop
dbDrop CB
rm -f $HOME/.orionld
rm -f $HOME/.ftClient
