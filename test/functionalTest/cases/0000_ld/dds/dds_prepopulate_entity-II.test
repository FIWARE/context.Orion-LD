# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Test of pre-population of entities from config file

--SHELL-INIT--
ddsClean
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.orionld
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.ftClient
ftClientStop
ftClientStart -t 0-5000 --dds
ftClientStart -t 0-5000 --port $FT2_PORT --logDir $FT2_LOG_DIR --dds

#
# 01. Ask FT1 to publish on P1 (FT2 will receive?)
# 02. Ask FT2 to publish on P2 (FT1 will receive?)
#
payload='{
  "s": "pre 01"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:ngsi-ld:camera:cam1&entityType=T&ddsTopicName=P1' --port $FT_PORT --payload "$payload"

payload='{
  "s": "pre 02"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:ngsi-ld:camera:cam1&entityType=T&ddsTopicName=P2' --port $FT2_PORT --payload "$payload"


dbInit CB
orionldStart CB -mongocOnly -wip dds

--SHELL--
valgrindSleep 5

#
# 01. GET all entities from the broker
#

# Sleep to allow DDS topic notifications to be processed and add ddsTypeName
sleep 2
valgrindSleep 5

echo "01. GET all entities from the broker"
echo "===================================="
orionCurl --url /ngsi-ld/v1/entities?local=true
echo
echo


--REGEXPECT--
01. GET all entities from the broker
====================================
HTTP/1.1 200 OK
Content-Length: 417
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "armReach": {
            "ddsTypeName": {
                "type": "Property",
                "value": "NgsildSample"
            },
            "type": "Property",
            "value": "uninitialized"
        },
        "ddsType": {
            "type": "Property",
            "value": "fastdds"
        },
        "id": "urn:ngsi-ld:arm:arm1",
        "type": "Arm"
    },
    {
        "ddsType": {
            "type": "Property",
            "value": "fastdds"
        },
        "id": "urn:ngsi-ld:camera:cam1",
        "shutterSpeed": {
            "ddsTypeName": {
                "type": "Property",
                "value": "NgsildSample"
            },
            "type": "Property",
            "value": "uninitialized"
        },
        "type": "Camera"
    }
]


--TEARDOWN--
ddsClean
ftClientStop
ftClientStop --port $FT2_PORT
brokerStop
dbDrop CB
rm -f $HOME/.orionld
rm -f $HOME/.ftClient
