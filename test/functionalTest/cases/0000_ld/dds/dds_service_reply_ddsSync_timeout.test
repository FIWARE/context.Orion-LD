# VALGRIND_READY

#
# ddsSync timeout: no DDS server running, PATCH /entities/{id}?ddsSync=true
# must return 504 Gateway Timeout within ~syncTimeoutMs, and the entity
# must remain unchanged (atomic rollback - no partial write).
#
# NB: no server is configured at all (no ros2ServiceStart, no ftClient).
# The broker still sees the service config (name only) so the attribute
# maps to the service, but send_service_request will hang for no reply
# and the sync timeout fires.
#
# syncTimeoutMs is dialled down to 500ms to keep the test fast.
#

--NAME--
DDS Service: ddsSync=true on a PATCH with no DDS server times out with 504 and rolls back

--SHELL-INIT--
ddsClean

$REPO_HOME/scripts/configFile.sh \
  --ddsService "add_two_ints,Calculator,urn:ngsi-ld:calc:1,operation" \
  --ddsTypesDirectory "$REPO_HOME/test/functionalTest/ddsTypes" \
  --ddsSyncTimeoutMs 500 \
  > $HOME/.orionld

dbInit CB
orionldStart CB -mongocOnly -wip dds

# No DDS server is started.

--SHELL--
valgrindSleep 5

#
# 01. GET entity (baseline - operation.value is "uninitialized" from prepopulation)
# 02. PATCH with ?ddsSync=true - send fails immediately (no discovered server) -> 503.
#     (We never even reach the timeout path when the enabler hasn't discovered a
#     server - send_service_request fails synchronously at the gate.)
# 03. GET entity - must be unchanged (atomic rollback)
#

echo "01. GET entity (baseline)"
echo "========================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?options=concise
echo
echo


echo "02. PATCH with ddsSync=true - no DDS server, expect 503"
echo "========================================================"
payload='{
  "operation": {
    "type": "Property",
    "value": {
      "a": 9,
      "b": 9
    }
  }
}'
orionCurl --url '/ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?ddsSync=true' -X PATCH --payload "$payload"
echo
echo


echo "03. GET entity (must be unchanged - atomic rollback)"
echo "====================================================="
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:calc:1?options=concise
echo
echo


--REGEXPECT--
01. GET entity (baseline)
=========================
HTTP/1.1 200 OK
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": "fastdds",
    "id": "urn:ngsi-ld:calc:1",
    "operation": "uninitialized",
    "type": "Calculator"
}


02. PATCH with ddsSync=true - no DDS server, expect 503
========================================================
HTTP/1.1 503 Service Unavailable
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)

{
    "detail": "add_two_ints",
    "title": "DDS service unavailable",
    "type": "https://uri.etsi.org/ngsi-ld/errors/InternalError"
}


03. GET entity (must be unchanged - atomic rollback)
=====================================================
HTTP/1.1 200 OK
Content-Length: REGEX(\d+)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

{
    "ddsType": "fastdds",
    "id": "urn:ngsi-ld:calc:1",
    "operation": "uninitialized",
    "type": "Calculator"
}


--TEARDOWN--
ddsClean
brokerStop CB
dbDrop CB
rm -f $HOME/.orionld
