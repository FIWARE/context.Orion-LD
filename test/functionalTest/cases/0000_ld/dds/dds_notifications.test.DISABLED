# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
the test client publishes on DDS, the broker receives DDS notifications and creates/updates the corresponding NGSI-LD entities

--SHELL-INIT--
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.orionld
$REPO_HOME/scripts/configFile.sh --ddsTopic "P1,Camera,urn:ngsi-ld:camera:cam1,shutterSpeed" --ddsTopic "P2,Arm,urn:ngsi-ld:arm:arm1,armReach" > $HOME/.ftClient
dbInit CB
pgInit $CB_DB_NAME
orionldStart CB -mongocOnly -wip dds -troe -kt 0-5000
ftClientStart -t 0-5000

--SHELL--

#
# 01. Ask FT to publish an entity urn:E1 on topic 'P1'
# 02. Ask FT to publish an entity urn:E2 on topic 'P2'
# 03. Ask FT to publish an entity urn:E3 on topic 'P3'
# 04. Ask FT to publish an entity urn:E4 on topic 'P4'
# 05. Query the broker for all its entities, see three (urn:ngsi-ld:camera:cam1, urn:ngsi-ld:arm:arm1, and the default entity)
#
# 06. Create a subscription for entity type 'Camera', to be received by the ftClient
# 07. Ask FT to publish an entity urn:E1 on topic 'P1' - to provoke a notification to ftClient
# 08. Ping broker to make sure it's still OK (issue XXX says it dies)
# 09. Dump the ftClient to see the notification
#
# 10. See entities in the temporal database (urn:ngsi-ld:camera:cam1+urn:ngsi-ld:arm:arm1)
# 11. See attributes in the temporal database
#
# Later:
# 21. Kill the broker and empty its database, then restart the broker again
# 22. Query the broker for all its entities, see all three - should be present due to the DDS discovery 
#

echo "01. Ask FT to publish an entity urn:E1 on topic 'P1'"
echo "===================================================="
payload='{
  "s": "step 01"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:E1&entityType=T&ddsTopicName=P1' --port $FT_PORT --payload "$payload"
echo
echo


echo "02. Ask FT to publish an entity urn:E2 on topic 'P2'"
echo "===================================================="
sleep .1
payload='{
  "i": 2,
  "s": "step 02"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:E2&entityType=T&ddsTopicName=P2' --port $FT_PORT --payload "$payload"
echo
echo


echo "03. Ask FT to publish an entity urn:E3 on topic 'P3'"
echo "===================================================="
sleep .1
payload='{
  "f": 3.14,
  "s": "step 03"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:E3&entityType=T&ddsTopicName=P3' --port $FT_PORT --payload "$payload"
echo
echo


echo "04. Ask FT to publish an entity urn:E4 on topic 'P4'"
echo "===================================================="
sleep .1
payload='{
  "s": "step 04",
  "i": 4,
  "f": 4.14
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:E4&entityType=T&ddsTopicName=P4' --port $FT_PORT --payload "$payload"
echo
echo


echo "05. Query the broker for all its entities, see three (urn:ngsi-ld:camera:cam1, urn:ngsi-ld:arm:arm1, and the default entity)"
echo "============================================================================================================================"
sleep 4
orionCurl --url /ngsi-ld/v1/entities?local=true
echo
echo


echo "06. Create a subscription for entity type 'Camera', to be received by the ftClient"
echo "=================================================================================="
payload='{
  "id": "urn:s1",
  "type": "Subscription",
  "entities": [
    {
      "type": "Camera"
    }
  ],
  "notification": {
    "endpoint": {
      "uri": "http://127.0.0.1:'${FT_PORT}'/notify"
    }
  }
}'
orionCurl --url /ngsi-ld/v1/subscriptions --payload "$payload"
echo
echo


echo "07. Ask FT to publish an entity urn:E1 on topic 'P1' - to provoke a notification to ftClient"
echo "============================================================================================"
payload='{
  "s": "step 07"
}'
orionCurl --url '/dds/pub?ddsTopicType=xyz&entityId=urn:E1&entityType=T&ddsTopicName=P1' --port $FT_PORT --payload "$payload"
echo
echo


echo "08. Ping broker to make sure it's still OK (issue XXX says it dies)"
echo "==================================================================="
orionCurl --url /ngsi-ld/ex/v1/version
echo
echo


echo "09. Dump the ftClient to see the notification"
echo "============================================="
sleep 2
orionCurl --url /dump --port $FT_PORT --noPayloadCheck
echo
echo


echo "10. See entities in the temporal database (urn:ngsi-ld:camera:cam1+urn:ngsi-ld:arm:arm1)"
echo "========================================================================================"
postgresCmd -sql "SELECT opMode,id,type,ts FROM entities"
echo
echo


echo "11. See attributes in the temporal database"
echo "==========================================="
postgresCmd -sql "SELECT opMode,id,valueType,entityId,subProperties,unitcode,datasetid,text,number,boolean,observedAt,ts FROM attributes"
echo
echo


# echo "21. Kill the broker and empty its database, then restart the broker again"
# echo "========================================================================="
# brokerStop
# dbInit CB > /dev/null
# orionldStart CB -mongocOnly -wip dds  -ddsConfigFile /tmp/ddsConfig > /dev/null
# echo Orion-LD is running again
# echo
# echo


# echo "22. Query the broker for all its entities, see all three - should be present due to the DDS discovery "
# echo "======================================================================================================"
# orionCurl --url /ngsi-ld/v1/entities?local=true
# echo
# echo


