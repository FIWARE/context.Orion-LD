# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Test of pre-population of services from DDS

--SHELL-INIT--
$REPO_HOME/scripts/configFile.sh --ddsService "add_two_ints,Service,urn:ngsi-ld:two-ints,dds_add_two_ints" > $HOME/.orionld
dbInit CB
orionldStart CB -mongocOnly -wip dds,entityMaps

--SHELL--

#
# Before starting the broker (meaning, before running this test), prepare this way:
#   docker run -it --rm --net=host --ipc=host --privileged -e DISPLAY=$DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix eprosima/vulcanexus:jazzy-desktop
#   source /opt/vulcanexus/jazzy/setup.bash
#   ros2 run demo_nodes_cpp add_two_ints_server
#
# That way, when the broker starts, 8 services enters the broker via DDS callbacks.
# If in the config file (only 'add_two_ints_server/list_parameters' is there), the entity/attribute is created. If not, the serviceName is used
# as attribute name and added to the default DDS entity.
#
# After startup, the broker is queried for all its entities - two are found (urn:ngsi-ld:two-ints and urn:ngsi-ld:dds:default)
#
# 01. GET all entities from the broker - to check the prepopulation (the test fails if demo_nodes_cpp is running)
# 02. PATCH add_two_ints-listParams of the entity urn:ngsi-ld:two-ints - triggers a service where the broker is the client
#

echo "01. GET all entities from the broker - to check the prepopulation (the test fails if demo_nodes_cpp is running)"
echo "==============================================================================================================="
orionCurl --url /ngsi-ld/v1/entities?local=true
echo
echo


echo "02. PATCH add_two_ints-listParams of the entity urn:ngsi-ld:two-ints - triggers a service where the broker is the client"
echo "========================================================================================================================"
payload='{
  "dds_add_two_ints": {
    "value": {
      "a": 6,
      "b": 9
    }
  }
}'
orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:two-ints?local=true --payload "$payload" -X PATCH
echo
echo


--REGEXPECT--
01. GET all entities from the broker - to check the prepopulation (the test fails if demo_nodes_cpp is running)
===============================================================================================================
HTTP/1.1 200 OK
Content-Length: REGEX(.*)
Content-Type: application/json
Date: REGEX(.*)
Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)

[
    {
        "ddsType": {
            "type": "Property",
            "value": "fastdds"
        },
        "dds_add_two_ints": {
            "type": "Property",
            "value": "uninitialized"
        },
        "id": "urn:ngsi-ld:two-ints",
        "type": "Service"
    }
]


02. PATCH add_two_ints-listParams of the entity urn:ngsi-ld:two-ints - triggers a service where the broker is the client
========================================================================================================================
HTTP/1.1 204 No Content
Date: REGEX(.*)



--TEARDOWN--
brokerStop
dbDrop CB
#rm -f $HOME/.orionld
