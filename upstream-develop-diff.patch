---NAME--
-Kafka consumer ingestion - entity updates via Kafka topic are persisted in MongoDB and TRoE
-
---SHELL-INIT--
-export BROKER=orionld
-dbInit CB
-pgInit $CB_DB_NAME
-brokerStart CB 100 IPv4 -troe -experimental -kafka -kafkaBrokerList localhost:9092 -kafkaTopic orionld-test -kafkaGroupId orionld-functest -kafkaBatchSize 10 -kafkaBatchLingerMs 500
-
---SHELL--
-
-#
-# Helper: poll GET until entity exists (HTTP 200) or timeout after 30s
-#
-waitForEntity()
-{
-  local entityId=$1
-  local maxWait=${2:-60}
-  local elapsed=0
-
-  while [ $elapsed -lt $maxWait ]
-  do
-    httpCode=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:$CB_PORT/ngsi-ld/v1/entities/$entityId)
-    if [ "$httpCode" = "200" ]; then
-      return 0
-    fi
-    sleep 1
-    elapsed=$((elapsed + 1))
-  done
-  echo "WARNING: entity $entityId not found after ${maxWait}s"
-  return 1
-}
-
-#
-# 01. Produce a single entity message to Kafka topic
-# 02. Wait for the consumer to process the entity
-# 03. GET the entity from the REST API - verify it exists in MongoDB
-# 04. See the entity in the temporal database (TRoE)
-# 05. See the attributes in the temporal database
-# 06. Produce a batch of 3 entities to Kafka topic
-# 07. Wait for the last entity of the batch to appear
-# 08. GET all entities of type Sensor - should see K1..K4
-# 09. See all entities in the temporal database
-#
-
-echo "01. Produce a single entity message to Kafka topic"
-echo "==================================================="
-echo '{"id":"urn:ngsi-ld:Sensor:K1","type":"Sensor","temperature":{"type":"Property","value":23.5,"observedAt":"2024-06-15T10:00:00Z","unitCode":"CEL"}}' | docker exec -i kafka kafka-console-producer --broker-list localhost:9092 --topic orionld-test
-echo "Message produced"
-echo
-echo
-
-
-echo "02. Wait for the consumer to process the entity"
-echo "================================================="
-waitForEntity urn:ngsi-ld:Sensor:K1
-echo "Done waiting"
-echo
-echo
-
-
-echo "03. GET the entity from the REST API - verify it exists in MongoDB"
-echo "=================================================================="
-orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:Sensor:K1
-echo
-echo
-
-
-echo "04. See the entity in the temporal database (TRoE)"
-echo "==================================================="
-postgresCmd -sql "SELECT opMode,id,type FROM entities WHERE id='urn:ngsi-ld:Sensor:K1'"
-echo
-echo
-
-
-echo "05. See the attributes in the temporal database"
-echo "================================================"
-postgresCmd -sql "SELECT opMode,id,valueType,entityId,number,unitcode,observedAt FROM attributes WHERE entityId='urn:ngsi-ld:Sensor:K1'"
-echo
-echo
-
-
-echo "06. Produce a batch of 3 entities to Kafka topic"
-echo "================================================="
-echo '[{"id":"urn:ngsi-ld:Sensor:K2","type":"Sensor","temperature":{"type":"Property","value":24.1}},{"id":"urn:ngsi-ld:Sensor:K3","type":"Sensor","temperature":{"type":"Property","value":25.7}},{"id":"urn:ngsi-ld:Sensor:K4","type":"Sensor","temperature":{"type":"Property","value":22.3}}]' | docker exec -i kafka kafka-console-producer --broker-list localhost:9092 --topic orionld-test
-echo "Batch produced"
-echo
-echo
-
-
-echo "07. Wait for processing"
-echo "========================"
-waitForEntity urn:ngsi-ld:Sensor:K4
-echo "Done waiting"
-echo
-echo
-
-
-echo "08. GET all entities of type Sensor - should see K1..K4 (count ids)"
-echo "==================================================================="
-orionCurl --url '/ngsi-ld/v1/entities?type=Sensor' | grep '"id"' | wc -l
-echo
-echo
-
-
-echo "09. See all entities in the temporal database"
-echo "==============================================="
-postgresCmd -sql "SELECT opMode,id,type FROM entities ORDER BY id"
-echo
-echo
-
-
---REGEXPECT--
-01. Produce a single entity message to Kafka topic
-===================================================
-Message produced
-
-
-02. Wait for the consumer to process the entity
-=================================================
-Done waiting
-
-
-03. GET the entity from the REST API - verify it exists in MongoDB
-==================================================================
-HTTP/1.1 200 OK
-Content-Length: REGEX(.*)
-Content-Type: application/json
-Date: REGEX(.*)
