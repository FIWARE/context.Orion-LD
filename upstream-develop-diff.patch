-    "id": "urn:ngsi-ld:Sensor:K1",
-    "temperature": {
-        "observedAt": "2024-06-15T10:00:00.000Z",
-        "type": "Property",
-        "unitCode": "CEL",
-        "value": 23.5
-    },
-    "type": "Sensor"
-}
-
