---NAME--
-Native temporal entity query - GET /temporal/entities/{entityId} with timerel=before
-
---SHELL-INIT--
-export BROKER=orionld
-dbInit CB
-pgInit $CB_DB_NAME
-brokerStart CB 100 IPv4 -troe -experimental
-
---SHELL--
-
-#
-# 01. Create an entity E1 with attrs P1=10, R1, B1=true
-# 02. Update P1 to 20 and add P2="hello"
-# 03. Update P1 to 30 and B1 to false
-# 04. See the attributes in the temporal database (should show 3 versions of P1)
-# 05. GET /temporal/entities/E1?timerel=before&timeAt=<ts_after_step1> - should get P1=10
-# 06. GET /temporal/entities/E1?timerel=before&timeAt=<ts_after_step3> - should get P1=30, P2=hello, B1=false
-# 07. GET /temporal/entities/E1?timerel=before&timeAt=<ts_after_step3>&options=simplified - simplified format
-#
-
-echo "01. Create an entity E1 with attrs P1=10, R1, B1=true"
-echo "====================================================="
-payload='{
-  "id": "urn:ngsi-ld:entities:E1",
-  "type": "T",
-  "P1": {
-    "type": "Property",
-    "value": 10,
-    "unitCode": "CEL",
-    "observedAt": "2024-01-01T10:00:00Z"
-  },
-  "R1": {
-    "type": "Relationship",
-    "object": "urn:ngsi-ld:entities:E2",
-    "observedAt": "2024-01-01T10:00:00Z"
-  },
-  "B1": {
-    "type": "Property",
-    "value": true,
-    "observedAt": "2024-01-01T10:00:00Z"
-  }
-}'
-orionCurl --url /ngsi-ld/v1/entities --payload "$payload"
-echo
-echo
-
-
-# Small sleep to ensure distinct timestamps in TRoE
-sleep 1.1
-
-
-echo "02. Update P1 to 20 and add P2=hello"
-echo "====================================="
-payload='{
-  "P1": {
-    "type": "Property",
-    "value": 20,
-    "unitCode": "CEL",
-    "observedAt": "2024-01-01T11:00:00Z"
-  },
-  "P2": {
-    "type": "Property",
-    "value": "hello",
-    "observedAt": "2024-01-01T11:00:00Z"
-  }
-}'
-orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" --verb PATCH
-echo
-echo
-
-
-sleep 1.1
-
-
-echo "03. Update P1 to 30 and B1 to false"
-echo "===================================="
-payload='{
-  "P1": {
-    "type": "Property",
-    "value": 30,
-    "unitCode": "CEL",
-    "observedAt": "2024-01-01T12:00:00Z"
-  },
-  "B1": {
-    "type": "Property",
-    "value": false,
-    "observedAt": "2024-01-01T12:00:00Z"
-  }
-}'
-orionCurl --url /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1/attrs --payload "$payload" --verb PATCH
-echo
-echo
-
-
-echo "04. See the attributes in the temporal database (should show 3 versions of P1)"
-echo "==============================================================================="
-postgresCmd -sql "SELECT opMode,id,valueType,entityId,text,number,boolean,observedAt FROM attributes ORDER BY id,ts"
-echo
-echo
-
-
-echo "05. GET /temporal/entities/E1?timerel=before&timeAt=<now> - should get all latest attrs"
-echo "======================================================================================="
-orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z'
-echo
-echo
-
-
-echo "06. GET /temporal/entities/E1?timerel=after&timeAt=2024-01-01 - all temporal data"
-echo "================================================================================="
-orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=after&timeAt=2020-01-01T00:00:00Z'
-echo
-echo
-
-
-echo "07. GET /temporal/entities/E1?timerel=before&timeAt=<now>&options=simplified - simplified format"
-echo "================================================================================================"
-orionCurl --url '/ngsi-ld/v1/temporal/entities/urn:ngsi-ld:entities:E1?timerel=before&timeAt=2099-12-31T23:59:59Z&options=simplified'
-echo
-echo
-
-
---REGEXPECT--
-01. Create an entity E1 with attrs P1=10, R1, B1=true
-=====================================================
-HTTP/1.1 201 Created
-Content-Length: 0
-Date: REGEX(.*)
-Location: /ngsi-ld/v1/entities/urn:ngsi-ld:entities:E1
-
-
-
-02. Update P1 to 20 and add P2=hello
-=====================================
-HTTP/1.1 204 No Content
-Date: REGEX(.*)
-
-
-
-03. Update P1 to 30 and B1 to false
-====================================
-HTTP/1.1 204 No Content
-Date: REGEX(.*)
-
-
-
-04. See the attributes in the temporal database (should show 3 versions of P1)
-===============================================================================
-opmode,id,valuetype,entityid,text,number,boolean,observedat
-Create,https://uri.etsi.org/ngsi-ld/default-context/B1,Boolean,urn:ngsi-ld:entities:E1,,,t,2024-01-01 10:00:00
-Replace,https://uri.etsi.org/ngsi-ld/default-context/B1,Boolean,urn:ngsi-ld:entities:E1,,,f,2024-01-01 12:00:00
-Create,https://uri.etsi.org/ngsi-ld/default-context/P1,Number,urn:ngsi-ld:entities:E1,,10,,2024-01-01 10:00:00
-Replace,https://uri.etsi.org/ngsi-ld/default-context/P1,Number,urn:ngsi-ld:entities:E1,,20,,2024-01-01 11:00:00
-Replace,https://uri.etsi.org/ngsi-ld/default-context/P1,Number,urn:ngsi-ld:entities:E1,,30,,2024-01-01 12:00:00
-Append,https://uri.etsi.org/ngsi-ld/default-context/P2,String,urn:ngsi-ld:entities:E1,hello,,,2024-01-01 11:00:00
-Create,https://uri.etsi.org/ngsi-ld/default-context/R1,Relationship,urn:ngsi-ld:entities:E1,urn:ngsi-ld:entities:E2,,,2024-01-01 10:00:00
-
-
-05. GET /temporal/entities/E1?timerel=before&timeAt=<now> - should get all latest attrs
-=======================================================================================
-HTTP/1.1 200 OK
-Content-Length: REGEX(.*)
-Content-Type: application/json
-Date: REGEX(.*)
-Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
-
-{
-    "B1": {
-        "observedAt": "REGEX(.*)",
-        "type": "Property",
-        "value": false
-    },
-    "P1": {
-        "observedAt": "REGEX(.*)",
-        "type": "Property",
-        "unitCode": "CEL",
-        "value": REGEX(\d.*)
-    },
-    "P2": {
-        "observedAt": "REGEX(.*)",
-        "type": "Property",
-        "value": "hello"
-    },
-    "R1": {
-        "object": "urn:ngsi-ld:entities:E2",
-        "observedAt": "REGEX(.*)",
-        "type": "Relationship"
-    },
-    "id": "urn:ngsi-ld:entities:E1",
-    "type": "T"
-}
-
-
-06. GET /temporal/entities/E1?timerel=after&timeAt=2024-01-01 - all temporal data
-=================================================================================
-HTTP/1.1 200 OK
-Content-Length: REGEX(.*)
-Content-Type: application/json
-Date: REGEX(.*)
-Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
-
-{
-    "B1": {
-        "observedAt": "REGEX(.*)",
-        "type": "Property",
-        "value": REGEX(.*)
-    },
-    "P1": {
-        "observedAt": "REGEX(.*)",
-        "type": "Property",
-        "unitCode": "CEL",
-        "value": REGEX(\d.*)
-    },
-    "P2": {
-        "observedAt": "REGEX(.*)",
-        "type": "Property",
-        "value": "hello"
-    },
-    "R1": {
-        "object": "urn:ngsi-ld:entities:E2",
-        "observedAt": "REGEX(.*)",
-        "type": "Relationship"
-    },
-    "id": "urn:ngsi-ld:entities:E1",
-    "type": "T"
-}
-
-
-07. GET /temporal/entities/E1?timerel=before&timeAt=<now>&options=simplified - simplified format
-================================================================================================
-HTTP/1.1 200 OK
-Content-Length: REGEX(.*)
-Content-Type: application/json
-Date: REGEX(.*)
-Link: <https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-contextREGEX(.*)
-
-{
-    "B1": false,
-    "P1": REGEX(\d.*),
-    "P2": "hello",
-    "R1": "urn:ngsi-ld:entities:E2",
